#!/bin/bash

TARGET_FILE="/usr/bin/crosh.sh"
SECONDARY_FILE="/usr/bin/crosh"
SUDOERS_FILE="/etc/sudoers.d/chronos"
SAFE_DIR="/usr/local/bin"
SAFE_KEEPING="$SAFE_DIR/s-crosh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
RESET='\033[0m'

echo -e "${CYAN}[→]${RESET} Remounting rootfs RW..."
sudo mount -o remount,rw / || { echo -e "${RED}Failed. Is rootfs verification off?${RESET}"; exit 1; }

if [ ! -f "$TARGET_FILE" ]; then
    echo -e "${YELLOW}[!] $TARGET_FILE not found, checking for $SECONDARY_FILE...${RESET}"
    TARGET_FILE=$SECONDARY_FILE
fi

if [ -f "$TARGET_FILE" ]; then
    echo -e "${GREEN}[✓] Target identified: $TARGET_FILE${RESET}"
    
    echo -e "${CYAN}[→]${RESET} Applying CROSH_DEBUG=1..."
    if grep -q "CROSH_DEBUG" "$TARGET_FILE"; then
        sudo sed -i 's/^.*CROSH_DEBUG=.*/CROSH_DEBUG=1/' "$TARGET_FILE"
        echo -e "${GREEN}[✓] Variable updated.${RESET}"
    else
        # If not found, add it after the shebang
        sudo sed -i '2iCROSH_DEBUG=1' "$TARGET_FILE"
        echo -e "${GREEN}[✓] Variable added to header.${RESET}"
    fi
else
    echo -e "${RED}[✗] No crosh files found in /usr/bin/.${RESET}"
    exit 1
fi

echo -e "${CYAN}[→]${RESET} Updating sudoers for chronos..."
echo "chronos ALL=(ALL) NOPASSWD: ALL" | sudo tee "$SUDOERS_FILE" > /dev/null
sudo chmod 0440 "$SUDOERS_FILE"

echo -e "${CYAN}[→]${RESET} Saving backup to $SAFE_KEEPING..."
sudo mkdir -p "$SAFE_DIR"
if [ -f "$0" ]; then
    sudo cp "$0" "$SAFE_KEEPING"
    sudo chmod +x "$SAFE_KEEPING"
    echo -e "${GREEN}[✓] Backup saved.${RESET}"
else
    echo -e "${YELLOW}[!] Running from pipe/stdin. Cannot self-copy.${RESET}"
    echo -e "${YELLOW}    To back up, save this code to a file and run it directly.${RESET}"
fi

echo -e "${MAGENTA}${BOLD}"
echo "  ███████╗ ██████╗██████╗  ██████╗ ███████╗██╗  ██╗"
echo "  ██╔════╝██╔════╝██╔══██╗██╔═══██╗██╔════╝██║  ██║"
echo "  ███████╗██║     ██████╔╝██║   ██║███████╗███████║"
echo "  ╚════██║██║     ██╔══██╗██║   ██║╚════██║██╔══██║"
echo "  ███████║╚██████╗██║  ██║╚██████╔╝███████║██║  ██║"
echo "  ╚══════╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝"
echo -e "${CYAN}             Sudo & Debug Enabler Complete!${RESET}"
echo -e "${YELLOW}        ───────────────────────────────────────────${RESET}"
echo -e "${BOLD}1. Debug: ${GREEN}ACTIVE (CROSH_DEBUG=1)${RESET}"
echo -e "${BOLD}2. Sudo:  ${GREEN}ACTIVE (NOPASSWD)${RESET}"
echo -e "${BOLD}3. Path:  ${CYAN}$TARGET_FILE${RESET}"
echo ""
echo -e "Open a new Crosh tab and type ${BOLD}shell${RESET} to test."
