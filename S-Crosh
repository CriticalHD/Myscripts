#!/bin/bash

set -e

CROSH_PATH="/usr/bin/crosh"
SUDOERS_FILE="/etc/sudoers.d/chronos"
STARTUP_CONF="/etc/init/sudocrosh.conf"
SAFE_KEEPING="/usr/local/bin/s-crosh"

echo "Checking Rootfs status..."
if [[ ! $(mount | grep "on / type" | grep "rw") ]]; then
    echo "Remounting Rootfs as RW..."
    sudo mount -o remount,rw / || { echo "ERROR: Could not remount. Is rootfs verification off?"; exit 1; }
fi

# 1. Enable CROSH_DEBUG
echo "Patching Crosh for Debug..."
if grep -q "CROSH_DEBUG=false" "$CROSH_PATH"; then
    sudo sed -i 's/CROSH_DEBUG=false/CROSH_DEBUG=true/' "$CROSH_PATH"
    echo "[✓] Debug enabled."
else
    echo "[!] Debug already enabled or pattern not found."
fi

# 2. Setup Sudo Permissions
echo "Granting Sudo to chronos..."
echo "chronos ALL=(ALL) NOPASSWD: ALL" | sudo tee "$SUDOERS_FILE" > /dev/null
sudo chmod 0440 "$SUDOERS_FILE"
echo "[✓] Sudoers updated."

echo "Creating boot persistence job..."
sudo tee "$STARTUP_CONF" > /dev/null <<EOF
description "Restore S-Crosh patches on boot"
start on started system-services
script
  mount -o remount,rw /
  echo "chronos ALL=(ALL) NOPASSWD: ALL" > $SUDOERS_FILE
  chmod 0440 $SUDOERS_FILE
  sed -i 's/CROSH_DEBUG=false/CROSH_DEBUG=true/' $CROSH_PATH
  mount -o remount,ro /
end script
EOF
echo "[✓] Boot job created."

echo "Saving script copy to /usr/local/bin/..."
sudo cp "$0" "$SAFE_KEEPING" 2>/dev/null || true
sudo chmod +x "$SAFE_KEEPING" 2>/dev/null || true
echo "[✓] Script backed up to stateful partition."

echo "-------------------------------------------"
echo "DONE. If you update ChromeOS, just run:"
echo "sudo sh /usr/local/bin/s-crosh"
echo "to restore everything instantly."
echo "-------------------------------------------"
