#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
RESET='\033[0m'

CROSH_PATH="/usr/bin/crosh"
SUDOERS_FILE="/etc/sudoers.d/chronos"
STARTUP_CONF="/etc/init/sudocrosh.conf"
SAFE_DIR="/usr/local/bin"
SAFE_KEEPING="$SAFE_DIR/s-crosh"

clear
echo -e "${MAGENTA}${BOLD}"
echo "  ███████╗ ██████╗██████╗  ██████╗ ███████╗██╗  ██╗"
echo "  ██╔════╝██╔════╝██╔══██╗██╔═══██╗██╔════╝██║  ██║"
echo "  ███████╗██║     ██████╔╝██║   ██║███████╗███████║"
echo "  ╚════██║██║     ██╔══██╗██║   ██║╚════██║██╔══██║"
echo "  ███████║╚██████╗██║  ██║╚██████╔╝███████║██║  ██║"
echo "  ╚══════╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝  ╚═╝"
echo -e "${CYAN}             Sudo & Debug Enabler v2.0${RESET}"
echo -e "${YELLOW}        ───────────────────────────────────────────${RESET}"

echo -ne "${CYAN}[→]${RESET} Checking rootfs status... "
if [[ ! $(mount | grep "on / type" | grep "rw") ]]; then
    sudo mount -o remount,rw / &>/dev/null || { echo -e "${RED}FAILED${RESET}"; echo "Ensure rootfs verification is OFF."; exit 1; }
    echo -e "${GREEN}Remounted RW${RESET}"
else
    echo -e "${GREEN}Already RW${RESET}"
fi

echo -ne "${CYAN}[→]${RESET} Patching $CROSH_PATH... "
# This regex is more flexible to find the line even with different spacing
if grep -q "CROSH_DEBUG=" "$CROSH_PATH"; then
    sudo sed -i 's/CROSH_DEBUG=.*/CROSH_DEBUG=true/' "$CROSH_PATH"
    echo -e "${GREEN}DONE${RESET}"
else
    echo -e "${RED}NOT FOUND${RESET}"
    echo "    Check if /usr/bin/crosh exists on your build."
fi

echo -ne "${CYAN}[→]${RESET} Applying sudo permissions... "
echo "chronos ALL=(ALL) NOPASSWD: ALL" | sudo tee "$SUDOERS_FILE" > /dev/null
sudo chmod 0440 "$SUDOERS_FILE"
echo -e "${GREEN}DONE${RESET}"

echo -ne "${CYAN}[→]${RESET} Installing boot persistence... "
sudo tee "$STARTUP_CONF" > /dev/null <<EOF
description "S-Crosh Persistence"
start on started system-services
script
  mount -o remount,rw /
  echo "chronos ALL=(ALL) NOPASSWD: ALL" > $SUDOERS_FILE
  chmod 0440 $SUDOERS_FILE
  sed -i 's/CROSH_DEBUG=.*/CROSH_DEBUG=true/' $CROSH_PATH
  mount -o remount,ro /
end script
EOF
echo -e "${GREEN}DONE${RESET}"

echo -ne "${CYAN}[→]${RESET} Saving backup to $SAFE_KEEPING... "
sudo mkdir -p "$SAFE_DIR"
cat "$0" | sudo tee "$SAFE_KEEPING" > /dev/null
sudo chmod +x "$SAFE_KEEPING"
echo -e "${GREEN}DONE${RESET}"

echo -e "\n${BOLD}${GREEN}All steps complete!${RESET}"
echo -e "To verify debug mode, open a new Crosh tab and type: ${CYAN}shell${RESET}"
echo -e "If it asks for a password, your sudoers didn't stick."
