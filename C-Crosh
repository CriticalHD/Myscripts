           local ip=$(hostname -I 2>/dev/null | awk '{print $1}')
           echo -e "  ${D}Connect: ssh chronos@${ip:-<ip>}${N}"; pause_key ;;
        2) passwd chronos; pause_key ;;
        3) doas "passwd root"; pause_key ;;
