page_repair_sudo() {
    banner
    echo -e "  ${WHT}── Repair sudo (minioverride) ────────────────────────${RST}\n"
    echo -e "  Reinstalls the minioverride fix so sudo works from crosh."
    echo -e "  Requires a reboot to take effect.\n"
    echo -ne "  ${CYN}Continue? [y/N]:${RST} "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        remount_rw
        mkdir -p /usr/local/bin
        rm -f "$OVERRIDE_SO"
        NEEDS_REBOOT=0
        install_minioverride
        if [[ $NEEDS_REBOOT -eq 1 ]]; then
            echo -ne "\n  Reboot now? [y/N]: "
            read -r rb; [[ "$rb" =~ ^[Yy]$ ]] && reboot
        fi
    else
        echo -e "  ${DIM}Cancelled.${RST}"
    fi
    pause_key
}

