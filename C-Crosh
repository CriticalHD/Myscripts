# ════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ════════════════════════════════════════════════════════════════
case "${1:-}" in
    --delete)  [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete; do_delete ;;
    --restore) [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore; do_restore_crosh ;;
esac

if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" || \
      "$(realpath "$0" 2>/dev/null)" == "$ROOTFS_SHELL" ]]; then
    if [[ "$(id -u)" -ne 0 ]]; then
        if sudo -n true 2>/dev/null; then
            exec sudo "$SHELL_PATH"
        else
            clear
            echo -e "${Y}"
            echo "  ╔══════════════════════════════════════════════╗"
            echo "  ║  WARNING: sudo blocked (NO_NEW_PRIVS)        ║"
            echo "  ║  Running as chronos — some features limited  ║"
            echo "  ║  Use 'Repair sudo' from menu then reboot     ║"
            echo "  ╚══════════════════════════════════════════════╝"
            echo -e "${N}"; sleep 2
        fi
    fi
    shell_main_menu; exit 0
fi

[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete — are you sure?" "Yes — delete" "No — back"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — are you sure?" "Yes — restore" "No — back"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) echo -e "${D}Goodbye.${N}"; exit 0 ;;
    esac
done
