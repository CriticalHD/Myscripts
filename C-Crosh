#!/bin/bash
_SELF_PAYLOAD=""
# cshell v3.0 — Custom ChromeOS Shell

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
ROOTKEY="/usr/local/cshell_rootkey"
ROOTKEY_PUB="/usr/local/cshell_rootkey.pub"
SSHD_CONF="/usr/local/cshell_sshd.conf"
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
UI_CONF="/etc/init/ui.conf"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
VERSION="3.0"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
C='\033[0;36m'; W='\033[1;37m'; D='\033[2m'
N='\033[0m';    V='\033[7m'

trap '' INT   # never let Ctrl+C kill the shell in crosh context

remount_rw() {
    mount -o remount,rw /    2>/dev/null || true
    mount -o remount,rw /usr 2>/dev/null || true
    mount -o remount,rw /etc 2>/dev/null || true
}

tread()  { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null || echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}

pause_key() { echo -e "\n  ${D}Press any key...${N}"; tread1 _k; }

confirm_yn() {
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a
    [[ "$_a" =~ ^[Yy]$ ]]
}

draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}
    if [[ -t 0 && -t 1 ]]; then
        local sel=0
        while true; do
            banner
            echo -e "  ${W}${title}${N}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $sel ]]; then
                    echo -e "  ${V}${C}  ›  ${items[$i]}  ${N}"
                else
                    echo -e "  ${D}     ${items[$i]}${N}"
                fi
            done
            echo -e "\n  ${D}↑↓ navigate   Enter select   Q quit${N}"
            local k; IFS= read -rsn1 k </dev/tty 2>/dev/null
            if [[ "$k" == $'\x1b' ]]; then
                local s; read -rsn2 -t 0.1 s </dev/tty 2>/dev/null
                case "$s" in
                    '[A') (( sel > 0 )) && (( sel-- )) ;;
                    '[B') (( sel < count-1 )) && (( sel++ )) ;;
                esac
            elif [[ "$k" == "" ]]; then MENU_RESULT=$sel; return
            elif [[ "$k" == "q" || "$k" == "Q" ]]; then MENU_RESULT=-1; return
            fi
        done
    else
        banner
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do echo -e "  ${C}$((i+1)))${N}  ${items[$i]}"; done
        echo ""
        echo -ne "  ${W}Select [1-${count}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch >= 1 && ch <= count )); then
            MENU_RESULT=$((ch-1))
        else
            MENU_RESULT=-1
        fi
    fi
}

# ════════════════════════════════════════════════════════════════
#  DOAS — mush-style root via SSH on port 1337
#  Completely bypasses NO_NEW_PRIVS (fresh SSH process)
#  This is exactly how murkmod/mush gets root from crosh
# ════════════════════════════════════════════════════════════════
doas() {
    ssh -t -p 1337 \
        -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR \
        -oConnectTimeout=3 \
        root@127.0.0.1 "$@"
}

doas_check() {
    # Returns 0 if doas works, 1 if not
    ssh -p 1337 \
        -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR \
        -oConnectTimeout=2 \
        -oBatchMode=yes \
        root@127.0.0.1 "true" 2>/dev/null
}

setup_root_sshd() {
    # Generate key if missing
    if [[ ! -f "$ROOTKEY" ]]; then
        ssh-keygen -t ed25519 -f "$ROOTKEY" -N "" -q 2>/dev/null
        chmod 600 "$ROOTKEY"
    fi

    # Write sshd config for port 1337
    cat > "$SSHD_CONF" << EOF
Port 1337
ListenAddress 127.0.0.1
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile $ROOTKEY_PUB
PermitRootLogin yes
PasswordAuthentication no
PubkeyAuthentication yes
AllowUsers root
LogLevel ERROR
UsePAM no
EOF

    # Authorize our key for root
    local pubkey
    pubkey=$(cat "$ROOTKEY_PUB" 2>/dev/null)
    if [[ -z "$pubkey" ]]; then
        ssh-keygen -t ed25519 -f "$ROOTKEY" -N "" -q 2>/dev/null
        pubkey=$(cat "$ROOTKEY_PUB")
    fi
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    touch /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
    # Add if not already there
    grep -qF "$pubkey" /root/.ssh/authorized_keys 2>/dev/null \
        || echo "$pubkey" >> /root/.ssh/authorized_keys

    # Generate host key if missing
    [[ -f /etc/ssh/ssh_host_ed25519_key ]] \
        || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null

    # Kill any existing sshd on 1337 and start fresh
    pkill -f "sshd.*1337" 2>/dev/null; sleep 0.3
    /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null
    sleep 0.5
}

ensure_doas() {
    # If doas already works, great
    doas_check && return 0

    # Try to start sshd (needs root — works from VT2 install or from root context)
    if [[ "$(id -u)" -eq 0 ]]; then
        setup_root_sshd
        doas_check && return 0
    fi

    # sshd might be running but key missing — try sudo to set up
    if sudo -n true 2>/dev/null; then
        sudo bash -c "$(declare -f setup_root_sshd); ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'; setup_root_sshd" 2>/dev/null
        doas_check && return 0
    fi

    return 1
}

# ════════════════════════════════════════════════════════════════
#  ROOTFS / INSTALL HELPERS
# ════════════════════════════════════════════════════════════════
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then rm -f /usr/bin/.rw_test; return 0; fi
    banner
    echo -e "  ${Y}Rootfs is read-only — need to disable verification first.${N}\n"
    if confirm_yn "Run make_dev_ssd.sh now?"; then
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}Done. Reboot, then re-run install.${N}"
        confirm_yn "Reboot now?" && reboot
        exit 0
    else
        echo -e "${R}Cannot continue.${N}"; exit 1
    fi
}

C_SRC='int minijail_no_new_privs(void){return 0;}
int minijail_add_fs_restriction_rx(void){return 0;}
int minijail_add_fs_restriction_advanced_rw(void){return 0;}
int minijail_set_enable_profile_fs_restrictions(void){return 0;}
int minijail_enable_default_fs_restrictions(void){return 0;}'

build_minioverride() {
    printf '%s' "$C_SRC" > /tmp/_mo.c
    for cc in gcc tcc cc; do
        command -v "$cc" &>/dev/null || continue
        $cc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null \
            && rm -f /tmp/_mo.c && chmod 755 "$OVERRIDE_SO" && return 0
    done
    rm -f /tmp/_mo.c
    curl -sSfL \
        "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
        -o "$OVERRIDE_SO" 2>/dev/null && [[ -s "$OVERRIDE_SO" ]] && return 0
    return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return
    grep -q "minioverride" "$UI_CONF" 2>/dev/null \
        && { echo -e "${D}    ui.conf already patched.${N}"; return; }
    { echo "env LD_PRELOAD=/usr/local/bin/minioverride.so"; cat "$UI_CONF"; } > /tmp/_ui.tmp
    cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    echo -e "${G}    Patched ui.conf (sudo backup fix).${N}"
    NEEDS_REBOOT=1
}

write_self_to() {
    local dest="$1"
    echo "$_SELF_PAYLOAD" | base64 -d > "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    local src="${BASH_SOURCE[0]:-$0}"
    [[ -f "$src" && "$src" != "bash" ]] && cp "$src" "$dest" 2>/dev/null && return 0
    for fd in 255 254 253 0; do
        [[ -r "/proc/$$/fd/$fd" ]] \
            && cp "/proc/$$/fd/$fd" "$dest" 2>/dev/null \
            && [[ -s "$dest" ]] && return 0
    done
    return 1
}

install_persistence() {
    cp "$SHELL_PATH" "$ROOTFS_SHELL" 2>/dev/null && chmod +x "$ROOTFS_SHELL"
    [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
    # Copy keys to rootfs so they survive powerwash
    [[ -f "$ROOTKEY" ]]     && cp "$ROOTKEY"     /usr/bin/cshell_rootkey     2>/dev/null
    [[ -f "$ROOTKEY_PUB" ]] && cp "$ROOTKEY_PUB" /usr/bin/cshell_rootkey.pub 2>/dev/null
    [[ -f "$SSHD_CONF" ]]   && cp "$SSHD_CONF"   /usr/bin/cshell_sshd.conf   2>/dev/null

    cat > "$INIT_SCRIPT" << 'UPSTART'
description "cshell post-boot restore"
start on started system-services
task
script
    # Restore cshell binary
    [ -f /usr/local/bin/cshell ] || {
        mkdir -p /usr/local/bin
        cp /usr/bin/cshell_rootfs /usr/local/bin/cshell
        chmod +x /usr/local/bin/cshell
    }
    # Restore crosh stub
    grep -q "cshell" /usr/bin/crosh 2>/dev/null || {
        printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > /usr/bin/crosh
        chmod +x /usr/bin/crosh
    }
    # Restore SSH keys
    [ -f /usr/local/cshell_rootkey ] || {
        cp /usr/bin/cshell_rootkey /usr/local/cshell_rootkey 2>/dev/null
        cp /usr/bin/cshell_rootkey.pub /usr/local/cshell_rootkey.pub 2>/dev/null
        cp /usr/bin/cshell_sshd.conf /usr/local/cshell_sshd.conf 2>/dev/null
        chmod 600 /usr/local/cshell_rootkey
    }
    # Restore minioverride
    [ -f /usr/local/bin/minioverride.so ] || {
        [ -f /usr/bin/minioverride.so ] && {
            cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so
            chmod 755 /usr/local/bin/minioverride.so
        }
    }
    # Re-authorize SSH key for root
    mkdir -p /root/.ssh; chmod 700 /root/.ssh
    touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
    pubkey=$(cat /usr/local/cshell_rootkey.pub 2>/dev/null)
    [ -n "$pubkey" ] && grep -qF "$pubkey" /root/.ssh/authorized_keys 2>/dev/null \
        || echo "$pubkey" >> /root/.ssh/authorized_keys
    # Start sshd on port 1337
    [ -f /usr/local/cshell_sshd.conf ] && /usr/sbin/sshd -f /usr/local/cshell_sshd.conf 2>/dev/null
end script
UPSTART
    echo -e "${G}    Persistence + auto-sshd installed (survives powerwash).${N}"
}

# ════════════════════════════════════════════════════════════════
#  INSTALL / DELETE / RESTORE
# ════════════════════════════════════════════════════════════════
do_install() {
    banner
    echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}[!] Must be root.${N}" && exit 1
    echo -e "${D}    Checking rootfs...${N}"; check_rootfs
    mkdir -p /usr/local/bin

    echo -e "${D}    Writing cshell...${N}"
    if write_self_to "$SHELL_PATH"; then
        chmod +x "$SHELL_PATH"
        echo -e "${G}    Written to ${SHELL_PATH}${N}"
    else
        echo -e "${R}[!] Could not write cshell. Try: bash <(curl -sSL <url>)${N}"; exit 1
    fi

    # Setup root SSH on port 1337
    echo -e "${D}    Setting up root SSH (port 1337)...${N}"
    setup_root_sshd
    if doas_check; then
        echo -e "${G}    doas (root SSH) working!${N}"
    else
        echo -e "${Y}    doas not working yet — will retry on next boot.${N}"
    fi

    # minioverride as backup sudo fix
    NEEDS_REBOOT=0
    if build_minioverride; then
        patch_ui_conf
        echo -e "${G}    minioverride.so built (sudo backup fix).${N}"
    else
        echo -e "${Y}    minioverride build failed — doas will handle root.${N}"
    fi

    install_persistence

    # Crosh stub — no sudo needed, cshell handles escalation via doas
    [[ ! -f "$CROSH_BACKUP" ]] && cp "$CROSH_PATH" "$CROSH_BACKUP"
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${G}    Crosh stub installed (no sudo needed).${N}\n"

    echo -e "${G}[+] Done! Open crosh (Ctrl+Alt+T) to launch.${N}"
    [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "${Y}[!] Reboot recommended for full sudo fix.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_delete() {
    banner; echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { doas_check && doas "bash $0 --delete" && exit 0; exec sudo "$0" --delete; }
    remount_rw
    pkill -f "sshd.*1337" 2>/dev/null
    # Remove minioverride from ui.conf
    [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" && {
        grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp
        cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    }
    rm -f "$SHELL_PATH" "$ROOTFS_SHELL" "$INIT_SCRIPT" "$ROOTKEY" "$ROOTKEY_PUB" \
          "$SSHD_CONF" "$OVERRIDE_SO" /usr/bin/minioverride.so \
          /usr/bin/cshell_rootkey /usr/bin/cshell_rootkey.pub /usr/bin/cshell_sshd.conf
    echo -e "${G}[+] Deleted.${N}  Use 'Restore crosh' if crosh is broken."
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_restore_crosh() {
    banner; echo -e "${Y}[*] Restoring crosh...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { doas_check && doas "bash $0 --restore" && exit 0; exec sudo "$0" --restore; }
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        rm -f "$CROSH_PATH"; cp "$CROSH_BACKUP" "$CROSH_PATH"; chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"; echo -e "${G}[+] Crosh restored.${N}"
    else
        echo -e "${R}[!] No backup found.${N}"
    fi
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

# ════════════════════════════════════════════════════════════════
#  SHELL PAGES — all privileged ops use doas
# ════════════════════════════════════════════════════════════════

pg_sysinfo() {
    banner
    echo -e "  ${W}── System Info ──────────────────────────────────────${N}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local ver=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local chan=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mt=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mf=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mu=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    echo -e "  ${C}Board:${N}         ${board:-?}"
    echo -e "  ${C}Version:${N}       ${ver:-?}  (${chan:-?})"
    echo -e "  ${C}Build:${N}         ${build:-?}"
    echo -e "  ${C}Kernel:${N}        $(uname -r) [$(uname -m)]"
    echo -e "  ${C}CPU:${N}           ${cpu:-?} x${cores}"
    echo -e "  ${C}RAM:${N}           ${mu} used / ${mf} free / ${mt} total"
    echo -e "  ${C}Uptime:${N}        $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${C}Hostname:${N}      $(hostname)"
    echo -e "  ${C}User:${N}          $(whoami) uid=$(id -u)"
    echo -e "  ${C}doas (root SSH):${N} $(doas_check 2>/dev/null && echo "${G}working${N}" || echo "${Y}not available${N}")"
    echo -e "  ${C}minioverride:${N}  $([[ -f $OVERRIDE_SO ]] && echo "${G}installed${N}" || echo "${D}not installed${N}")"
    echo -e "  ${C}persistence:${N}   $([[ -f $INIT_SCRIPT ]] && echo "${G}yes${N}" || echo "${Y}no${N}")"
    pause_key
}

pg_battery() {
    banner; echo -e "  ${W}── Battery ──────────────────────────────────────────${N}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -n "$bat" ]]; then
        local st=$(cat "$bat/status" 2>/dev/null||echo "?")
        local cap=$(cat "$bat/capacity" 2>/dev/null||echo "?")
        local ef=$(cat "$bat/energy_full" 2>/dev/null)
        local ed=$(cat "$bat/energy_full_design" 2>/dev/null)
        local en=$(cat "$bat/energy_now" 2>/dev/null)
        local v=$(cat "$bat/voltage_now" 2>/dev/null)
        local i=$(cat "$bat/current_now" 2>/dev/null)
        local cyc=$(cat "$bat/cycle_count" 2>/dev/null)
        echo -e "  ${C}Status:${N}  $st  |  ${C}Charge:${N} ${cap}%"
        [[ -n "$cyc" && "$cyc" != "0" ]] && echo -e "  ${C}Cycles:${N}  $cyc"
        if [[ -n "$ef" && -n "$ed" && "$ed" -gt 0 ]]; then
            local h=$(awk "BEGIN{printf \"%.1f\",($ef/$ed)*100}")
            local hc=$G
            awk "BEGIN{exit !($h+0<80)}" 2>/dev/null && hc=$Y
            awk "BEGIN{exit !($h+0<60)}" 2>/dev/null && hc=$R
            echo -e "  ${C}Health:${N}  ${hc}${h}%${N}  ($(awk "BEGIN{printf \"%.2f Wh\",$ef/1000000}") / $(awk "BEGIN{printf \"%.2f Wh\",$ed/1000000}"))"
        fi
        [[ -n "$en" ]] && echo -e "  ${C}Now:${N}     $(awk "BEGIN{printf \"%.2f Wh\",$en/1000000}")"
        [[ -n "$v"  ]] && echo -e "  ${C}Voltage:${N} $(awk "BEGIN{printf \"%.3f V\",$v/1000000}")"
        [[ -n "$i"  ]] && echo -e "  ${C}Draw:${N}    $(awk "BEGIN{printf \"%.0f mA\",$i/1000}")"
    fi
    doas_check 2>/dev/null && {
        echo -e "\n  ${D}ectool:${N}"
        doas "ectool batterystatus 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_sensors() {
    banner; echo -e "  ${W}── Sensors ──────────────────────────────────────────${N}\n"
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f"|grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null||echo "?")
        local raw=$(cat "$f" 2>/dev/null||echo "0")
        local tc=$G; (( raw>70000 ))&&tc=$Y; (( raw>85000 ))&&tc=$R
        printf "  ${C}%-10s${N} %-22s ${tc}%.1f°C${N}\n" "$zone" "($type)" \
            "$(awk "BEGIN{print $raw/1000}")"
    done
    doas_check 2>/dev/null && {
        echo -e "\n  ${D}Fan:${N}"; doas "ectool pwmgetfanrpm 2>/dev/null" \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}EC temps:${N}"; doas "ectool temps all 2>/dev/null" \
            | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_devmode() {
    banner; echo -e "  ${W}── Dev Mode / Boot Flags ────────────────────────────${N}\n"
    command -v crossystem &>/dev/null || { echo "  crossystem not available."; pause_key; return; }
    for key in devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur; do
        local val=$(crossystem $key 2>/dev/null||echo "n/a")
        local vc=$D; [[ "$val"=="1" ]]&&vc=$G
        printf "  ${C}%-30s${N} ${vc}%s${N}\n" "$key" "$val"
    done
    echo -e "\n  ${W}Firmware:${N}"
    for key in fwid ro_fwid mainfw_act mainfw_type; do
        printf "  ${C}%-30s${N} %s\n" "$key" "$(crossystem $key 2>/dev/null||echo n/a)"
    done
    echo -e "\n  ${D}[B] Full dump  [any] Back${N}"
    local k; tread1 k
    [[ "$k" == "b" || "$k" == "B" ]] && {
        banner; crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key
    }
}

pg_gbb() {
    banner; echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"
    if doas_check 2>/dev/null; then
        echo -e "  ${D}Current flags:${N}"
        doas "futility gbb --get --flags 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}[S] Set flags  [any] Back${N}"
        local k; tread1 k
        if [[ "$k" == "s" || "$k" == "S" ]]; then
            echo -ne "  ${Y}New flags (hex, e.g. 0x8090):${N} "; local fl; tread fl
            doas "futility gbb --set --flags=$fl" 2>&1 | while IFS= read -r l; do echo "  $l"; done
            pause_key; return
        fi
    fi
    echo -e "  ${W}Reference:${N}"
    echo -e "  ${C}0x0008${N}  FORCE_DEV_SWITCH_ON    ${C}0x0020${N}  DISABLE_FW_ROLLBACK_CHECK"
    echo -e "  ${C}0x8000${N}  CCD_UNLOCK             ${C}0x8090${N}  Murkmod value"
    pause_key
}

pg_vpd() {
    banner; echo -e "  ${W}── VPD ──────────────────────────────────────────────${N}\n"
    doas_check 2>/dev/null && {
        echo -e "  ${W}RO VPD:${N}"; doas "vpd -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${W}RW VPD:${N}"; doas "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    } || { vpd -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

pg_net() {
    banner; echo -e "  ${W}── Network ──────────────────────────────────────────${N}\n"
    ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Routes:${N}"; ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}DNS:${N}"; grep "^nameserver" /etc/resolv.conf 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[P] Ping  [T] Traceroute  [N] Netstat  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        p|P) banner; ping -c 4 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) banner; traceroute -m 15 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        n|N) banner; ss -tunp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_wifi() {
    banner; echo -e "  ${W}── WiFi ─────────────────────────────────────────────${N}\n"
    command -v iw &>/dev/null || { echo "  iw not available."; pause_key; return; }
    local iface=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)
    echo -e "  ${W}Interface: ${iface:-?}${N}\n"
    [[ -n "$iface" ]] && {
        iw dev "$iface" link 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}Signal:${N}"
        iw dev "$iface" station dump 2>/dev/null \
            | grep -E "signal|tx bitrate|rx bitrate" \
            | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_storage() {
    banner; echo -e "  ${W}── Storage ──────────────────────────────────────────${N}\n"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs\|^udev\|^overlay\|^shm\|^none" \
        | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Block devices:${N}"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_procs() {
    banner; echo -e "  ${W}── Processes ────────────────────────────────────────${N}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[M] Mem sort  [K] Kill  [G] Grep  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        m|M) banner; ps aux --sort=-%mem 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        k|K) echo -ne "\n  ${Y}PID:${N} "; local pid; tread pid
             [[ "$pid" =~ ^[0-9]+$ ]] && doas "kill -9 $pid" 2>/dev/null \
                 && echo -e "  ${G}Killed $pid${N}" || echo -e "  ${R}Failed${N}"; pause_key ;;
        g|G) echo -ne "\n  ${Y}Name grep:${N} "; local nm; tread nm
             ps aux 2>/dev/null | grep -i "$nm" | grep -v grep | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_extensions() {
    banner; echo -e "  ${W}── Chrome Extensions ────────────────────────────────${N}\n"
    local dir="/home/chronos/user/Extensions"
    [[ ! -d "$dir" ]] && dir=$(find /home/chronos -name "Extensions" -type d 2>/dev/null | head -1)
    [[ -z "$dir" ]] && { echo "  Not found."; pause_key; return; }
    local n=0
    printf "  ${W}%-26s %-36s %s${N}\n" "ID" "Name" "Ver"
    echo "  $(printf '%0.s─' {1..64})"
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | sort -V | tail -1)
        local name="?" ver="?"
        [[ -n "$mf" ]] && {
            name=$(python3 -c "import json;d=json.load(open('$mf'));print(d.get('name','?')[:34])" 2>/dev/null \
                || grep '"name"' "$mf" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/' | cut -c1-34)
            ver=$(python3 -c "import json;d=json.load(open('$mf'));print(d.get('version','?'))" 2>/dev/null \
                || grep '"version"' "$mf" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')
        }
        printf "  ${D}%-26s${N} %-36s ${D}%s${N}\n" "${id:0:26}" "${name:0:34}" "$ver"
        ((n++))
    done
    echo -e "\n  ${D}${n} extension(s)${N}"; pause_key
}

pg_file_browser() {
    local cur="${1:-/}"
    while true; do
        banner; echo -e "  ${W}── Files: ${cur} ──${N}\n"
        local entries=()
        [[ "$cur" != "/" ]] && entries+=("↑  ..")
        while IFS= read -r name; do
            local fp="${cur%/}/${name}"
            if [[ -d "$fp" ]]; then entries+=("📁 ${name}/")
            else
                local sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                entries+=("📄 ${name}  [${sz}]")
            fi
        done < <(ls -1p "$cur" 2>/dev/null | head -28)
        entries+=("← Exit")
        draw_menu "Files: $cur" "${entries[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return
        local chosen="${entries[$MENU_RESULT]}"
        if [[ "$chosen" == "↑  .." ]]; then
            cur=$(dirname "$cur")
        elif [[ "$chosen" == "← Exit" ]]; then
            return
        elif [[ "$chosen" == "📁 "* ]]; then
            local dn="${chosen#📁 }"; dn="${dn%/}"
            cur="${cur%/}/${dn}"
        else
            local fn="${chosen#📄 }"; fn="${fn%%  *}"
            local fp="${cur%/}/${fn}"
            draw_menu "$fn" "View (tail 50)" "Edit (nano/vi)" "Delete" "Copy path" "← Back"
            case $MENU_RESULT in
                0) banner; tail -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                1) doas_check 2>/dev/null && doas "which nano &>/dev/null && nano '$fp' || vi '$fp'" \
                       || { command -v nano &>/dev/null && nano "$fp" || vi "$fp"; } ;;
                2) confirm_yn "Delete $fp?" && doas "rm -f '$fp'" 2>/dev/null \
                       && echo -e "  ${G}Deleted.${N}" || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
                3) echo -e "  Path: ${W}$fp${N}"; pause_key ;;
            esac
        fi
    done
}

pg_logs() {
