# ════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ════════════════════════════════════════════════════════════════

# Handle CLI flags
case "${1:-}" in
    --delete)  [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete; do_delete ;;
    --restore) [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore; do_restore_crosh ;;
esac

# If we ARE the installed shell (launched from crosh stub)
if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" || \
      "$(realpath "$0" 2>/dev/null)" == "$ROOTFS_SHELL" ]]; then

    # Try to get root — but don't die if sudo is broken
    if [[ "$(id -u)" -ne 0 ]]; then
        if check_sudo_works; then
            exec sudo "$SHELL_PATH"
        else
            # sudo broken — warn but proceed as chronos
            clear
            echo -e "${Y}"
            echo "  ╔════════════════════════════════════════════╗"
            echo "  ║  WARNING: sudo did not work properly       ║"
            echo "  ║  Continuing as chronos (limited access)    ║"
            echo "  ║  Run 'Repair sudo' and reboot to fix       ║"
            echo "  ╚════════════════════════════════════════════╝"
            echo -e "${N}"
            sleep 2
        fi
    fi

    shell_main_menu
    exit 0
fi

# Escalate to root for setup operations
[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

# ── Setup menu ───────────────────────────────────────────────────
while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete cshell — are you sure?" \
               "Yes — delete cshell" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — are you sure?" \
               "Yes — restore original crosh" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) echo -e "${D}Goodbye.${N}"; exit 0 ;;
    esac
done
