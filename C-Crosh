page_extensions() {
    banner
    echo -e "  ${WHT}── Chrome Extensions ────────────────────────────────${RST}\n"
    local dir="/home/chronos/user/Extensions"
    if [[ ! -d "$dir" ]]; then
        echo "  Not found: $dir"
        # Try to find it
        local alt=$(find /home/chronos -name "Extensions" -type d 2>/dev/null | head -1)
        [[ -n "$alt" ]] && dir="$alt" && echo "  Found at: $alt" || { pause_key; return; }
    fi
    local n=0
    printf "  ${WHT}%-26s %-45s %s${RST}\n" "Extension ID" "Name" "Version"
    echo "  $(printf '%.0s─' {1..70})"
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        # Find manifest in latest version folder
        local mf=$(find "$id_dir" -name "manifest.json" -not -path "*/node_modules/*" 2>/dev/null \
            | sort -V | tail -1)
        local name="unknown" ver=""
        if [[ -n "$mf" ]]; then
            name=$(python3 -c "import json,sys; d=json.load(open('$mf')); print(d.get('name','unknown')[:44])" 2>/dev/null \
                || grep '"name"' "$mf" 2>/dev/null | head -1 \
                    | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | cut -c1-44)
            ver=$(python3 -c "import json,sys; d=json.load(open('$mf')); print(d.get('version',''))" 2>/dev/null \
                || grep '"version"' "$mf" 2>/dev/null | head -1 \
                    | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/')
        fi
        printf "  ${DIM}%-26s${RST} %-45s ${DIM}%s${RST}\n" "${id:0:26}" "${name:0:44}" "$ver"
        ((n++))
    done
    echo -e "\n  ${DIM}${n} extension(s) found${RST}"
    pause_key
}

