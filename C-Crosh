menu_wipe() {
    draw_menu "Wipe / Clean" \
        "Wipe system logs" \
        "Clear /tmp" \
        "Clear Chrome cache (stateful)" \
        "← Back"
    case $MENU_RESULT in
        0)  banner
            echo -ne "  ${YLW}[!] Clear system logs? [y/N]:${RST} "
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                for f in /var/log/*.log /var/log/messages /var/log/syslog; do
                    [[ -f "$f" ]] && > "$f" && echo -e "  ${GRN}cleared:${RST} $f"
                done
                journalctl --rotate --vacuum-time=1s 2>/dev/null
                echo -e "\n  ${GRN}[+] Logs cleared.${RST}"
            else; echo -e "  ${DIM}Cancelled.${RST}"; fi
            pause_key ;;
        1)  banner
            echo -ne "  ${YLW}[!] Clear /tmp? [y/N]:${RST} "
            read -r c; [[ "$c" =~ ^[Yy]$ ]] && rm -rf /tmp/* 2>/dev/null \
                && echo -e "  ${GRN}[+] /tmp cleared.${RST}" || echo -e "  ${DIM}Cancelled.${RST}"
            pause_key ;;
        2)  banner
            echo -ne "  ${YLW}[!] Clear Chrome cache? [y/N]:${RST} "
            read -r c
            if [[ "$c" =~ ^[Yy]$ ]]; then
                find /home/chronos -name "Cache" -type d 2>/dev/null | while read d; do
                    rm -rf "$d"/* 2>/dev/null && echo -e "  ${GRN}cleared:${RST} $d"
                done
            else; echo -e "  ${DIM}Cancelled.${RST}"; fi
            pause_key ;;
    esac
}

