page_sysinfo() {
    banner
    echo -e "  ${WHT}── System Info ──────────────────────────────────────${RST}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local version=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local channel=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mem_total=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mem_free=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mem_used=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    local arch=$(uname -m)
    local swap_total=$(awk '/SwapTotal/{printf "%.0f MB",$2/1024}' /proc/meminfo)
    local swap_free=$(awk '/SwapFree/{printf "%.0f MB",$2/1024}' /proc/meminfo)

    echo -e "  ${CYN}Board:${RST}        ${board:-unknown}"
    echo -e "  ${CYN}CrOS Version:${RST} ${version:-unknown}  (${channel:-unknown})"
    echo -e "  ${CYN}Build:${RST}        ${build:-unknown}"
    echo -e "  ${CYN}Kernel:${RST}       $(uname -r) [${arch}]"
    echo -e "  ${CYN}CPU:${RST}          ${cpu:-unknown}"
    echo -e "  ${CYN}Cores:${RST}        ${cores}"
    echo -e "  ${CYN}RAM:${RST}          ${mem_used} used / ${mem_free} free / ${mem_total} total"
    echo -e "  ${CYN}Swap:${RST}         ${swap_free} free / ${swap_total} total"
    echo -e "  ${CYN}Uptime:${RST}       $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${CYN}Hostname:${RST}     $(hostname)"
    echo -e "  ${CYN}User:${RST}         $(whoami) (uid=$(id -u) gid=$(id -g))"
    echo -e "  ${CYN}minioverride:${RST} $([[ -f "$OVERRIDE_SO" ]] && echo "${GRN}installed${RST}" || echo "${YLW}missing${RST}")"
    echo -e "  ${CYN}ui.conf patch:${RST} $([[ -f "$UI_CONF" ]] && grep -q minioverride "$UI_CONF" && echo "${GRN}active${RST}" || echo "${YLW}not active${RST}")"
    pause_key
}

page_battery() {
    banner
    echo -e "  ${WHT}── Battery Health ───────────────────────────────────${RST}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done

    if [[ -n "$bat" ]]; then
        local status=$(cat "$bat/status" 2>/dev/null || echo "unknown")
        local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
        local efull=$(cat "$bat/energy_full" 2>/dev/null)
        local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
        local enow=$(cat "$bat/energy_now" 2>/dev/null)
        local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
        local current=$(cat "$bat/current_now" 2>/dev/null)
        local cycles=$(cat "$bat/cycle_count" 2>/dev/null)
        local mfr=$(cat "$bat/manufacturer" 2>/dev/null)
        local model=$(cat "$bat/model_name" 2>/dev/null)
        local tech=$(cat "$bat/technology" 2>/dev/null)

        echo -e "  ${CYN}Status:${RST}       $status"
        echo -e "  ${CYN}Charge:${RST}       ${cap}%"
        [[ -n "$mfr" ]]    && echo -e "  ${CYN}Manufacturer:${RST} $mfr"
        [[ -n "$model" ]]  && echo -e "  ${CYN}Model:${RST}        $model"
        [[ -n "$tech" ]]   && echo -e "  ${CYN}Technology:${RST}   $tech"
        [[ -n "$cycles" ]] && echo -e "  ${CYN}Cycles:${RST}       $cycles"
        if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
            local health=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
            # Color health by level
            local hcolor=$GRN
            (( $(echo "$health < 80" | bc -l 2>/dev/null) )) && hcolor=$YLW
            (( $(echo "$health < 60" | bc -l 2>/dev/null) )) && hcolor=$RED
            echo -e "  ${CYN}Health:${RST}       ${hcolor}${health}%${RST} of design capacity"
            [[ -n "$enow" ]] && echo -e "  ${CYN}Now:${RST}          $(awk "BEGIN{printf \"%.2f Wh\",$enow/1000000}")"
            echo -e "  ${CYN}Full cap:${RST}     $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
            echo -e "  ${CYN}Design cap:${RST}   $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
        fi
        [[ -n "$voltage" ]] && echo -e "  ${CYN}Voltage:${RST}      $(awk "BEGIN{printf \"%.3f V\",$voltage/1000000}")"
        [[ -n "$current" ]] && echo -e "  ${CYN}Current:${RST}      $(awk "BEGIN{printf \"%.0f mA\",$current/1000}")"
    fi

    # ectool as supplement
    if command -v ectool &>/dev/null; then
        echo -e "\n  ${DIM}ectool batterystatus:${RST}"
        ectool batterystatus 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

page_sensors() {
    banner
    echo -e "  ${WHT}── Sensors / Temperature ────────────────────────────${RST}\n"
    local found=0
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f" | grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null || echo "unknown")
        local raw=$(cat "$f" 2>/dev/null || echo "0")
        local temp=$(awk "BEGIN{printf \"%.1f\", $raw/1000}")
        # Color by temp
        local tcolor=$GRN
        (( raw > 70000 )) && tcolor=$YLW
        (( raw > 85000 )) && tcolor=$RED
        printf "  ${CYN}%-10s${RST} %-28s ${tcolor}%s°C${RST}\n" "$zone" "($type)" "$temp"
        found=1
    done
    [[ $found -eq 0 ]] && echo "  No thermal zones found."

    if command -v ectool &>/dev/null; then
        echo -e "\n  ${DIM}Fan RPM:${RST}"
        ectool pwmgetfanrpm 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${DIM}ectool temps:${RST}"
        ectool temps all 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

page_devmode() {
    banner
    echo -e "  ${WHT}── Dev Mode / Boot Flags ────────────────────────────${RST}\n"
    if command -v crossystem &>/dev/null; then
        # Key flags first
        echo -e "  ${WHT}Key flags:${RST}"
        for key in devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur; do
            local val=$(crossystem $key 2>/dev/null || echo "n/a")
            # Color 1=enabled green, 0=disabled dim
            local vc=$DIM
            [[ "$val" == "1" ]] && vc=$GRN
            printf "  ${CYN}%-30s${RST} ${vc}%s${RST}\n" "$key" "$val"
        done
        echo ""
        echo -e "  ${WHT}Firmware:${RST}"
        for key in fwid ro_fwid mainfw_act mainfw_type; do
            printf "  ${CYN}%-30s${RST} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
        echo ""
        echo -e "  ${DIM}Press B for full crossystem dump, any other key to go back...${RST}"
        IFS= read -rsn1 kk
        if [[ "$kk" == "b" || "$kk" == "B" ]]; then
            banner
            echo -e "  ${WHT}── Full crossystem ──────────────────────────────────${RST}\n"
            crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
            pause_key
        fi
    else
        echo "  crossystem not available."; pause_key
    fi
}

page_net() {
