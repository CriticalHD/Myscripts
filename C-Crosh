menu_wipe() {
    draw_menu "Wipe / Clean" \
        "Wipe system logs" \
        "Clear /tmp" \
        "Clear Chrome cache" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           if confirm_yn "Clear system logs?"; then
               for f in /var/log/*.log /var/log/messages /var/log/syslog; do
                   [[ -f "$f" ]] && > "$f" && echo -e "  ${G}cleared:${N} $f"
               done
               journalctl --rotate --vacuum-time=1s 2>/dev/null
               echo -e "\n  ${G}[+] Done.${N}"
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
        1) banner
           if confirm_yn "Clear /tmp?"; then
               rm -rf /tmp/* 2>/dev/null
               echo -e "  ${G}[+] /tmp cleared.${N}"
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
        2) banner
           if confirm_yn "Clear Chrome cache?"; then
               find /home/chronos -name "Cache" -type d 2>/dev/null | while read d; do
                   rm -rf "${d:?}"/* 2>/dev/null && echo -e "  ${G}cleared:${N} $d"
               done
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
    esac
}

