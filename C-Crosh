    draw_menu "SSH Options" "Restart cshell sshd (port 1337)" "Enable public SSH (port 22)" "Change chronos password" "Change root password" "← Back"
    case $MENU_RESULT in
        0) banner
           doas "$(declare -f setup_root_sshd); ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'; setup_root_sshd" 2>/dev/null \
               || setup_root_sshd
           doas_check && echo -e "  ${G}doas now working!${N}" || echo -e "  ${R}Still not working.${N}"
           pause_key ;;
