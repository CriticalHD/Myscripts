#!/bin/bash
_SELF_PAYLOAD=""
# cshell v2.1 — Custom ChromeOS Shell
# curl -sSL <url> | sudo bash

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
UI_CONF="/etc/init/ui.conf"
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
VERSION="2.2"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
C='\033[0;36m'; W='\033[1;37m'; D='\033[2m'
N='\033[0m';    V='\033[7m'

trap 'echo -e "\n${D}Interrupted.${N}"; exit 130' INT TERM

remount_rw() {
    mount -o remount,rw /    2>/dev/null || true
    mount -o remount,rw /usr 2>/dev/null || true
    mount -o remount,rw /etc 2>/dev/null || true
}

tread()  { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}root@$(hostname -s 2>/dev/null || echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}

pause_key() { echo -e "\n  ${D}Press any key...${N}"; tread1 _k; }

confirm_yn() {
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a
    [[ "$_a" =~ ^[Yy]$ ]]
}

draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}
    if [[ -t 0 && -t 1 ]]; then
        local sel=0
        while true; do
            banner
            echo -e "  ${W}${title}${N}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $sel ]]; then
                    echo -e "  ${V}${C}  ›  ${items[$i]}  ${N}"
                else
                    echo -e "  ${D}     ${items[$i]}${N}"
                fi
            done
            echo -e "\n  ${D}↑↓ navigate   Enter select   Q quit${N}"
            local k; IFS= read -rsn1 k </dev/tty 2>/dev/null
            if [[ "$k" == $'\x1b' ]]; then
                local s; read -rsn2 -t 0.1 s </dev/tty 2>/dev/null
                case "$s" in
                    '[A') (( sel > 0 )) && (( sel-- )) ;;
                    '[B') (( sel < count-1 )) && (( sel++ )) ;;
                esac
            elif [[ "$k" == "" ]]; then MENU_RESULT=$sel; return
            elif [[ "$k" == "q" || "$k" == "Q" || "$k" == $'\x03' ]]; then
                MENU_RESULT=-1; return
            fi
        done
    else
        banner
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do
            echo -e "  ${C}$((i+1)))${N}  ${items[$i]}"
        done
        echo ""
        echo -ne "  ${W}Select [1-${count}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch >= 1 && ch <= count )); then
            MENU_RESULT=$((ch-1))
        else
            MENU_RESULT=-1
        fi
    fi
}

check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then rm -f /usr/bin/.rw_test; return 0; fi
    banner
    echo -e "  ${Y}Rootfs is read-only. Disable verification?${N}\n"
    if confirm_yn "Run make_dev_ssd.sh now?"; then
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}Done. Reboot then re-run.${N}"
        if confirm_yn "Reboot now?"; then reboot; fi
        exit 0
    else
        echo -e "${R}Cannot continue without writable rootfs.${N}"; exit 1
    fi
}

C_SRC='int minijail_no_new_privs(void){return 0;}
int minijail_add_fs_restriction_rx(void){return 0;}
int minijail_add_fs_restriction_advanced_rw(void){return 0;}
int minijail_set_enable_profile_fs_restrictions(void){return 0;}
int minijail_enable_default_fs_restrictions(void){return 0;}'

build_minioverride() {
    printf '%s' "$C_SRC" > /tmp/_mo.c
    for cc in gcc tcc cc; do
        command -v "$cc" &>/dev/null || continue
        $cc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null && { rm -f /tmp/_mo.c; return 0; }
    done
    rm -f /tmp/_mo.c
    # Try download
    curl -sSfL "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
        -o "$OVERRIDE_SO" 2>/dev/null && [[ -s "$OVERRIDE_SO" ]] && return 0
    return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return 1
    grep -q "minioverride" "$UI_CONF" 2>/dev/null && { echo -e "${D}    ui.conf already patched.${N}"; return 0; }
    { echo "env LD_PRELOAD=/usr/local/bin/minioverride.so"; cat "$UI_CONF"; } > /tmp/_ui.tmp
    cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    echo -e "${G}    Patched ui.conf — reboot needed.${N}"
    NEEDS_REBOOT=1
}

install_minioverride() {
    echo -e "${D}    Building minioverride.so...${N}"
    if build_minioverride; then
        chmod 755 "$OVERRIDE_SO"
        echo -e "${G}    minioverride.so ready.${N}"
        patch_ui_conf
    else
        echo -e "${Y}    minioverride build failed — sudo may not work until repaired.${N}"
        OVERRIDE_FAILED=1
    fi
}

remove_minioverride() {
    if [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" 2>/dev/null; then
        grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp
        cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
        echo -e "${G}[+] Removed minioverride from ui.conf${N}"
    fi
    rm -f "$OVERRIDE_SO" /usr/bin/minioverride.so
}

install_persistence() {
    cp "$SHELL_PATH" "$ROOTFS_SHELL" 2>/dev/null && chmod +x "$ROOTFS_SHELL"
    [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
    cat > "$INIT_SCRIPT" << 'UPSTART'
description "cshell post-boot restore"
start on started system-services
task
script
    [ -f /usr/local/bin/cshell ] || { mkdir -p /usr/local/bin; cp /usr/bin/cshell_rootfs /usr/local/bin/cshell; chmod +x /usr/local/bin/cshell; }
    grep -q "cshell" /usr/bin/crosh 2>/dev/null || { printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > /usr/bin/crosh; chmod +x /usr/bin/crosh; }
    [ -f /usr/local/bin/minioverride.so ] || { [ -f /usr/bin/minioverride.so ] && cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so && chmod 755 /usr/local/bin/minioverride.so; }
end script
UPSTART
    echo -e "${G}    Persistence installed (survives powerwash).${N}"
}

write_self_to() {
    local dest="$1"
    # Primary: decode the embedded payload (always works with curl|bash)
    if echo "$_SELF_PAYLOAD" | base64 -d > "$dest" 2>/dev/null && [[ -s "$dest" ]]; then
        return 0
    fi
    # Fallback: we are a real file
    local src="${BASH_SOURCE[0]:-$0}"
    if [[ -f "$src" && "$src" != "bash" && "$src" != "/bin/bash" ]]; then
        cp "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    fi
    return 1
}

do_install() {
    banner
    echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}[!] Must be root.${N}" && exit 1
    echo -e "${D}    Checking rootfs...${N}"; check_rootfs
    mkdir -p /usr/local/bin

    echo -e "${D}    Writing cshell...${N}"
    # SELF_INSTALL: the script writes itself — no download needed
    if write_self_to "$SHELL_PATH"; then
        chmod +x "$SHELL_PATH"
        echo -e "${G}    Written to ${SHELL_PATH}${N}"
    else
        echo -e "${R}[!] Self-write failed. This should never happen.${N}"
        echo -e "${R}    Run as: bash cshell.sh  or  bash <(curl -sSL <url>)${N}"
        exit 1
    fi

    NEEDS_REBOOT=0; OVERRIDE_FAILED=0
    install_minioverride
    install_persistence

    [[ ! -f "$CROSH_BACKUP" ]] && cp "$CROSH_PATH" "$CROSH_BACKUP" \
        && echo -e "${G}    Crosh backed up.${N}"
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${G}    Crosh stub installed.${N}\n"
    echo -e "${G}[+] Done!${N}"
    [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "${Y}[!] Reboot required for sudo fix.${N}" \
        && confirm_yn "Reboot now?" && reboot
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_delete() {
    banner; echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete
    remount_rw; remove_minioverride
    rm -f "$SHELL_PATH" "$ROOTFS_SHELL" "$INIT_SCRIPT"
    echo -e "${G}[+] Deleted.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_restore_crosh() {
    banner; echo -e "${Y}[*] Restoring crosh...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        rm -f "$CROSH_PATH"; cp "$CROSH_BACKUP" "$CROSH_PATH"; chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"; echo -e "${G}[+] Crosh restored.${N}"
    else
        echo -e "${R}[!] No backup found.${N}"
    fi
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

# ════════════════════════════════════════════════════════════════
#  SHELL PAGES
# ════════════════════════════════════════════════════════════════

pg_sysinfo() {
    banner
    echo -e "  ${W}── System Info ──────────────────────────────────────${N}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local ver=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local chan=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mt=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mf=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mu=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    local st=$(awk '/SwapTotal/{printf "%.0f MB",$2/1024}' /proc/meminfo)
    echo -e "  ${C}Board:${N}         ${board:-unknown}"
    echo -e "  ${C}Version:${N}       ${ver:-?}  (${chan:-?})"
    echo -e "  ${C}Build:${N}         ${build:-?}"
    echo -e "  ${C}Kernel:${N}        $(uname -r) [$(uname -m)]"
    echo -e "  ${C}CPU:${N}           ${cpu:-?} x${cores}"
    echo -e "  ${C}RAM:${N}           ${mu} used / ${mf} free / ${mt} total"
    echo -e "  ${C}Swap:${N}          ${st}"
    echo -e "  ${C}Uptime:${N}        $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${C}Hostname:${N}      $(hostname)"
    echo -e "  ${C}User:${N}          $(whoami) uid=$(id -u)"
    echo -e "  ${C}minioverride:${N}  $([[ -f $OVERRIDE_SO ]] && echo "${G}installed${N}" || echo "${Y}missing${N}")"
    echo -e "  ${C}ui.conf patch:${N} $(grep -q minioverride $UI_CONF 2>/dev/null && echo "${G}active${N}" || echo "${Y}inactive${N}")"
    echo -e "  ${C}persistence:${N}   $([[ -f $INIT_SCRIPT ]] && echo "${G}yes${N}" || echo "${Y}no${N}")"
    pause_key
}

pg_battery() {
    banner
    echo -e "  ${W}── Battery ──────────────────────────────────────────${N}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -n "$bat" ]]; then
        local status=$(cat "$bat/status" 2>/dev/null || echo "?")
        local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
        local efull=$(cat "$bat/energy_full" 2>/dev/null)
        local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
        local enow=$(cat "$bat/energy_now" 2>/dev/null)
        local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
        local current=$(cat "$bat/current_now" 2>/dev/null)
        local cycles=$(cat "$bat/cycle_count" 2>/dev/null)
        local mfr=$(cat "$bat/manufacturer" 2>/dev/null)
        local model=$(cat "$bat/model_name" 2>/dev/null)
        local tech=$(cat "$bat/technology" 2>/dev/null)
        echo -e "  ${C}Status:${N}       $status"
        echo -e "  ${C}Charge:${N}       ${cap}%"
        [[ -n "$mfr" ]]    && echo -e "  ${C}Manufacturer:${N} $mfr"
        [[ -n "$model" ]]  && echo -e "  ${C}Model:${N}        $model"
        [[ -n "$tech" ]]   && echo -e "  ${C}Technology:${N}   $tech"
        [[ -n "$cycles" && "$cycles" != "0" ]] && echo -e "  ${C}Cycles:${N}       $cycles"
        if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
            local h=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
            local hc=$G
            awk "BEGIN{exit !($h+0 < 80)}" 2>/dev/null && hc=$Y
            awk "BEGIN{exit !($h+0 < 60)}" 2>/dev/null && hc=$R
            echo -e "  ${C}Health:${N}       ${hc}${h}%${N}"
            [[ -n "$enow" ]]    && echo -e "  ${C}Energy now:${N}   $(awk "BEGIN{printf \"%.2f Wh\",$enow/1000000}")"
            echo -e "  ${C}Full cap:${N}     $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
            echo -e "  ${C}Design cap:${N}   $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
        fi
        [[ -n "$voltage" ]] && echo -e "  ${C}Voltage:${N}      $(awk "BEGIN{printf \"%.3f V\",$voltage/1000000}")"
        [[ -n "$current" ]] && echo -e "  ${C}Draw:${N}         $(awk "BEGIN{printf \"%.0f mA\",$current/1000}")"
    fi
    command -v ectool &>/dev/null && { echo -e "\n  ${D}ectool:${N}"; ectool batterystatus 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

pg_sensors() {
    banner
    echo -e "  ${W}── Sensors / Temperature ────────────────────────────${N}\n"
    local found=0
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f" | grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null || echo "?")
        local raw=$(cat "$f" 2>/dev/null || echo "0")
        local tc=$G
        (( raw > 70000 )) && tc=$Y
        (( raw > 85000 )) && tc=$R
        printf "  ${C}%-10s${N} %-24s ${tc}%.1f°C${N}\n" "$zone" "($type)" "$(awk "BEGIN{print $raw/1000}")"
        found=1
    done
    [[ $found -eq 0 ]] && echo "  No thermal zones found."
    if command -v ectool &>/dev/null; then
        echo -e "\n  ${D}Fan:${N}"; ectool pwmgetfanrpm 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}EC temps:${N}"; ectool temps all 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

pg_devmode() {
    banner
    echo -e "  ${W}── Dev Mode / Boot Flags ────────────────────────────${N}\n"
    if command -v crossystem &>/dev/null; then
        echo -e "  ${W}Key flags:${N}"
        for key in devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur; do
            local val=$(crossystem $key 2>/dev/null || echo "n/a")
            local vc=$D; [[ "$val" == "1" ]] && vc=$G
            printf "  ${C}%-32s${N} ${vc}%s${N}\n" "$key" "$val"
        done
        echo -e "\n  ${W}Firmware:${N}"
        for key in fwid ro_fwid mainfw_act mainfw_type; do
            printf "  ${C}%-32s${N} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
        echo -e "\n  ${D}[B] Full dump  [any] Back${N}"
        local k; tread1 k
        if [[ "$k" == "b" || "$k" == "B" ]]; then
            banner; echo -e "  ${W}── Full crossystem ──────────────────────────────────${N}\n"
            crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key
        fi
    else
        echo "  crossystem not available."; pause_key
    fi
}

pg_gbb() {
    banner
    echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"
    command -v futility &>/dev/null && {
        echo -e "  ${D}Current:${N}"
        futility gbb --get --flags 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    } || echo "  futility not found."
    echo -e "\n  ${W}Reference:${N}"
    echo -e "  ${C}0x0001${N}  DEV_SCREEN_SHORT_DELAY"
    echo -e "  ${C}0x0008${N}  FORCE_DEV_SWITCH_ON"
    echo -e "  ${C}0x0010${N}  DISABLE_DEV_REQUEST"
    echo -e "  ${C}0x0020${N}  DISABLE_FW_ROLLBACK_CHECK"
    echo -e "  ${C}0x8000${N}  CCD_UNLOCK"
    echo -e "  ${C}0x8090${N}  Murkmod/fakemurk value"
    pause_key
}

pg_vpd() {
    banner; echo -e "  ${W}── VPD ──────────────────────────────────────────────${N}\n"
    if command -v vpd &>/dev/null; then
        echo -e "  ${W}RO VPD:${N}"; vpd -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${W}RW VPD:${N}"; vpd -i RW_VPD -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  vpd not available."
    fi
    pause_key
}

pg_net() {
    banner; echo -e "  ${W}── Network ──────────────────────────────────────────${N}\n"
    echo -e "  ${W}Interfaces:${N}"; ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Routes:${N}"; ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}DNS:${N}"; grep "^nameserver" /etc/resolv.conf 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[P] Ping  [T] Traceroute  [S] Speedtest  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        p|P) banner; echo -e "${Y}Pinging 8.8.8.8...${N}\n"
             ping -c 4 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) banner; echo -e "${Y}Traceroute to 8.8.8.8...${N}\n"
             traceroute -m 15 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        s|S) banner; echo -e "${Y}Speedtest (curl to fast.com)...${N}\n"
             curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 2>&1 \
                 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_wifi() {
    banner; echo -e "  ${W}── WiFi ─────────────────────────────────────────────${N}\n"
    if command -v iw &>/dev/null; then
        local iface=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)
        echo -e "  ${W}Interface: ${iface:-?}${N}\n"
        if [[ -n "$iface" ]]; then
            echo -e "  ${D}Link:${N}"; iw dev "$iface" link 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
            echo -e "\n  ${D}Signal/rates:${N}"
            iw dev "$iface" station dump 2>/dev/null \
                | grep -E "signal|tx bitrate|rx bitrate|inactive" \
                | while IFS= read -r l; do echo "  $l"; done
        fi
    else
        echo "  iw not available."
    fi
    pause_key
}

pg_storage() {
    banner; echo -e "  ${W}── Storage ──────────────────────────────────────────${N}\n"
    echo -e "  ${W}Usage:${N}"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs\|^udev\|^overlay\|^shm\|^none" \
        | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Block devices:${N}"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_memory() {
    banner; echo -e "  ${W}── Memory ───────────────────────────────────────────${N}\n"
    cat /proc/meminfo 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_procs() {
    banner; echo -e "  ${W}── Processes ────────────────────────────────────────${N}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[M] Mem sort  [K] Kill PID  [G] Grep name  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        m|M) banner; echo -e "  ${W}── By Memory ────────────────────────────────────────${N}\n"
             ps aux --sort=-%mem 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        k|K) echo -ne "\n  ${Y}PID to kill:${N} "; local pid; tread pid
             [[ "$pid" =~ ^[0-9]+$ ]] && kill -9 "$pid" 2>/dev/null \
                 && echo -e "  ${G}Killed $pid${N}" || echo -e "  ${R}Failed${N}"; pause_key ;;
        g|G) echo -ne "\n  ${Y}Process name grep:${N} "; local nm; tread nm
             ps aux 2>/dev/null | grep -i "$nm" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_usb() {
    banner; echo -e "  ${W}── USB Devices ──────────────────────────────────────${N}\n"
    if command -v lsusb &>/dev/null; then
        lsusb 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        for dev in /sys/bus/usb/devices/*/; do
            local v=$(cat "$dev/idVendor" 2>/dev/null)
            local p=$(cat "$dev/idProduct" 2>/dev/null)
            local n=$(cat "$dev/product" 2>/dev/null || echo "Unknown")
            [[ -n "$v" ]] && echo -e "  ${C}${v}:${p}${N}  $n"
        done
    fi
    pause_key
}

pg_firewall() {
    banner; echo -e "  ${W}── Firewall / iptables ──────────────────────────────${N}\n"
    iptables -L -n -v 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_logs() {
    banner; echo -e "  ${W}── System Logs (last 40) ────────────────────────────${N}\n"
    tail -40 /var/log/messages 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || journalctl -n 40 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_cros_logs() {
    banner; echo -e "  ${W}── ChromeOS Logs ────────────────────────────────────${N}\n"
    echo -e "  ${D}update_engine (last 20):${N}"
    tail -20 /var/log/update_engine.log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}power_manager (last 10):${N}"
    tail -10 /var/log/power_manager/power_log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    local cf=$(ls -t /var/log/chrome/*.log 2>/dev/null | head -1)
    [[ -n "$cf" ]] && { echo -e "\n  ${D}Chrome (last 15):${N}"; tail -15 "$cf" | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

pg_extensions() {
    banner; echo -e "  ${W}── Chrome Extensions ────────────────────────────────${N}\n"
    local dir="/home/chronos/user/Extensions"
    [[ ! -d "$dir" ]] && dir=$(find /home/chronos -name "Extensions" -type d 2>/dev/null | head -1)
    if [[ -z "$dir" ]]; then echo "  Not found."; pause_key; return; fi
    local n=0
    printf "  ${W}%-26s %-38s %s${N}\n" "ID" "Name" "Ver"
    echo "  $(printf '%0.s─' {1..66})"
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | sort -V | tail -1)
        local name="?" ver="?"
        if [[ -n "$mf" ]]; then
            name=$(python3 -c "import json; d=json.load(open('$mf')); print(d.get('name','?')[:36])" 2>/dev/null \
                || grep '"name"' "$mf" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/' | cut -c1-36)
            ver=$(python3 -c "import json; d=json.load(open('$mf')); print(d.get('version','?'))" 2>/dev/null \
                || grep '"version"' "$mf" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')
        fi
        printf "  ${D}%-26s${N} %-38s ${D}%s${N}\n" "${id:0:26}" "${name:0:36}" "$ver"
        ((n++))
    done
    echo -e "\n  ${D}${n} extension(s)${N}"; pause_key
}

pg_chpasswd() {
    banner; echo -e "  ${W}── Change Password ──────────────────────────────────${N}\n"
    draw_menu "Which user?" "chronos" "root" "← Back"
    case $MENU_RESULT in
        0) passwd chronos ;;
        1) passwd root ;;
    esac
    pause_key
}

pg_ssh() {
    banner; echo -e "  ${W}── SSH ───────────────────────────────────────────────${N}\n"
    passwd -S chronos 2>/dev/null | grep -q " P " \
        || echo -e "  ${Y}[!] chronos has no password — SSH auth may fail. Set one first.${N}\n"
    /usr/sbin/sshd 2>/dev/null \
        && echo -e "  ${G}[+] sshd started.${N}" \
        || echo -e "  ${Y}[!] sshd may already be running or failed.${N}"
    local ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    echo -e "  ${D}Connect: ssh chronos@${ip:-<your-ip>}${N}"
    pause_key
}

pg_crostini() {
    banner; echo -e "  ${W}── Crostini / Linux VM ──────────────────────────────${N}\n"
    echo -e "  ${D}VM status:${N}"
    vmc list 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || echo "  vmc not available or no VMs."
    echo -e "\n  ${D}[S] Start termina  [T] Stop termina  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        s|S) vmc start termina 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) vmc stop termina 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_android() {
    banner; echo -e "  ${W}── Android / ARC++ ──────────────────────────────────${N}\n"
    if command -v adb &>/dev/null; then
        echo -e "  ${D}ADB devices:${N}"
        adb devices 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}ARC++ packages (first 20):${N}"
        adb shell pm list packages 2>/dev/null | head -20 | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  ADB not available in this context."
        echo -e "\n  ${D}ARC proc check:${N}"
        ps aux 2>/dev/null | grep -i "arc\|android" | grep -v grep | head -10 \
            | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

pg_cpu_stress() {
    banner; echo -e "  ${W}── CPU Stress Test ──────────────────────────────────${N}\n"
    echo -e "  ${Y}[!] Runs CPU at 100% for 10 seconds.${N}"
    if confirm_yn "Start stress test?"; then
        echo -e "\n  ${Y}Stressing all $(nproc) cores for 10s...${N}"
        timeout 10 bash -c "for i in \$(seq 1 \$(nproc)); do while :; do :; done & done; wait" 2>/dev/null
        echo -e "  ${G}Done.${N}"
        echo -e "\n  ${D}Temp after stress:${N}"
        for f in /sys/class/thermal/thermal_zone*/temp; do
            [[ -f "$f" ]] || continue
            local type=$(cat "$(dirname $f)/type" 2>/dev/null || echo "?")
            printf "  %-20s %.1f°C\n" "($type)" "$(awk "BEGIN{print $(cat $f)/1000}")"
        done
    else
        echo -e "  ${D}Cancelled.${N}"
    fi
    pause_key
}

pg_disk_bench() {
    banner; echo -e "  ${W}── Disk Speed Benchmark ─────────────────────────────${N}\n"
    if confirm_yn "Run disk benchmark (write 128MB to /tmp)?"; then
        echo -e "\n  ${D}Write speed:${N}"
        dd if=/dev/zero of=/tmp/_bench bs=1M count=128 conv=fdatasync 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}Read speed:${N}"
        dd if=/tmp/_bench of=/dev/null bs=1M 2>&1 | while IFS= read -r l; do echo "  $l"; done
        rm -f /tmp/_bench
    else
        echo -e "  ${D}Cancelled.${N}"
    fi
    pause_key
}

pg_net_mon() {
    banner; echo -e "  ${W}── Network Monitor ──────────────────────────────────${N}\n"
    echo -e "  ${D}Active connections:${N}"
    ss -tunp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || netstat -tunp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}Open ports:${N}"
    ss -tlnp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_file_browser() {
    local cur_dir="${1:-/}"
    while true; do
        banner
        echo -e "  ${W}── File Browser: ${cur_dir} ──${N}\n"
        local entries=()
        [[ "$cur_dir" != "/" ]] && entries+=(".. (up)")
        while IFS= read -r f; do
            local name=$(basename "$f")
            if [[ -d "$f" ]]; then entries+=("${name}/")
            else
                local size=$(du -sh "$f" 2>/dev/null | cut -f1)
                entries+=("${name}  [${size}]")
            fi
        done < <(ls -1p "$cur_dir" 2>/dev/null | head -30)
        entries+=("← Exit browser")
        draw_menu "File Browser: $cur_dir" "${entries[@]}"
        local sel=$MENU_RESULT
        [[ $sel -eq -1 ]] && return
        local chosen="${entries[$sel]}"
        if [[ "$chosen" == ".. (up)" ]]; then
            cur_dir=$(dirname "$cur_dir")
        elif [[ "$chosen" == "← Exit browser" ]]; then
            return
        elif [[ "$chosen" == */ ]]; then
            cur_dir="${cur_dir%/}/${chosen%/}"
        else
            # File selected — show options
            local fname="${chosen%%  *}"
            local fpath="${cur_dir%/}/${fname}"
            draw_menu "File: $fname" "View (tail -50)" "Delete" "Copy path" "← Back"
            case $MENU_RESULT in
                0) banner; tail -50 "$fpath" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                1) confirm_yn "Delete $fpath?" && rm -f "$fpath" && echo -e "  ${G}Deleted.${N}" || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
                2) echo "$fpath"; pause_key ;;
            esac
        fi
    done
}

menu_rootfs_mgr() {
    draw_menu "Rootfs" "Remount read-write" "Remount read-only" "Show mount flags" "← Back"
    case $MENU_RESULT in
        0) banner; remount_rw; echo -e "  ${G}Remounted rw.${N}"; pause_key ;;
        1) banner; mount -o remount,ro / 2>/dev/null; echo -e "  ${G}Remounted ro.${N}"; pause_key ;;
        2) banner; mount | grep -E "on / |on /usr" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

menu_updates() {
    draw_menu "Update Engine" "Block updates" "Allow updates" "Check status" "Force check" "← Back"
    case $MENU_RESULT in
        0) banner; systemctl stop update-engine 2>/dev/null; stop update-engine 2>/dev/null; pkill -f update_engine 2>/dev/null
           echo -e "  ${G}Updates blocked.${N}"; pause_key ;;
        1) banner; systemctl start update-engine 2>/dev/null; start update-engine 2>/dev/null
           echo -e "  ${G}Updates allowed.${N}"; pause_key ;;
        2) banner; update_engine_client --status 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        3) banner; update_engine_client --check_for_update 2>/dev/null; sleep 2
           update_engine_client --status 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

menu_wipe() {
    draw_menu "Wipe / Clean" "Wipe system logs" "Clear /tmp" "Clear Chrome cache" "← Back"
    case $MENU_RESULT in
        0) banner
           if confirm_yn "Clear system logs?"; then
               for f in /var/log/*.log /var/log/messages /var/log/syslog; do
                   [[ -f "$f" ]] && > "$f" && echo -e "  ${G}cleared: $f${N}"
               done
               journalctl --rotate --vacuum-time=1s 2>/dev/null
               echo -e "  ${G}Done.${N}"
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
        1) banner
           if confirm_yn "Clear /tmp?"; then
               rm -rf /tmp/* 2>/dev/null; echo -e "  ${G}Done.${N}"
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
        2) banner
           if confirm_yn "Clear Chrome cache?"; then
               find /home/chronos -name "Cache" -type d 2>/dev/null | while read d; do
                   rm -rf "${d:?}"/* 2>/dev/null && echo -e "  ${G}cleared: $d${N}"
               done
           else
               echo -e "  ${D}Cancelled.${N}"
           fi
           pause_key ;;
    esac
}

menu_scripts() {
    while true; do
        draw_menu "Run Scripts" "K-Patch" "SAUB" "R-Patch" "← Back"
        case $MENU_RESULT in
            0) banner; bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/K-Patch); pause_key ;;
            1) banner; bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/SAUB); pause_key ;;
            2) banner; bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/R-Patch); pause_key ;;
            *) return ;;
        esac
    done
}

pg_repair_sudo() {
    banner; echo -e "  ${W}── Repair sudo ──────────────────────────────────────${N}\n"
    if confirm_yn "Rebuild minioverride and re-patch ui.conf?"; then
        remount_rw; mkdir -p /usr/local/bin; rm -f "$OVERRIDE_SO"
        NEEDS_REBOOT=0; install_minioverride
        [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
        [[ $NEEDS_REBOOT -eq 1 ]] && confirm_yn "Reboot now?" && reboot
    else
        echo -e "  ${D}Cancelled.${N}"
    fi
    pause_key
}

pg_bash() {
    banner; echo -e "  ${Y}Root bash — type 'exit' to return.${N}\n"
    bash --login; echo -e "\n  ${C}Back in cshell.${N}"; sleep 1
}

menu_power() {
    draw_menu "Power" "Reboot" "Reboot to recovery" "Shut down" "← Back"
    case $MENU_RESULT in
        0) reboot ;;
        1) crossystem recovery_request=1 2>/dev/null; reboot ;;
        2) poweroff ;;
    esac
}

