# ─────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────
[[ "$1" == "--delete"  ]] && { [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete; do_delete; }
[[ "$1" == "--restore" ]] && { [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore; do_restore_crosh; }

[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

# If launched as installed shell, go straight to shell menu
if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" ]]; then
    shell_main_menu; exit 0
fi

# Setup menu
while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete cshell — are you sure?" "Yes — delete cshell" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — are you sure?" "Yes — restore original crosh" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) echo -e "${DIM}Goodbye.${RST}"; exit 0 ;;
    esac
done
