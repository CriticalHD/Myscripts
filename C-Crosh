pg_repair_sudo() {
    banner
    echo -e "  ${W}── Repair sudo (minioverride) ───────────────────────${N}\n"
    echo -e "  Rebuilds minioverride.so and re-patches ui.conf."
    echo -e "  A reboot is required after this step.\n"
    if confirm_yn "Continue?"; then
        remount_rw
        mkdir -p /usr/local/bin
        rm -f "$OVERRIDE_SO"
        NEEDS_REBOOT=0
        install_minioverride
        # Also update rootfs copy
        [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
        if [[ $NEEDS_REBOOT -eq 1 ]]; then
            if confirm_yn "Reboot now?"; then reboot; fi
        fi
    else
        echo -e "  ${D}Cancelled.${N}"
    fi
    pause_key
}

