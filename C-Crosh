}

pg_ssh_enable() {
    banner
    echo -e "  ${W}── Enable SSH ───────────────────────────────────────${N}\n"
    echo -e "  Starting sshd on port 22...\n"
    # Set chronos password first if not set
    if ! passwd -S chronos 2>/dev/null | grep -q " P "; then
        echo -e "  ${Y}[!] chronos has no password set. Set one first for SSH auth.${N}"
    fi
    /usr/sbin/sshd 2>/dev/null && echo -e "  ${G}[+] sshd started.${N}" \
        || echo -e "  ${R}[!] sshd failed to start.${N}"
    echo -e "  ${D}Connect via: ssh chronos@$(hostname -I | awk '{print $1}')${N}"
    pause_key
}

