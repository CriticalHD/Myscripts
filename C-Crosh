#!/bin/bash
# cshell v2.0 — Custom ChromeOS Shell
# Run: curl -sSL <url> | sudo bash
# Persists across powerwash via rootfs (requires patched rootfs)

SCRIPT_URL="https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/cshell"
SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
UI_CONF="/etc/init/ui.conf"
# Powerwash-persistent copy lives on rootfs (survives wipe)
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
ROOTFS_CROSH_STUB="/usr/bin/crosh"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
VERSION="2.0"

R='\033[0;31m'   # red
G='\033[0;32m'   # green
Y='\033[1;33m'   # yellow
C='\033[0;36m'   # cyan
W='\033[1;37m'   # white
D='\033[2m'      # dim
N='\033[0m'      # reset
V='\033[7m'      # reverse

# ── trap Ctrl+C everywhere so it never spams ^C ──────────────────
trap 'echo -e "\n${D}Interrupted.${N}"; exit 130' INT TERM

remount_rw() {
    mount -o remount,rw /     2>/dev/null || true
    mount -o remount,rw /usr  2>/dev/null || true
    mount -o remount,rw /etc  2>/dev/null || true
}

# Safe read that always reads from /dev/tty
tread() { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}root@$(hostname -s 2>/dev/null || echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}

pause_key() {
    echo -e "\n  ${D}Press any key to go back...${N}"
    tread1 _k
}

confirm_yn() {
    # Usage: confirm_yn "prompt" && do_thing
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a
    [[ "$_a" =~ ^[Yy]$ ]]
}

# ── Arrow-key menu ───────────────────────────────────────────────
# Sets MENU_RESULT to 0-based index, or -1 on quit
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    # Check if we have a real terminal
    if [[ -t 0 && -t 1 ]]; then
        local sel=0
        while true; do
            banner
            echo -e "  ${W}${title}${N}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $sel ]]; then
                    echo -e "  ${V}${C}  ›  ${items[$i]}  ${N}"
                else
                    echo -e "  ${D}     ${items[$i]}${N}"
                fi
            done
            echo -e "\n  ${D}↑↓ navigate   Enter select   Q quit${N}"
            # Read keypress from tty
            local k; IFS= read -rsn1 k </dev/tty 2>/dev/null
            if [[ "$k" == $'\x1b' ]]; then
                local s; read -rsn2 -t 0.1 s </dev/tty 2>/dev/null
                case "$s" in
                    '[A') (( sel > 0 )) && (( sel-- )) ;;
                    '[B') (( sel < count-1 )) && (( sel++ )) ;;
                esac
            elif [[ "$k" == "" ]]; then
                MENU_RESULT=$sel; return
            elif [[ "$k" == "q" || "$k" == "Q" || "$k" == $'\x03' ]]; then
                MENU_RESULT=-1; return
            fi
        done
    else
        # Numbered fallback for piped input
        banner
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do
            echo -e "  ${C}$((i+1)))${N}  ${items[$i]}"
        done
        echo ""
        echo -ne "  ${W}Select [1-${count}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch >= 1 && ch <= count )); then
            MENU_RESULT=$((ch-1))
        else
            MENU_RESULT=-1
        fi
    fi
}

# ── Rootfs check / make writable ────────────────────────────────
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then
        rm -f /usr/bin/.rw_test
        return 0
    fi
    banner
    echo -e "  ${Y}⚠  Rootfs is read-only (verification enabled)${N}\n"
    echo -e "  cshell must disable rootfs verification to install.\n"
    if confirm_yn "Disable rootfs verification now?"; then
        echo -e "\n${Y}[*] Disabling rootfs verification...${N}"
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}[+] Done. Reboot required — then re-run install.${N}\n"
        if confirm_yn "Reboot now?"; then reboot; fi
        exit 0
    else
        echo -e "\n  ${R}[!] Cannot continue without writable rootfs.${N}\n"
        exit 1
    fi
}

# ── Minioverride build ───────────────────────────────────────────
C_SRC='int minijail_no_new_privs(void){return 0;}
int minijail_add_fs_restriction_rx(void){return 0;}
int minijail_add_fs_restriction_advanced_rw(void){return 0;}
int minijail_set_enable_profile_fs_restrictions(void){return 0;}
int minijail_enable_default_fs_restrictions(void){return 0;}'

build_minioverride() {
    echo "$C_SRC" > /tmp/_mo.c
    local ok=0

    if command -v gcc &>/dev/null; then
        gcc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null && ok=1
    fi
    if [[ $ok -eq 0 ]] && command -v tcc &>/dev/null; then
        tcc -shared /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null && ok=1
    fi
    if [[ $ok -eq 0 ]] && command -v cc &>/dev/null; then
        cc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null && ok=1
    fi
    rm -f /tmp/_mo.c

    if [[ $ok -eq 0 ]]; then
        echo -e "${Y}    No compiler — downloading prebuilt minioverride.so...${N}"
        curl -sSL \
          "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
          -o "$OVERRIDE_SO" 2>/dev/null
        [[ -s "$OVERRIDE_SO" ]] && ok=1
    fi

    if [[ $ok -eq 1 ]]; then
        chmod 755 "$OVERRIDE_SO"
        return 0
    fi
    rm -f "$OVERRIDE_SO"
    return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return 1
    if grep -q "minioverride" "$UI_CONF" 2>/dev/null; then
        echo -e "${D}    ui.conf already patched.${N}"
        return 0
    fi
    # Use temp file to avoid file-busy errors
    cp "$UI_CONF" /tmp/_ui.conf.bak
    sed '1s|^|env LD_PRELOAD=/usr/local/bin/minioverride.so\n|' /tmp/_ui.conf.bak > /tmp/_ui.conf.new
    cp /tmp/_ui.conf.new "$UI_CONF"
    rm -f /tmp/_ui.conf.bak /tmp/_ui.conf.new
    echo -e "${G}    Patched ui.conf — reboot required for sudo fix.${N}"
    NEEDS_REBOOT=1
}

install_minioverride() {
    echo -e "${D}    Building minioverride.so (sudo/NO_NEW_PRIVS fix)...${N}"
    if build_minioverride; then
        echo -e "${G}    minioverride.so built.${N}"
        patch_ui_conf
    else
        echo -e "${Y}    [!] minioverride build failed. Sudo may not work until repaired.${N}"
        OVERRIDE_FAILED=1
    fi
}

remove_minioverride() {
    if [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" 2>/dev/null; then
        cp "$UI_CONF" /tmp/_ui.conf.bak
        grep -v "minioverride" /tmp/_ui.conf.bak > /tmp/_ui.conf.new
        cp /tmp/_ui.conf.new "$UI_CONF"
        rm -f /tmp/_ui.conf.bak /tmp/_ui.conf.new
        echo -e "${G}[+] Removed minioverride from ui.conf${N}"
    fi
    rm -f "$OVERRIDE_SO"
    echo -e "${G}[+] Removed minioverride.so${N}"
}

# ── Powerwash-persistence setup ──────────────────────────────────
# Strategy: store cshell on rootfs (/usr/bin/cshell_rootfs) and
# install an upstart job that re-installs to /usr/local after each boot.
# Rootfs survives powerwash; stateful /usr/local does not.
install_persistence() {
    echo -e "${D}    Setting up powerwash persistence...${N}"

    # Copy cshell itself to rootfs path
    cp "$SHELL_PATH" "$ROOTFS_SHELL" 2>/dev/null
    chmod +x "$ROOTFS_SHELL"

    # Write upstart job on rootfs that restores cshell after every boot
    cat > "$INIT_SCRIPT" << 'UPSTART'
# cshell-restore — restores cshell to /usr/local after powerwash
description "cshell post-boot restore"
start on started system-services
task
script
    if [ ! -f /usr/local/bin/cshell ]; then
        mkdir -p /usr/local/bin
        cp /usr/bin/cshell_rootfs /usr/local/bin/cshell
        chmod +x /usr/local/bin/cshell
    fi
    # Restore crosh stub if missing
    if ! grep -q "cshell" /usr/bin/crosh 2>/dev/null; then
        printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > /usr/bin/crosh
        chmod +x /usr/bin/crosh
    fi
    # Restore minioverride if missing
    if [ ! -f /usr/local/bin/minioverride.so ] && [ -f /usr/bin/minioverride.so ]; then
        cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so
        chmod 755 /usr/local/bin/minioverride.so
    fi
end script
UPSTART

    # Also copy minioverride to rootfs for the upstart job to use
    [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null

    echo -e "${G}    Powerwash persistence installed (upstart job + rootfs copy).${N}"
}

remove_persistence() {
    rm -f "$ROOTFS_SHELL" "$INIT_SCRIPT" /usr/bin/minioverride.so
    echo -e "${G}[+] Persistence hooks removed.${N}"
}

# ── INSTALL ──────────────────────────────────────────────────────
do_install() {
    banner
    echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}[!] Must be root.${N}" && exit 1

    echo -e "${D}    Checking rootfs...${N}"
    check_rootfs
    mkdir -p /usr/local/bin

    # Download/copy cshell
    echo -e "${D}    Obtaining cshell script...${N}"
    local got=0
    if curl -sSfL "$SCRIPT_URL" -o "$SHELL_PATH" 2>/dev/null && [[ -s "$SHELL_PATH" ]]; then
        chmod +x "$SHELL_PATH"
        echo -e "${G}    Downloaded to ${SHELL_PATH}${N}"
        got=1
    fi
    if [[ $got -eq 0 ]]; then
        local src="${BASH_SOURCE[0]:-$0}"
        if [[ -f "$src" && "$src" != "/dev/stdin" && "$src" != "bash" ]]; then
            cp "$src" "$SHELL_PATH" && chmod +x "$SHELL_PATH"
            echo -e "${G}    Copied from ${src}${N}"
            got=1
        fi
    fi
    if [[ $got -eq 0 ]]; then
        echo -e "${R}[!] Could not obtain script. Set SCRIPT_URL at top of file.${N}"
        exit 1
    fi

    NEEDS_REBOOT=0
    OVERRIDE_FAILED=0

    install_minioverride
    install_persistence

    # Backup + replace crosh (rm first to avoid text-file-busy)
    if [[ ! -f "$CROSH_BACKUP" ]]; then
        echo -e "${D}    Backing up crosh...${N}"
        cp "$CROSH_PATH" "$CROSH_BACKUP"
        echo -e "${G}    Backed up to ${CROSH_BACKUP}${N}"
    fi
    echo -e "${D}    Writing crosh stub...${N}"
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${G}    Crosh stub installed.${N}"

    echo ""
    echo -e "${G}[+] cshell installed!${N}"

    if [[ $OVERRIDE_FAILED -eq 1 ]]; then
        echo -e "${Y}[!] minioverride failed — use 'Repair sudo' from the shell menu.${N}"
    fi
    if [[ $NEEDS_REBOOT -eq 1 ]]; then
        echo -e "${Y}[!] REBOOT REQUIRED for sudo fix.${N}"
        echo -e "    After reboot, open crosh (Ctrl+Alt+T) to launch cshell.\n"
        if confirm_yn "Reboot now?"; then reboot; fi
    else
        echo -e "    Open crosh (Ctrl+Alt+T) to launch.\n"
    fi

    echo -ne "\n  ${D}Press any key to exit...${N}"
    tread1 _; echo ""
    exit 0
}

# ── DELETE ───────────────────────────────────────────────────────
do_delete() {
    banner
    echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete
    remount_rw
    remove_minioverride
    remove_persistence
    rm -f "$SHELL_PATH"
    echo -e "${G}[+] Removed ${SHELL_PATH}${N}"
    echo -e "${D}    Use 'Restore crosh' to fix crosh if needed.${N}\n"
    echo -ne "  ${D}Press any key to exit...${N}"
    tread1 _; echo ""
    exit 0
}

# ── RESTORE CROSH ────────────────────────────────────────────────
do_restore_crosh() {
    banner
    echo -e "${Y}[*] Restoring crosh to factory...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        rm -f "$CROSH_PATH"
        cp "$CROSH_BACKUP" "$CROSH_PATH"
        chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"
        echo -e "${G}[+] Original crosh restored.${N}"
    else
        echo -e "${R}[!] No backup found at ${CROSH_BACKUP}.${N}"
        echo -e "    If crosh is broken: Esc+Refresh+Power → Recovery Mode"
    fi
    echo -ne "\n  ${D}Press any key to exit...${N}"
    tread1 _; echo ""
    exit 0
}

