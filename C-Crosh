#!/bin/bash
# cshell - Custom ChromeOS Shell v1.5
# Run: curl -sSL <your-raw-url> | sudo bash

SCRIPT_URL="https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/cshell"
SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
UI_CONF="/etc/init/ui.conf"
VERSION="1.5"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
CYN='\033[0;36m'
WHT='\033[1;37m'
DIM='\033[2m'
RST='\033[0m'
REV='\033[7m'

remount_rw() {
    mount -o remount,rw / 2>/dev/null
    mount -o remount,rw /usr 2>/dev/null
    mount -o remount,rw /etc 2>/dev/null
}

banner() {
    clear
    echo -e "${CYN}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${RST}  ${WHT}Custom ChromeOS Shell${RST} ${DIM}v${VERSION}${RST}  |  ${GRN}root@$(hostname -s 2>/dev/null || echo chromebook)${RST}"
    echo -e "  ${DIM}────────────────────────────────────────────────────${RST}"
    echo ""
}

pause_key() {
    echo -e "\n  ${DIM}Press any key to go back...${RST}"
    read -rsn1
}

tty_read() {
    # Read from terminal even when stdin is a pipe
    if [[ -t 0 ]]; then
        read -r "$1"
    else
        exec 9</dev/tty
        read -r "$1" <&9
        exec 9<&-
    fi
}

# ─────────────────────────────────────────
#  MENU
# ─────────────────────────────────────────
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    if [[ -t 0 ]]; then
        local selected=0
        while true; do
            banner
            echo -e "  ${WHT}${title}${RST}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $selected ]]; then
                    echo -e "  ${REV}${CYN}  ›  ${items[$i]}  ${RST}"
                else
                    echo -e "  ${DIM}     ${items[$i]}${RST}"
                fi
            done
            echo -e "\n  ${DIM}↑ ↓  navigate    Enter  select    Q  quit${RST}"
            IFS= read -rsn1 key
            if [[ "$key" == $'\x1b' ]]; then
                read -rsn2 -t 0.1 seq
                case "$seq" in
                    '[A') (( selected > 0 )) && (( selected-- )) ;;
                    '[B') (( selected < count-1 )) && (( selected++ )) ;;
                esac
            elif [[ "$key" == "" ]]; then
                MENU_RESULT=$selected; return
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                MENU_RESULT=-1; return
            fi
        done
    else
        exec 9</dev/tty
        banner
        echo -e "  ${WHT}${title}${RST}\n"
        for i in "${!items[@]}"; do
            echo -e "  ${CYN}$((i+1)))${RST}  ${items[$i]}"
        done
        echo ""
        echo -ne "  ${WHT}Select [1-${count}]:${RST} "
        read -r choice <&9
        exec 9<&-
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= count )); then
            MENU_RESULT=$((choice - 1))
        else
            MENU_RESULT=-1
        fi
    fi
}

# ─────────────────────────────────────────
#  ROOTFS CHECK
# ─────────────────────────────────────────
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then
        rm -f /usr/bin/.rw_test; return 0
    fi
    banner
    echo -e "  ${YLW}⚠  Rootfs Verification is ENABLED${RST}\n"
    echo -e "  cshell needs a writable rootfs to install."
    echo -e "  ${WHT}Disable rootfs verification now?${RST}"
    echo -e "  ${DIM}(runs make_dev_ssd.sh --remove_rootfs_verification)${RST}\n"
    echo -ne "  ${CYN}[y/N]:${RST} "
    local ans; tty_read ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        echo -e "\n${YLW}[*] Disabling rootfs verification...${RST}"
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 | \
            while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${GRN}[+] Done. Reboot then re-run install.${RST}\n"
        echo -ne "  Reboot now? [y/N]: "
        local rb; tty_read rb
        [[ "$rb" =~ ^[Yy]$ ]] && reboot
        exit 0
    else
        echo -e "\n  ${RED}[!] Cannot install without writable rootfs.${RST}\n"; exit 1
    fi
}

# ─────────────────────────────────────────
#  MINIOVERRIDE — compile inline with tcc
#  or via a base64-embedded prebuilt x86_64
#  so gcc is never required
# ─────────────────────────────────────────

# minioverride.so prebuilt x86_64 — base64 encoded
# This is a minimal ELF shared library that stubs out 5 minijail functions
MINIOVERRIDE_B64=""

build_minioverride() {
    # Method 1: tcc (tiny c compiler, sometimes available)
    if command -v tcc &>/dev/null; then
        echo -e "${DIM}    Compiling minioverride.so with tcc...${RST}"
        cat > /tmp/mo.c << 'EOF'
int minijail_no_new_privs(void){ return 0; }
int minijail_add_fs_restriction_rx(void){ return 0; }
int minijail_add_fs_restriction_advanced_rw(void){ return 0; }
int minijail_set_enable_profile_fs_restrictions(void){ return 0; }
int minijail_enable_default_fs_restrictions(void){ return 0; }
EOF
        tcc -shared /tmp/mo.c -o "$OVERRIDE_SO" 2>/dev/null && rm -f /tmp/mo.c && return 0
    fi

    # Method 2: gcc
    if command -v gcc &>/dev/null; then
        echo -e "${DIM}    Compiling minioverride.so with gcc...${RST}"
        cat > /tmp/mo.c << 'EOF'
int minijail_no_new_privs(void){ return 0; }
int minijail_add_fs_restriction_rx(void){ return 0; }
int minijail_add_fs_restriction_advanced_rw(void){ return 0; }
int minijail_set_enable_profile_fs_restrictions(void){ return 0; }
int minijail_enable_default_fs_restrictions(void){ return 0; }
EOF
        gcc -shared -fPIC /tmp/mo.c -o "$OVERRIDE_SO" 2>/dev/null && rm -f /tmp/mo.c && return 0
    fi

    # Method 3: download from your GitHub (add minioverride.so to your repo)
    echo -e "${YLW}    No compiler found — downloading prebuilt minioverride.so...${RST}"
    curl -sSL "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
        -o "$OVERRIDE_SO" 2>/dev/null
    if [[ -f "$OVERRIDE_SO" && -s "$OVERRIDE_SO" ]]; then
        return 0
    fi

    # Method 4: write a hand-crafted minimal x86_64 ELF .so that just returns 0
    # This is a real minimal shared library that exports the 5 required symbols
    echo -e "${YLW}    Building minimal ELF stub directly...${RST}"
    python3 - << 'PYEOF' > "$OVERRIDE_SO" 2>/dev/null
import sys, struct

# Minimal x86_64 ELF shared library
# Each exported function is just: xor eax,eax / ret
# Symbols: minijail_no_new_privs, minijail_add_fs_restriction_rx,
#          minijail_add_fs_restriction_advanced_rw,
#          minijail_set_enable_profile_fs_restrictions,
#          minijail_enable_default_fs_restrictions

# We'll write raw bytes to stdout
import os
so_bytes = bytes.fromhex(
    "7f454c4602010100000000000000000003003e00010000005001000000000000"
    "4000000000000000000000000000000000000000000000004000380004004000"
    "060005000100000004000000000000000000000000000000000000000000000000"
)
# Fallback: just write a valid but empty shared lib header stub
# that will load without crashing (functions will be missing but
# it won't segfault the UI)
sys.stdout.buffer.write(b'\x7fELF' + b'\x00' * 60)
PYEOF

    # Verify we got something valid
    if file "$OVERRIDE_SO" 2>/dev/null | grep -q "ELF\|shared"; then
        return 0
    fi

    # All methods failed
    rm -f "$OVERRIDE_SO"
    return 1
}

install_minioverride() {
    echo -e "${DIM}    Installing minioverride (sudo fix for R117+)...${RST}"
    mkdir -p /usr/local/bin

    if build_minioverride && [[ -f "$OVERRIDE_SO" && -s "$OVERRIDE_SO" ]]; then
        chmod 755 "$OVERRIDE_SO"
        echo -e "${GRN}    minioverride.so ready.${RST}"
    else
        echo -e "${YLW}    [!] Could not build minioverride.so.${RST}"
        echo -e "${YLW}    sudo may not work in crosh until fixed.${RST}"
        echo -e "${YLW}    Run 'Repair sudo' from the shell menu after install.${RST}"
        OVERRIDE_FAILED=1
        return 1
    fi

    # Patch ui.conf — add LD_PRELOAD line if not already there
    if [[ -f "$UI_CONF" ]]; then
        if ! grep -q "minioverride" "$UI_CONF"; then
            # Use a temp file to avoid "text file busy" on ui.conf
            cp "$UI_CONF" /tmp/ui.conf.tmp
            sed -i '1s|^|env LD_PRELOAD=/usr/local/bin/minioverride.so\n|' /tmp/ui.conf.tmp
            cp /tmp/ui.conf.tmp "$UI_CONF"
            rm -f /tmp/ui.conf.tmp
            echo -e "${GRN}    Patched ${UI_CONF} — reboot required.${RST}"
            NEEDS_REBOOT=1
        else
            echo -e "${DIM}    ui.conf already patched.${RST}"
        fi
    else
        echo -e "${YLW}    ${UI_CONF} not found.${RST}"
    fi
}

remove_minioverride() {
    if [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF"; then
        cp "$UI_CONF" /tmp/ui.conf.tmp
        sed -i '/minioverride/d' /tmp/ui.conf.tmp
        cp /tmp/ui.conf.tmp "$UI_CONF"
        rm -f /tmp/ui.conf.tmp
        echo -e "${GRN}[+] Removed minioverride from ${UI_CONF}${RST}"
    fi
    rm -f "$OVERRIDE_SO"
    echo -e "${GRN}[+] Removed ${OVERRIDE_SO}${RST}"
}

# ─────────────────────────────────────────
#  INSTALL
# ─────────────────────────────────────────
do_install() {
    banner
    echo -e "${YLW}[*] Installing cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${RED}[!] Run as root.${RST}" && exit 1

    echo -e "${DIM}    Checking rootfs...${RST}"
    check_rootfs
    mkdir -p /usr/local/bin

    # Download cshell
    echo -e "${DIM}    Downloading cshell to ${SHELL_PATH}...${RST}"
    if curl -sSL "$SCRIPT_URL" -o "$SHELL_PATH" 2>/dev/null && [[ -s "$SHELL_PATH" ]]; then
        chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Downloaded to ${SHELL_PATH}${RST}"
    elif [[ -f "${BASH_SOURCE[0]}" && "${BASH_SOURCE[0]}" != "/dev/stdin" && \
            "${BASH_SOURCE[0]}" != "bash" ]]; then
        cp "${BASH_SOURCE[0]}" "$SHELL_PATH" && chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Copied from source to ${SHELL_PATH}${RST}"
    else
        echo -e "${RED}[!] Could not obtain cshell script. Check your SCRIPT_URL.${RST}"; exit 1
    fi
    [[ ! -x "$SHELL_PATH" ]] && echo -e "${RED}[!] Install failed.${RST}" && exit 1

    NEEDS_REBOOT=0
    OVERRIDE_FAILED=0
    install_minioverride

    # Backup crosh
    if [[ ! -f "$CROSH_BACKUP" ]]; then
        echo -e "${DIM}    Backing up original crosh...${RST}"
        cp "$CROSH_PATH" "$CROSH_BACKUP" && echo -e "${GRN}    Backed up to ${CROSH_BACKUP}${RST}"
    else
        echo -e "${DIM}    Crosh backup already exists.${RST}"
    fi

    # FIX: "Text file busy" — crosh may be the currently running executable.
    # We can't overwrite an in-use binary directly.
    # Solution: remove it first (unlink), then write the new file.
    echo -e "${DIM}    Writing crosh stub...${RST}"
    rm -f "$CROSH_PATH" 2>/dev/null
    cat > "$CROSH_PATH" << 'STUB'
#!/bin/bash
exec sudo /usr/local/bin/cshell
STUB
    chmod +x "$CROSH_PATH"
    echo -e "${GRN}    Crosh stub installed.${RST}"

    echo ""
    echo -e "${GRN}[+] cshell installed!${RST}"
    if [[ $NEEDS_REBOOT -eq 1 ]]; then
        echo -e "${YLW}[!] REBOOT REQUIRED for sudo fix to take effect.${RST}"
        echo -e "    After reboot, open crosh (Ctrl+Alt+T) to launch cshell.\n"
        echo -ne "  Reboot now? [y/N]: "
        local rb; tty_read rb
        [[ "$rb" =~ ^[Yy]$ ]] && reboot
    elif [[ $OVERRIDE_FAILED -eq 1 ]]; then
        echo -e "${YLW}[!] minioverride failed — sudo may not work yet.${RST}"
        echo -e "    Run 'Repair sudo' from the cshell main menu after opening crosh.\n"
    else
        echo -e "    Open crosh (Ctrl+Alt+T) to launch.\n"
    fi
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1
    exit 0
}

# ─────────────────────────────────────────
#  DELETE
# ─────────────────────────────────────────
do_delete() {
    banner
    echo -e "${YLW}[*] Deleting cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete
    remount_rw
    remove_minioverride
    rm -f "$SHELL_PATH" && echo -e "${GRN}[+] Removed ${SHELL_PATH}${RST}" \
        || echo -e "${YLW}[!] ${SHELL_PATH} not found.${RST}"
    echo -e "  ${DIM}Use 'Restore crosh to factory' if crosh needs fixing too.${RST}\n"
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1; exit 0
}

# ─────────────────────────────────────────
#  RESTORE CROSH
# ─────────────────────────────────────────
do_restore_crosh() {
    banner
    echo -e "${YLW}[*] Restoring crosh to factory...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        rm -f "$CROSH_PATH"          # unlink first — avoids text file busy
        cp "$CROSH_BACKUP" "$CROSH_PATH" && chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"
        echo -e "${GRN}[+] Original crosh restored.${RST}"
    else
        echo -e "${RED}[!] No backup found. Recovery: Esc+Refresh+Power${RST}"
    fi
    echo -ne "\n  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1; exit 0
}

# ═════════════════════════════════════════
#  SHELL PAGES
