pg_sysinfo() {
    banner
    echo -e "  ${W}── System Info ──────────────────────────────────────${N}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local ver=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local chan=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mt=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mf=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mu=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    local st=$(awk '/SwapTotal/{printf "%.0f MB",$2/1024}' /proc/meminfo)
    echo -e "  ${C}Board:${N}         ${board:-unknown}"
    echo -e "  ${C}Version:${N}       ${ver:-?}  (${chan:-?})"
    echo -e "  ${C}Build:${N}         ${build:-?}"
    echo -e "  ${C}Kernel:${N}        $(uname -r) [$(uname -m)]"
    echo -e "  ${C}CPU:${N}           ${cpu:-?} (${cores} cores)"
    echo -e "  ${C}RAM:${N}           ${mu} used / ${mf} free / ${mt} total"
    echo -e "  ${C}Swap:${N}          ${st}"
    echo -e "  ${C}Uptime:${N}        $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${C}Hostname:${N}      $(hostname)"
    echo -e "  ${C}Running as:${N}    $(whoami) uid=$(id -u)"
    echo -e "  ${C}minioverride:${N}  $([[ -f $OVERRIDE_SO ]] && echo "${G}installed${N}" || echo "${Y}missing${N}")"
    echo -e "  ${C}ui.conf patch:${N} $(grep -q minioverride $UI_CONF 2>/dev/null && echo "${G}active${N}" || echo "${Y}inactive${N}")"
    echo -e "  ${C}persistence:${N}   $([[ -f $INIT_SCRIPT ]] && echo "${G}installed${N}" || echo "${Y}not installed${N}")"
    pause_key
}

pg_battery() {
    banner
    echo -e "  ${W}── Battery Health ───────────────────────────────────${N}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -n "$bat" ]]; then
        local status=$(cat "$bat/status" 2>/dev/null || echo "?")
        local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
        local efull=$(cat "$bat/energy_full" 2>/dev/null)
        local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
        local enow=$(cat "$bat/energy_now" 2>/dev/null)
        local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
        local current=$(cat "$bat/current_now" 2>/dev/null)
        local cycles=$(cat "$bat/cycle_count" 2>/dev/null)
        local mfr=$(cat "$bat/manufacturer" 2>/dev/null)
        local model=$(cat "$bat/model_name" 2>/dev/null)
        local tech=$(cat "$bat/technology" 2>/dev/null)
        echo -e "  ${C}Status:${N}       $status"
        echo -e "  ${C}Charge:${N}       ${cap}%"
        [[ -n "$mfr" ]]    && echo -e "  ${C}Manufacturer:${N} $mfr"
        [[ -n "$model" ]]  && echo -e "  ${C}Model:${N}        $model"
        [[ -n "$tech" ]]   && echo -e "  ${C}Technology:${N}   $tech"
        [[ -n "$cycles" && "$cycles" != "0" ]] && echo -e "  ${C}Cycles:${N}       $cycles"
        if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
            local h=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
            local hc=$G
            awk "BEGIN{exit !($h < 80)}" && hc=$Y
            awk "BEGIN{exit !($h < 60)}" && hc=$R
            echo -e "  ${C}Health:${N}       ${hc}${h}%${N}"
            [[ -n "$enow" ]] && echo -e "  ${C}Current:${N}      $(awk "BEGIN{printf \"%.2f Wh\",$enow/1000000}")"
            echo -e "  ${C}Full cap:${N}     $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
            echo -e "  ${C}Design cap:${N}   $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
        fi
        [[ -n "$voltage" ]] && echo -e "  ${C}Voltage:${N}      $(awk "BEGIN{printf \"%.3f V\",$voltage/1000000}")"
        [[ -n "$current" ]] && echo -e "  ${C}Draw:${N}         $(awk "BEGIN{printf \"%.0f mA\",$current/1000}")"
    fi
    if command -v ectool &>/dev/null; then
        echo -e "\n  ${D}ectool:${N}"
        ectool batterystatus 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

pg_sensors() {
    banner
    echo -e "  ${W}── Sensors / Temperature ────────────────────────────${N}\n"
    local found=0
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f" | grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null || echo "?")
        local raw=$(cat "$f" 2>/dev/null || echo "0")
        local tc=$G
        (( raw > 70000 )) && tc=$Y
        (( raw > 85000 )) && tc=$R
        printf "  ${C}%-10s${N} %-24s ${tc}%.1f°C${N}\n" "$zone" "($type)" "$(awk "BEGIN{print $raw/1000}")"
        found=1
    done
    [[ $found -eq 0 ]] && echo "  No thermal zones found."
    if command -v ectool &>/dev/null; then
        echo -e "\n  ${D}Fan RPM:${N}"
        ectool pwmgetfanrpm 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}EC temps:${N}"
        ectool temps all 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

pg_devmode() {
    banner
    echo -e "  ${W}── Dev Mode / Boot Flags ────────────────────────────${N}\n"
    if command -v crossystem &>/dev/null; then
        echo -e "  ${W}Key flags:${N}"
        for key in devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur; do
            local val=$(crossystem $key 2>/dev/null || echo "n/a")
            local vc=$D
            [[ "$val" == "1" ]] && vc=$G
            printf "  ${C}%-32s${N} ${vc}%s${N}\n" "$key" "$val"
        done
        echo -e "\n  ${W}Firmware:${N}"
        for key in fwid ro_fwid mainfw_act mainfw_type; do
            printf "  ${C}%-32s${N} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
        echo -e "\n  ${D}[B] Full dump  [any] Back${N}"
        local k; tread1 k
        if [[ "$k" == "b" || "$k" == "B" ]]; then
            banner
            echo -e "  ${W}── Full crossystem ──────────────────────────────────${N}\n"
            crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
            pause_key
        fi
    else
        echo "  crossystem not available."
        pause_key
    fi
}

pg_gbb() {
    banner
    echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"
    if command -v futility &>/dev/null; then
        echo -e "  ${D}Current GBB flags:${N}"
        futility gbb --get --flags 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  futility not found."
    fi
    echo -e "\n  ${W}Reference:${N}"
    echo -e "  ${C}0x0001${N}  DEV_SCREEN_SHORT_DELAY"
    echo -e "  ${C}0x0002${N}  LOAD_OPTION_READONLY"
    echo -e "  ${C}0x0008${N}  FORCE_DEV_SWITCH_ON (skip dev mode beep)"
    echo -e "  ${C}0x0010${N}  DISABLE_DEV_REQUEST (can't leave dev mode)"
    echo -e "  ${C}0x0020${N}  DISABLE_FW_ROLLBACK_CHECK"
    echo -e "  ${C}0x8000${N}  CCD_UNLOCK"
    echo -e "  ${C}0x8090${N}  Common murkmod/fakemurk value"
    pause_key
}

pg_vpd() {
    banner
    echo -e "  ${W}── VPD (Vital Product Data) ─────────────────────────${N}\n"
    if command -v vpd &>/dev/null; then
        echo -e "  ${W}RO VPD:${N}"
        vpd -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${W}RW VPD:${N}"
        vpd -i RW_VPD -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  vpd tool not available."
    fi
    pause_key
}

pg_net() {
    banner
    echo -e "  ${W}── Network ──────────────────────────────────────────${N}\n"
    echo -e "  ${W}Interfaces:${N}"
    ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Routes:${N}"
    ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}DNS:${N}"
    grep "^nameserver" /etc/resolv.conf 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[P] Ping 8.8.8.8  [T] Traceroute  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        p|P)
            banner
            echo -e "  ${Y}Pinging 8.8.8.8...${N}\n"
            ping -c 4 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done
            pause_key ;;
        t|T)
            banner
            echo -e "  ${Y}Traceroute to 8.8.8.8...${N}\n"
            traceroute 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done
            pause_key ;;
    esac
}

pg_wifi() {
    banner
    echo -e "  ${W}── WiFi ─────────────────────────────────────────────${N}\n"
    if command -v iw &>/dev/null; then
        local iface=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}' | head -1)
        echo -e "  ${W}Interface: ${iface:-unknown}${N}\n"
        if [[ -n "$iface" ]]; then
            echo -e "  ${D}Connected:${N}"
            iw dev "$iface" link 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
            echo -e "\n  ${D}Station info:${N}"
            iw dev "$iface" station dump 2>/dev/null | grep "signal\|tx bitrate\|rx bitrate\|inactive" \
                | while IFS= read -r l; do echo "  $l"; done
        fi
    else
        echo "  iw not available."
    fi
    # flimflam/shill may have more info
    if command -v connmanctl &>/dev/null; then
        echo -e "\n  ${D}connmanctl services:${N}"
        connmanctl services 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

pg_storage() {
    banner
    echo -e "  ${W}── Storage ──────────────────────────────────────────${N}\n"
    echo -e "  ${W}Filesystem usage:${N}"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs\|^udev\|^overlay\|^shm\|^none" \
        | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Block devices:${N}"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT 2>/dev/null \
        | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Stateful partition:${N}"
    df -h /mnt/stateful_partition 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_memory() {
    banner
    echo -e "  ${W}── Memory ───────────────────────────────────────────${N}\n"
    cat /proc/meminfo 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_procs() {
    banner
    echo -e "  ${W}── Processes ────────────────────────────────────────${N}\n"
    echo -e "  ${D}[C] CPU sort  [M] Mem sort  — currently showing CPU${N}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[M] Sort by mem  [K] Kill PID  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        m|M)
            banner
            echo -e "  ${W}── Processes (Memory) ───────────────────────────────${N}\n"
            ps aux --sort=-%mem 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done
            pause_key ;;
        k|K)
            echo -ne "\n  ${Y}PID to kill:${N} "
            local pid; tread pid
            if [[ "$pid" =~ ^[0-9]+$ ]]; then
                kill -9 "$pid" 2>/dev/null && echo -e "  ${G}Killed PID $pid${N}" \
                    || echo -e "  ${R}Failed to kill $pid${N}"
            fi
            pause_key ;;
    esac
}

pg_usb() {
    banner
    echo -e "  ${W}── USB Devices ──────────────────────────────────────${N}\n"
    if command -v lsusb &>/dev/null; then
        lsusb 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        for dev in /sys/bus/usb/devices/*/; do
            local v=$(cat "$dev/idVendor" 2>/dev/null)
            local p=$(cat "$dev/idProduct" 2>/dev/null)
            local n=$(cat "$dev/product" 2>/dev/null || echo "Unknown")
            [[ -n "$v" ]] && echo -e "  ${C}${v}:${p}${N}  $n"
        done
    fi
    pause_key
}

pg_firewall() {
    banner
    echo -e "  ${W}── Firewall / iptables ──────────────────────────────${N}\n"
    iptables -L -n -v 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_logs() {
    banner
    echo -e "  ${W}── System Logs (last 40 lines) ──────────────────────${N}\n"
    tail -40 /var/log/messages 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || { journalctl -n 40 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

pg_cros_logs() {
    banner
    echo -e "  ${W}── ChromeOS Logs ────────────────────────────────────${N}\n"
    echo -e "  ${D}update_engine (last 20):${N}"
    tail -20 /var/log/update_engine.log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}Chrome (last 15):${N}"
    local cf=$(ls -t /var/log/chrome/*.log 2>/dev/null | head -1)
    [[ -n "$cf" ]] && tail -15 "$cf" | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}power_manager (last 10):${N}"
    tail -10 /var/log/power_manager/power_log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_extensions() {
    banner
    echo -e "  ${W}── Chrome Extensions ────────────────────────────────${N}\n"
    local dir="/home/chronos/user/Extensions"
    [[ ! -d "$dir" ]] && dir=$(find /home/chronos -name "Extensions" -type d 2>/dev/null | head -1)
    if [[ -z "$dir" || ! -d "$dir" ]]; then
        echo "  Extensions directory not found."
        pause_key; return
    fi
    local n=0
    printf "  ${W}%-26s %-40s %s${N}\n" "ID" "Name" "Ver"
    echo "  $(printf '%0.s─' {1..68})"
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | sort -V | tail -1)
        local name="?" ver="?"
        if [[ -n "$mf" ]]; then
            name=$(python3 -c "import json; d=json.load(open('$mf')); print(d.get('name','?')[:38])" \
                2>/dev/null || grep '"name"' "$mf" 2>/dev/null | head -1 \
                    | sed 's/.*"\(.*\)".*/\1/' | cut -c1-38)
            ver=$(python3 -c "import json; d=json.load(open('$mf')); print(d.get('version','?'))" \
                2>/dev/null || grep '"version"' "$mf" 2>/dev/null | head -1 \
                    | sed 's/.*"\(.*\)".*/\1/')
        fi
        printf "  ${D}%-26s${N} %-40s ${D}%s${N}\n" "${id:0:26}" "${name:0:38}" "$ver"
        ((n++))
    done
    echo -e "\n  ${D}${n} extension(s)${N}"
    pause_key
}

pg_cronos_passwd() {
    banner
    echo -e "  ${W}── Change chronos Password ──────────────────────────${N}\n"
    echo -e "  This sets the chronos user password."
