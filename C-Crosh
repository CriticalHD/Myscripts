#!/bin/bash
# cshell - Custom ChromeOS Shell
# Installs itself as a crosh replacement with root access
# Usage: curl -sSL <url> | sudo bash

# ─────────────────────────────────────────
#  INSTALLER (runs when piped to bash)
# ─────────────────────────────────────────

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"

install_cshell() {
    echo "[*] Installing cshell..."

    # Remount rootfs as rw if needed
    if ! touch /usr/bin/.rw_test 2>/dev/null; then
        echo "[*] Remounting rootfs as read-write..."
        mount -o remount,rw / 2>/dev/null || {
            echo "[!] Could not remount rootfs. Try running K-Patch first."
            exit 1
        }
    else
        rm -f /usr/bin/.rw_test
    fi

    # Copy this script to a permanent location
    cp "$0" "$SHELL_PATH" 2>/dev/null || curl -sSL "$SCRIPT_URL" -o "$SHELL_PATH"
    chmod +x "$SHELL_PATH"

    # Backup real crosh if not already backed up
    if [ ! -f "$CROSH_BACKUP" ]; then
        echo "[*] Backing up original crosh to $CROSH_BACKUP..."
        cp "$CROSH_PATH" "$CROSH_BACKUP"
    fi

    # Replace crosh with our launcher stub
    cat > "$CROSH_PATH" << 'EOF'
#!/bin/bash
# cshell launcher stub - replaces crosh
exec sudo /usr/local/bin/cshell "$@"
EOF
    chmod +x "$CROSH_PATH"

    echo "[+] cshell installed! Open crosh (Ctrl+Alt+T) to launch."
    echo "[i] To uninstall: cshell --uninstall"
}

uninstall_cshell() {
    echo "[*] Uninstalling cshell..."
    mount -o remount,rw / 2>/dev/null
    if [ -f "$CROSH_BACKUP" ]; then
        cp "$CROSH_BACKUP" "$CROSH_PATH"
        echo "[+] Original crosh restored."
    fi
    rm -f "$SHELL_PATH"
    echo "[+] Done."
}

# If called with --uninstall flag
if [[ "$1" == "--uninstall" ]]; then
    uninstall_cshell
    exit 0
fi

# If not running as root or not invoked as the shell itself, run installer
if [[ "$0" != "$SHELL_PATH" ]] && [[ "$(id -u)" -eq 0 ]]; then
    install_cshell
    exit 0
fi

# ─────────────────────────────────────────
#  SHELL RUNTIME (runs when launched)
# ─────────────────────────────────────────

# Escalate to root if not already
if [[ "$(id -u)" -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

# Colors
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
CYN='\033[0;36m'
MAG='\033[0;35m'
WHT='\033[1;37m'
DIM='\033[2m'
RST='\033[0m'

VERSION="1.0"
HOSTNAME_SHORT=$(hostname -s 2>/dev/null || echo "chromebook")
HISTORY_FILE="/var/log/.cshell_history"
touch "$HISTORY_FILE" 2>/dev/null
export HISTFILE="$HISTORY_FILE"

# ── Banner ──────────────────────────────
print_banner() {
    clear
    echo -e "${CYN}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${RST}"
    echo -e "  ${WHT}Custom ChromeOS Shell${RST} ${DIM}v${VERSION}${RST}  |  ${GRN}root@${HOSTNAME_SHORT}${RST}"
    echo -e "  ${DIM}Type ${WHT}help${DIM} for commands. Type ${WHT}bash${DIM} for raw root shell.${RST}"
    echo -e "  ${DIM}────────────────────────────────────────────────────${RST}"
    echo ""
}

# ── Help Menu ────────────────────────────
cmd_help() {
    echo -e "\n${WHT}  ┌─ Built-in Commands ──────────────────────────────┐${RST}"
    echo -e "  ${CYN}bash${RST}          Drop into full root bash shell"
    echo -e "  ${CYN}sysinfo${RST}       Show system info (board, CPU, RAM, battery)"
    echo -e "  ${CYN}battery${RST}       Detailed battery health report"
    echo -e "  ${CYN}kpatch${RST}        Run Kernel Patcher"
    echo -e "  ${CYN}saub${RST}          Server Auto Update Blocker"
    echo -e "  ${CYN}rpatch${RST}        Run Rollback Patcher"
    echo -e "  ${CYN}rootfs rw${RST}     Remount rootfs read-write"
    echo -e "  ${CYN}rootfs ro${RST}     Remount rootfs read-only"
    echo -e "  ${CYN}ext list${RST}      List installed Chrome extensions"
    echo -e "  ${CYN}net${RST}           Show network interfaces and IPs"
    echo -e "  ${CYN}wipe logs${RST}     Clear system logs"
    echo -e "  ${CYN}storage${RST}       Show disk usage"
    echo -e "  ${CYN}procs${RST}         Show top processes"
    echo -e "  ${CYN}devmode${RST}       Check dev mode / boot flags status"
    echo -e "  ${CYN}update block${RST}  Block ChromeOS auto-updates (until reboot)"
    echo -e "  ${CYN}update allow${RST}  Re-allow ChromeOS auto-updates"
    echo -e "  ${CYN}reboot${RST}        Reboot the system"
    echo -e "  ${CYN}poweroff${RST}      Shut down"
    echo -e "  ${CYN}uninstall${RST}     Remove cshell and restore crosh"
    echo -e "  ${CYN}clear${RST}         Clear the screen"
    echo -e "  ${CYN}exit / quit${RST}   Exit cshell"
    echo -e "${WHT}  └──────────────────────────────────────────────────┘${RST}\n"
}

# ── Sysinfo ──────────────────────────────
cmd_sysinfo() {
    echo -e "\n${WHT}  ── System Info ─────────────────────────────────────${RST}"
    local board=$(cat /etc/lsb-release 2>/dev/null | grep CHROMEOS_RELEASE_BOARD | cut -d= -f2)
    local version=$(cat /etc/lsb-release 2>/dev/null | grep CHROMEOS_RELEASE_VERSION | cut -d= -f2)
    local channel=$(cat /etc/lsb-release 2>/dev/null | grep CHROMEOS_RELEASE_TRACK | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local mem_total=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%.1f GB", $2/1024/1024}')
    local mem_free=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{printf "%.1f GB", $2/1024/1024}')
    local uptime=$(uptime -p 2>/dev/null || uptime)
    local kern=$(uname -r)

    echo -e "  ${CYN}Board:${RST}    ${board:-unknown}"
    echo -e "  ${CYN}Version:${RST}  ${version:-unknown}  (${channel:-unknown})"
    echo -e "  ${CYN}Kernel:${RST}   ${kern}"
    echo -e "  ${CYN}CPU:${RST}      ${cpu:-unknown}"
    echo -e "  ${CYN}RAM:${RST}      ${mem_free} free / ${mem_total} total"
    echo -e "  ${CYN}Uptime:${RST}   ${uptime}"
    echo -e "  ${CYN}User:${RST}     $(whoami) (uid=$(id -u))"
    echo ""
}

# ── Battery ──────────────────────────────
cmd_battery() {
    echo -e "\n${WHT}  ── Battery Health ──────────────────────────────────${RST}"
    local bat_path=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [ -d "$p" ] && bat_path="$p" && break
    done

    if [ -z "$bat_path" ]; then
        # Try ectool as fallback
        if command -v ectool &>/dev/null; then
            ectool batterystatus 2>/dev/null || echo "  No battery info available."
        else
            echo "  No battery found."
        fi
        echo ""
        return
    fi

    local status=$(cat "$bat_path/status" 2>/dev/null || echo "unknown")
    local capacity=$(cat "$bat_path/capacity" 2>/dev/null || echo "?")
    local energy_now=$(cat "$bat_path/energy_now" 2>/dev/null)
    local energy_full=$(cat "$bat_path/energy_full" 2>/dev/null)
    local energy_design=$(cat "$bat_path/energy_full_design" 2>/dev/null)
    local voltage=$(cat "$bat_path/voltage_now" 2>/dev/null)

    echo -e "  ${CYN}Status:${RST}     $status"
    echo -e "  ${CYN}Charge:${RST}     ${capacity}%"

    if [ -n "$energy_full" ] && [ -n "$energy_design" ] && [ "$energy_design" -gt 0 ]; then
        local health=$(awk "BEGIN {printf \"%.1f\", ($energy_full/$energy_design)*100}")
        echo -e "  ${CYN}Health:${RST}     ${health}% of original capacity"
        echo -e "  ${CYN}Full cap:${RST}   $(awk "BEGIN {printf \"%.2f Wh\", $energy_full/1000000}")"
        echo -e "  ${CYN}Design:${RST}     $(awk "BEGIN {printf \"%.2f Wh\", $energy_design/1000000}")"
    fi

    [ -n "$voltage" ] && echo -e "  ${CYN}Voltage:${RST}    $(awk "BEGIN {printf \"%.2f V\", $voltage/1000000}")"
    echo ""
}

# ── Devmode status ───────────────────────
cmd_devmode() {
    echo -e "\n${WHT}  ── Dev Mode / Boot Flags ───────────────────────────${RST}"
    if command -v crossystem &>/dev/null; then
        local devboot=$(crossystem dev_boot_usb 2>/dev/null)
        local devsigned=$(crossystem dev_boot_signed_only 2>/dev/null)
        local devmode=$(crossystem devsw_boot 2>/dev/null)
        local wpsw=$(crossystem wpsw_cur 2>/dev/null)
        local fwid=$(crossystem fwid 2>/dev/null)
        echo -e "  ${CYN}Dev mode active:${RST}    ${devmode:-unknown}"
        echo -e "  ${CYN}USB boot enabled:${RST}   ${devboot:-unknown}"
        echo -e "  ${CYN}Signed-only boot:${RST}   ${devsigned:-unknown}"
        echo -e "  ${CYN}Write protect:${RST}      ${wpsw:-unknown}"
        echo -e "  ${CYN}Firmware ID:${RST}        ${fwid:-unknown}"
    else
        echo "  crossystem not available."
    fi
    echo ""
}

# ── Network ──────────────────────────────
cmd_net() {
    echo -e "\n${WHT}  ── Network ─────────────────────────────────────────${RST}"
    ip -br addr show 2>/dev/null | while read line; do
        echo "  $line"
    done
    echo ""
    echo -e "  ${DIM}Default route:${RST}"
    ip route show default 2>/dev/null | while read line; do
        echo "  $line"
    done
    echo ""
}

# ── Extensions ───────────────────────────
cmd_ext_list() {
    echo -e "\n${WHT}  ── Installed Extensions ────────────────────────────${RST}"
    local ext_dir="/home/chronos/user/Extensions"
    if [ ! -d "$ext_dir" ]; then
        echo "  Extensions directory not found at $ext_dir"
        echo ""
        return
    fi
    local count=0
    for ext_id in "$ext_dir"/*/; do
        local id=$(basename "$ext_id")
        # Try to get name from manifest
        local manifest=$(find "$ext_id" -name "manifest.json" 2>/dev/null | head -1)
        local name="unknown"
        if [ -n "$manifest" ]; then
            name=$(grep '"name"' "$manifest" 2>/dev/null | head -1 | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | head -c 40)
        fi
        echo -e "  ${DIM}${id:0:20}${RST}  ${name}"
        ((count++))
    done
    echo -e "\n  ${DIM}${count} extension(s) found${RST}\n"
}

# ── Storage ──────────────────────────────
cmd_storage() {
    echo -e "\n${WHT}  ── Storage ─────────────────────────────────────────${RST}"
    df -h 2>/dev/null | grep -v tmpfs | grep -v devtmpfs | while read line; do
        echo "  $line"
    done
    echo ""
}

# ── Processes ────────────────────────────
cmd_procs() {
    echo -e "\n${WHT}  ── Top Processes ───────────────────────────────────${RST}"
    ps aux --sort=-%cpu 2>/dev/null | head -12 | while read line; do
        echo "  $line"
    done
    echo ""
}

# ── Wipe Logs ────────────────────────────
cmd_wipe_logs() {
    echo -e "${YLW}[!] Clearing system logs...${RST}"
    for f in /var/log/*.log /var/log/messages /var/log/syslog; do
        [ -f "$f" ] && > "$f" && echo "  cleared: $f"
    done
    journalctl --rotate --vacuum-time=1s 2>/dev/null
    echo -e "${GRN}[+] Done.${RST}\n"
}

# ── Rootfs remount ───────────────────────
cmd_rootfs() {
    case "$1" in
        rw) mount -o remount,rw / && echo -e "${GRN}[+] Rootfs remounted read-write.${RST}" ;;
        ro) mount -o remount,ro / && echo -e "${GRN}[+] Rootfs remounted read-only.${RST}" ;;
        *)  echo "  Usage: rootfs rw | ro" ;;
    esac
    echo ""
}

# ── Update blocking ──────────────────────
cmd_update() {
    case "$1" in
        block)
            # Stop update-engine service
            if command -v stop &>/dev/null; then
                stop update-engine 2>/dev/null && echo -e "${GRN}[+] update-engine stopped (upstart).${RST}" || true
            fi
            systemctl stop update-engine 2>/dev/null && echo -e "${GRN}[+] update-engine stopped (systemd).${RST}" || true
            # Also kill any running instances
            pkill -f update_engine 2>/dev/null || true
            echo -e "${YLW}[!] Updates blocked until next reboot.${RST}\n"
            ;;
        allow)
            if command -v start &>/dev/null; then
                start update-engine 2>/dev/null || true
            fi
            systemctl start update-engine 2>/dev/null || true
            echo -e "${GRN}[+] Update engine re-enabled.${RST}\n"
            ;;
        *)
            echo "  Usage: update block | allow"
            echo ""
            ;;
    esac
}

# ── Script runners ───────────────────────
cmd_kpatch() {
    echo -e "${YLW}[*] Running K-Patch...${RST}"
    bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/K-Patch)
}

cmd_saub() {
    echo -e "${YLW}[*] Running SAUB...${RST}"
    bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/SAUB)
}

cmd_rpatch() {
    echo -e "${YLW}[*] Running R-Patch...${RST}"
    bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/R-Patch)
}

# ── Prompt ───────────────────────────────
get_prompt() {
    local dir=$(pwd | sed "s|/home/chronos/user|~|")
    echo -e "${GRN}root${RST}${DIM}@${RST}${CYN}${HOSTNAME_SHORT}${RST}:${YLW}${dir}${RST}${WHT}#${RST} "
}

# ─────────────────────────────────────────
#  MAIN REPL LOOP
# ─────────────────────────────────────────
print_banner

# Enable readline history
set -o history
HISTSIZE=500

while true; do
    # Read input with prompt
    IFS= read -r -e -p "$(get_prompt)" input
    [ $? -ne 0 ] && echo "" && break  # handle Ctrl+D

    # Skip empty
    [[ -z "${input// }" ]] && continue

    # Add to history
    history -s "$input"

    # Parse command
    read -ra parts <<< "$input"
    cmd="${parts[0]}"
    arg1="${parts[1]:-}"
    arg2="${parts[2]:-}"

    case "$cmd" in
        help|h|\?)         cmd_help ;;
        sysinfo|info)      cmd_sysinfo ;;
        battery|bat)       cmd_battery ;;
        devmode|dev)       cmd_devmode ;;
        net|network)       cmd_net ;;
        storage|disk)      cmd_storage ;;
        procs|ps|top)      cmd_procs ;;
        ext)               cmd_ext_list ;;
        rootfs)            cmd_rootfs "$arg1" ;;
        update)            cmd_update "$arg1" ;;
        "wipe")            [[ "$arg1" == "logs" ]] && cmd_wipe_logs || echo "  Usage: wipe logs" ;;
        kpatch)            cmd_kpatch ;;
        saub)              cmd_saub ;;
        rpatch)            cmd_rpatch ;;
        bash|sh|shell)     echo -e "${YLW}[*] Dropping to root bash. Type 'exit' to return.${RST}\n"
                           bash --login
                           echo -e "\n${CYN}[*] Back in cshell.${RST}\n" ;;
        cd)                cd "${arg1:-$HOME}" 2>/dev/null || echo "  No such directory." ;;
        clear|cls)         print_banner ;;
        reboot)            echo -e "${YLW}[*] Rebooting...${RST}" && reboot ;;
        poweroff|shutdown) echo -e "${YLW}[*] Shutting down...${RST}" && poweroff ;;
        uninstall)         uninstall_cshell; exit 0 ;;
        exit|quit|q)       echo -e "${DIM}Goodbye.${RST}"; break ;;
        "")                ;;
        *)
            # Try running as a shell command
            if command -v "$cmd" &>/dev/null || [[ "$cmd" == /* ]] || [[ "$cmd" == ./* ]]; then
                eval "$input"
            else
                echo -e "  ${RED}Unknown command:${RST} $cmd  ${DIM}(type 'help' for list, or 'bash' for full shell)${RST}"
            fi
            ;;
    esac
done
