#!/bin/bash
# cshell - Custom ChromeOS Shell v1.3
# Fixes crosh root access via SSH key bypass (NO_NEW_PRIVS workaround)
# Run: curl -sSL <your-raw-url> | sudo bash
#  OR: sudo bash <(curl -sSL <your-raw-url>)

SCRIPT_URL="https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/cshell"
SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
SSH_KEY_PATH="/usr/local/cshell_key"
AUTH_KEYS="/home/chronos/.ssh/authorized_keys"
VERSION="1.3"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
CYN='\033[0;36m'
WHT='\033[1;37m'
DIM='\033[2m'
RST='\033[0m'
REV='\033[7m'

# ─────────────────────────────────────────
remount_rw() {
    mount -o remount,rw / 2>/dev/null
    mount -o remount,rw /usr 2>/dev/null
}

banner() {
    clear
    echo -e "${CYN}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${RST}  ${WHT}Custom ChromeOS Shell${RST} ${DIM}v${VERSION}${RST}  |  ${GRN}root@$(hostname -s 2>/dev/null || echo chromebook)${RST}"
    echo -e "  ${DIM}────────────────────────────────────────────────────${RST}"
    echo ""
}

pause_key() {
    echo -e "\n  ${DIM}Press any key to go back...${RST}"
    read -rsn1
}

# ─────────────────────────────────────────
#  MENU — works both piped AND interactive
#  If stdin is not a tty (piped), falls back
#  to numbered text selection
# ─────────────────────────────────────────
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    # Arrow-key menu only works when stdin is a terminal
    if [[ -t 0 ]]; then
        local selected=0
        while true; do
            banner
            echo -e "  ${WHT}${title}${RST}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $selected ]]; then
                    echo -e "  ${REV}${CYN}  ›  ${items[$i]}  ${RST}"
                else
                    echo -e "  ${DIM}     ${items[$i]}${RST}"
                fi
            done
            echo -e "\n  ${DIM}↑ ↓  navigate    Enter  select    Q  quit${RST}"
            IFS= read -rsn1 key
            if [[ "$key" == $'\x1b' ]]; then
                read -rsn2 -t 0.1 seq
                case "$seq" in
                    '[A') (( selected > 0 )) && (( selected-- )) ;;
                    '[B') (( selected < count-1 )) && (( selected++ )) ;;
                esac
            elif [[ "$key" == "" ]]; then
                MENU_RESULT=$selected; return
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                MENU_RESULT=-1; return
            fi
        done
    else
        # Fallback: numbered text menu for piped mode
        # Re-open /dev/tty so we can read from the terminal even when piped
        exec 3</dev/tty
        banner
        echo -e "  ${WHT}${title}${RST}\n"
        for i in "${!items[@]}"; do
            echo -e "  ${CYN}$((i+1)))${RST}  ${items[$i]}"
        done
        echo ""
        echo -ne "  ${WHT}Select [1-${count}]:${RST} "
        read -r choice <&3
        exec 3<&-
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= count )); then
            MENU_RESULT=$((choice - 1))
        else
            MENU_RESULT=-1
        fi
    fi
}

# ─────────────────────────────────────────
#  ROOTFS CHECK
# ─────────────────────────────────────────
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then
        rm -f /usr/bin/.rw_test
        return 0
    fi
    banner
    echo -e "  ${YLW}⚠  Rootfs Verification is ENABLED${RST}\n"
    echo -e "  cshell needs a writable rootfs to install."
    echo -e "  ${WHT}Disable rootfs verification now?${RST}"
    echo -e "  ${DIM}(runs make_dev_ssd.sh --remove_rootfs_verification then reboots)${RST}\n"

    local tty_fd
    if [[ ! -t 0 ]]; then exec 3</dev/tty; tty_fd=3; else tty_fd=0; fi
    echo -ne "  ${CYN}[y/N]:${RST} "
    read -r confirm <&$tty_fd
    [[ $tty_fd -eq 3 ]] && exec 3<&-

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "\n${YLW}[*] Disabling rootfs verification...${RST}"
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 | \
            while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${GRN}[+] Done. Reboot required.${RST}"
        echo -e "${YLW}[*] After reboot, re-run the install command.${RST}\n"
        echo -ne "  Reboot now? [y/N]: "
        read -r rb
        [[ "$rb" =~ ^[Yy]$ ]] && reboot
        exit 0
    else
        echo -e "\n  ${RED}[!] Cannot install without writable rootfs. Exiting.${RST}\n"
        exit 1
    fi
}

# ─────────────────────────────────────────
#  SSH KEY SETUP
#  This is the core fix for NO_NEW_PRIVS.
#  We generate a key for chronos and authorize
#  it, so the crosh stub can SSH as chronos
#  then sudo without hitting the privs block.
# ─────────────────────────────────────────
setup_ssh_key() {
    echo -e "${DIM}    Setting up SSH key for crosh root access...${RST}"

    # Start sshd if not running
    if ! pgrep -x sshd >/dev/null 2>&1; then
        /usr/sbin/sshd 2>/dev/null || true
        sleep 1
    fi

    # Generate dedicated key for cshell
    mkdir -p "$(dirname "$SSH_KEY_PATH")"
    rm -f "$SSH_KEY_PATH" "${SSH_KEY_PATH}.pub"
    ssh-keygen -t ed25519 -f "$SSH_KEY_PATH" -N "" -q

    # Authorize the key for chronos user
    local auth_dir="/home/chronos/.ssh"
    mkdir -p "$auth_dir"
    chown chronos:chronos "$auth_dir"
    chmod 700 "$auth_dir"

    # Add key if not already there
    local pubkey=$(cat "${SSH_KEY_PATH}.pub")
    touch "$AUTH_KEYS"
    chown chronos:chronos "$AUTH_KEYS"
    chmod 600 "$AUTH_KEYS"
    if ! grep -qF "$pubkey" "$AUTH_KEYS" 2>/dev/null; then
        echo "$pubkey" >> "$AUTH_KEYS"
    fi

    chmod 600 "$SSH_KEY_PATH"
    echo -e "${GRN}    SSH key installed.${RST}"
}

# ─────────────────────────────────────────
#  INSTALL
# ─────────────────────────────────────────
do_install() {
    banner
    echo -e "${YLW}[*] Installing cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${RED}[!] Run as root.${RST}" && exit 1

    echo -e "${DIM}    Checking rootfs...${RST}"
    check_rootfs

    mkdir -p /usr/local/bin

    # Download cshell to permanent path
    echo -e "${DIM}    Downloading cshell to ${SHELL_PATH}...${RST}"
    if curl -sSL "$SCRIPT_URL" -o "$SHELL_PATH" 2>/dev/null && [[ -s "$SHELL_PATH" ]]; then
        chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Downloaded to ${SHELL_PATH}${RST}"
    elif [[ -f "${BASH_SOURCE[0]}" && "${BASH_SOURCE[0]}" != "/dev/stdin" ]]; then
        cp "${BASH_SOURCE[0]}" "$SHELL_PATH"
        chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Copied from source to ${SHELL_PATH}${RST}"
    else
        echo -e "${RED}[!] Could not obtain script. Check network.${RST}"
        exit 1
    fi

    [[ ! -x "$SHELL_PATH" ]] && echo -e "${RED}[!] Install failed.${RST}" && exit 1

    # Setup SSH key (the NO_NEW_PRIVS workaround)
    setup_ssh_key

    # Backup crosh
    if [[ ! -f "$CROSH_BACKUP" ]]; then
        echo -e "${DIM}    Backing up original crosh...${RST}"
        cp "$CROSH_PATH" "$CROSH_BACKUP" && echo -e "${GRN}    Backed up to ${CROSH_BACKUP}${RST}"
    else
        echo -e "${DIM}    Crosh backup already exists.${RST}"
    fi

    # Write crosh stub — uses SSH to bypass NO_NEW_PRIVS
    echo -e "${DIM}    Writing crosh stub (SSH-based root bypass)...${RST}"
    cat > "$CROSH_PATH" << 'STUB'
#!/bin/bash
# cshell crosh stub - bypasses NO_NEW_PRIVS via SSH
# Start sshd if needed
pgrep -x sshd >/dev/null 2>&1 || /usr/sbin/sshd 2>/dev/null
# SSH as chronos using the cshell key, then sudo into cshell
# StrictHostKeyChecking=no avoids the host key prompt
ssh -i /usr/local/cshell_key \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    chronos@localhost \
    "sudo /usr/local/bin/cshell"
STUB
    chmod +x "$CROSH_PATH"
    echo -e "${GRN}    Crosh stub installed.${RST}"

    echo ""
    echo -e "${GRN}[+] cshell installed!${RST}"
    echo -e "    Open crosh ${DIM}(Ctrl+Alt+T)${RST} to launch.\n"
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty
    exit 0
}

# ─────────────────────────────────────────
#  DELETE CSHELL
# ─────────────────────────────────────────
do_delete() {
    banner
    echo -e "${YLW}[*] Deleting cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete
    remount_rw
    rm -f "$SHELL_PATH" && echo -e "${GRN}[+] Removed ${SHELL_PATH}${RST}" \
        || echo -e "${YLW}[!] ${SHELL_PATH} not found.${RST}"
    rm -f "$SSH_KEY_PATH" "${SSH_KEY_PATH}.pub"
    # Remove cshell key from authorized_keys
    if [[ -f "$AUTH_KEYS" ]]; then
        grep -v "cshell" "$AUTH_KEYS" > /tmp/ak_tmp && mv /tmp/ak_tmp "$AUTH_KEYS"
    fi
    echo -e "${DIM}    Use 'Restore crosh to factory' to fix crosh if needed.${RST}\n"
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty
    exit 0
}

# ─────────────────────────────────────────
#  RESTORE CROSH
# ─────────────────────────────────────────
do_restore_crosh() {
    banner
    echo -e "${YLW}[*] Restoring crosh to factory...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        cp "$CROSH_BACKUP" "$CROSH_PATH"
        chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"
        echo -e "${GRN}[+] Original crosh restored.${RST}"
    else
        echo -e "${RED}[!] No backup found at ${CROSH_BACKUP}.${RST}"
        echo -e "    Recovery: Esc+Refresh+Power → Recovery Mode"
    fi
    echo ""
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty
    exit 0
}

# ─────────────────────────────────────────
#  SHELL PAGES
# ─────────────────────────────────────────
page_sysinfo() {
    banner
    echo -e "  ${WHT}── System Info ──────────────────────────────────────${RST}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local version=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local channel=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local mem_total=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mem_free=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    echo -e "  ${CYN}Board:${RST}    ${board:-unknown}"
    echo -e "  ${CYN}Version:${RST}  ${version:-unknown}  (${channel:-unknown})"
    echo -e "  ${CYN}Kernel:${RST}   $(uname -r)"
    echo -e "  ${CYN}CPU:${RST}      ${cpu:-unknown}"
    echo -e "  ${CYN}RAM:${RST}      ${mem_free} free / ${mem_total} total"
    echo -e "  ${CYN}Uptime:${RST}   $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${CYN}User:${RST}     $(whoami) (uid=$(id -u))"
    pause_key
}

page_battery() {
    banner
    echo -e "  ${WHT}── Battery Health ───────────────────────────────────${RST}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -z "$bat" ]]; then
        command -v ectool &>/dev/null && ectool batterystatus 2>/dev/null || echo "  No battery info found."
        pause_key; return
    fi
    local status=$(cat "$bat/status" 2>/dev/null || echo "unknown")
    local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
    local efull=$(cat "$bat/energy_full" 2>/dev/null)
    local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
    local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
    echo -e "  ${CYN}Status:${RST}  $status"
    echo -e "  ${CYN}Charge:${RST}  ${cap}%"
    if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
        local health=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
        echo -e "  ${CYN}Health:${RST}  ${health}% of design capacity"
        echo -e "  ${CYN}Full:${RST}    $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
        echo -e "  ${CYN}Design:${RST}  $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
    fi
    [[ -n "$voltage" ]] && echo -e "  ${CYN}Voltage:${RST} $(awk "BEGIN{printf \"%.2f V\",$voltage/1000000}")"
    pause_key
}

page_devmode() {
    banner
    echo -e "  ${WHT}── Dev Mode / Boot Flags ────────────────────────────${RST}\n"
    if command -v crossystem &>/dev/null; then
        for key in devsw_boot dev_boot_usb dev_boot_signed_only wpsw_cur fwid; do
            printf "  ${CYN}%-28s${RST} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
    else
        echo "  crossystem not available."
    fi
    pause_key
}

page_net() {
    banner
    echo -e "  ${WHT}── Network ──────────────────────────────────────────${RST}\n"
    ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${DIM}Default route:${RST}"
    ip route show default 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_storage() {
    banner
    echo -e "  ${WHT}── Storage ──────────────────────────────────────────${RST}\n"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs" | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_procs() {
    banner
    echo -e "  ${WHT}── Top Processes ────────────────────────────────────${RST}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -16 | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_extensions() {
    banner
    echo -e "  ${WHT}── Chrome Extensions ────────────────────────────────${RST}\n"
    local dir="/home/chronos/user/Extensions"
    if [[ ! -d "$dir" ]]; then echo "  Not found: $dir"; pause_key; return; fi
    local n=0
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | head -1)
        local name="unknown"
        [[ -n "$mf" ]] && name=$(grep '"name"' "$mf" 2>/dev/null | head -1 \
            | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | cut -c1-45)
        printf "  ${DIM}%-24s${RST}  %s\n" "${id:0:24}" "$name"
        ((n++))
    done
    echo -e "\n  ${DIM}${n} extension(s) found${RST}"
    pause_key
}

menu_rootfs() {
    draw_menu "Rootfs Mount" "Remount read-write" "Remount read-only" "← Back"
    case $MENU_RESULT in
        0) banner; remount_rw; echo -e "  ${GRN}[+] Remounted read-write.${RST}"; pause_key ;;
        1) banner; mount -o remount,ro / 2>/dev/null; echo -e "  ${GRN}[+] Remounted read-only.${RST}"; pause_key ;;
    esac
}

menu_updates() {
    draw_menu "Update Engine" "Block auto-updates" "Allow auto-updates" "← Back"
    case $MENU_RESULT in
        0) banner
           systemctl stop update-engine 2>/dev/null; stop update-engine 2>/dev/null
           pkill -f update_engine 2>/dev/null
           echo -e "  ${GRN}[+] Updates blocked until next reboot.${RST}"; pause_key ;;
        1) banner
           systemctl start update-engine 2>/dev/null; start update-engine 2>/dev/null
           echo -e "  ${GRN}[+] Update engine re-enabled.${RST}"; pause_key ;;
    esac
}

page_wipe_logs() {
    banner
    echo -e "  ${WHT}── Wipe Logs ────────────────────────────────────────${RST}\n"
    echo -ne "  ${YLW}[!] Clear system logs? [y/N]:${RST} "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        for f in /var/log/*.log /var/log/messages /var/log/syslog; do
            [[ -f "$f" ]] && > "$f" && echo -e "  ${GRN}cleared:${RST} $f"
        done
        journalctl --rotate --vacuum-time=1s 2>/dev/null
        echo -e "\n  ${GRN}[+] Logs cleared.${RST}"
    else
        echo -e "  ${DIM}Cancelled.${RST}"
    fi
    pause_key
}

menu_scripts() {
    while true; do
        draw_menu "Run Scripts" \
            "K-Patch   (Kernel Patcher)" \
            "SAUB      (Server Auto Update Blocker)" \
            "R-Patch   (Rollback Patcher)" \
            "← Back"
        case $MENU_RESULT in
            0) banner; echo -e "${YLW}[*] Running K-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/K-Patch); pause_key ;;
            1) banner; echo -e "${YLW}[*] Running SAUB...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/SAUB); pause_key ;;
            2) banner; echo -e "${YLW}[*] Running R-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/R-Patch); pause_key ;;
            *) return ;;
        esac
    done
}

page_bash() {
    banner
    echo -e "  ${YLW}[*] Dropping to root bash. Type 'exit' to return.${RST}\n"
    bash --login
    echo -e "\n  ${CYN}[*] Back in cshell.${RST}"; sleep 1
}

shell_main_menu() {
    while true; do
        draw_menu "Main Menu" \
            "System Info" \
            "Battery Health" \
            "Dev Mode / Boot Flags" \
            "Network" \
            "Storage" \
            "Processes" \
            "Chrome Extensions" \
            "Rootfs Mount" \
            "Update Engine" \
            "Wipe Logs" \
            "Scripts  ›  K-Patch / SAUB / R-Patch" \
            "Root Bash Shell" \
            "Exit"
        case $MENU_RESULT in
            0)  page_sysinfo ;;
            1)  page_battery ;;
            2)  page_devmode ;;
            3)  page_net ;;
            4)  page_storage ;;
            5)  page_procs ;;
            6)  page_extensions ;;
            7)  menu_rootfs ;;
            8)  menu_updates ;;
            9)  page_wipe_logs ;;
            10) menu_scripts ;;
            11) page_bash ;;
            12|-1) echo -e "${DIM}Goodbye.${RST}"; exit 0 ;;
        esac
    done
}

# ─────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────
[[ "$1" == "--delete"  ]] && { [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete; do_delete; }
[[ "$1" == "--restore" ]] && { [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore; do_restore_crosh; }

# Escalate to root
[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

# If launched as the installed shell (from crosh), go to shell menu
if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" ]]; then
    shell_main_menu
    exit 0
fi

# ── Setup menu (curl | bash or bash <(...))
while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete cshell — are you sure?" "Yes — delete cshell" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — are you sure?" "Yes — restore original crosh" "No  — go back"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) echo -e "${DIM}Goodbye.${RST}"; exit 0 ;;
    esac
done
