# ════════════════════════════════════════════════════════════════
#  CROSH ENTRYPOINT — check if sudo works, handle gracefully
# ════════════════════════════════════════════════════════════════
check_sudo_works() {
    # Quick test: can we get root?
    if [[ "$(id -u)" -eq 0 ]]; then
        return 0  # already root, fine
    fi
    # Try sudo with a no-op
    if sudo -n true 2>/dev/null; then
        return 0
    fi
    # sudo is blocked (NO_NEW_PRIVS)
    return 1
}

