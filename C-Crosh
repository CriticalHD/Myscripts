    if doas_check 2>/dev/null; then
        doas bash
    else
        echo -e "  ${Y}doas unavailable — trying alternatives...${N}"
        if sudo -n bash 2>/dev/null; then
            : # already ran
        else
            echo -e "  ${Y}Running as $(whoami). Limited access.${N}\n"
            bash --login
        fi
    fi
    echo -e "\n  ${C}Back in cshell.${N}"; sleep 1
}

pg_ssh_setup() {
