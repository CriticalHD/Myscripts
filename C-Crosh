# ════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ════════════════════════════════════════════════════════════════
case "${1:-}" in
    --delete)  do_delete ;;
    --restore) do_restore_crosh ;;
esac

# ── Launched as installed shell (from crosh) ─────────────────────
if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" || \
      "$(realpath "$0" 2>/dev/null)" == "$ROOTFS_SHELL" ]]; then

    # Try to start sshd if doas not working
    if ! doas_check 2>/dev/null; then
        # Attempt to start sshd via sudo (may work if minioverride active)
        sudo bash -c "$(declare -f setup_root_sshd); \
            ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; \
            SSHD_CONF='$SSHD_CONF'; setup_root_sshd" 2>/dev/null &
        # Also try direct (works if we're already root somehow)
        [[ "$(id -u)" -eq 0 ]] && setup_root_sshd 2>/dev/null &
        sleep 1
    fi

    if doas_check 2>/dev/null; then
        # Full root access via doas — launch menu
        shell_main_menu
    else
        # doas failed — NEVER close, show warning and enter menu anyway
        clear
        echo -e "${Y}"
        echo "  ╔══════════════════════════════════════════════════╗"
        echo "  ║  WARNING: Root access (doas) is not available    ║"
        echo "  ║                                                  ║"
        echo "  ║  Some features will be limited. To fix:          ║"
        echo "  ║  1. Go to VT2 (Ctrl+Alt+F2) as root              ║"
        echo "  ║  2. Run:  /usr/local/bin/cshell  to reinstall    ║"
        echo "  ║  OR use 'Repair > Rebuild doas SSH keys'         ║"
        echo "  ╚══════════════════════════════════════════════════╝"
        echo -e "${N}"
        echo -e "  ${D}Continuing with limited access in 3 seconds...${N}"
        sleep 3
        shell_main_menu
    fi
    exit 0
fi

# ── Setup menu (run from VT2 or bash directly) ───────────────────
[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete — sure?" "Yes" "No"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — sure?" "Yes" "No"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) echo -e "${D}Goodbye.${N}"; exit 0 ;;
    esac
done
