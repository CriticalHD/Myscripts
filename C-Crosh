#!/bin/bash
# cshell - Custom ChromeOS Shell v1.4
# Fixes sudo/NO_NEW_PRIVS via minioverride LD_PRELOAD (R117+ fix)
# Run: curl -sSL <your-raw-url> | sudo bash

SCRIPT_URL="https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/cshell"
SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
UI_CONF="/etc/init/ui.conf"
VERSION="1.4"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
CYN='\033[0;36m'
WHT='\033[1;37m'
DIM='\033[2m'
RST='\033[0m'
REV='\033[7m'

remount_rw() {
    mount -o remount,rw / 2>/dev/null
    mount -o remount,rw /usr 2>/dev/null
}

banner() {
    clear
    echo -e "${CYN}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${RST}  ${WHT}Custom ChromeOS Shell${RST} ${DIM}v${VERSION}${RST}  |  ${GRN}root@$(hostname -s 2>/dev/null || echo chromebook)${RST}"
    echo -e "  ${DIM}────────────────────────────────────────────────────${RST}"
    echo ""
}

pause_key() {
    echo -e "\n  ${DIM}Press any key to go back...${RST}"
    read -rsn1
}

# ─────────────────────────────────────────
#  MENU — arrow keys if tty, numbered if piped
# ─────────────────────────────────────────
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    if [[ -t 0 ]]; then
        local selected=0
        while true; do
            banner
            echo -e "  ${WHT}${title}${RST}\n"
            for i in "${!items[@]}"; do
                if [[ $i -eq $selected ]]; then
                    echo -e "  ${REV}${CYN}  ›  ${items[$i]}  ${RST}"
                else
                    echo -e "  ${DIM}     ${items[$i]}${RST}"
                fi
            done
            echo -e "\n  ${DIM}↑ ↓  navigate    Enter  select    Q  quit${RST}"
            IFS= read -rsn1 key
            if [[ "$key" == $'\x1b' ]]; then
                read -rsn2 -t 0.1 seq
                case "$seq" in
                    '[A') (( selected > 0 )) && (( selected-- )) ;;
                    '[B') (( selected < count-1 )) && (( selected++ )) ;;
                esac
            elif [[ "$key" == "" ]]; then
                MENU_RESULT=$selected; return
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                MENU_RESULT=-1; return
            fi
        done
    else
        exec 3</dev/tty
        banner
        echo -e "  ${WHT}${title}${RST}\n"
        for i in "${!items[@]}"; do
            echo -e "  ${CYN}$((i+1)))${RST}  ${items[$i]}"
        done
        echo ""
        echo -ne "  ${WHT}Select [1-${count}]:${RST} "
        read -r choice <&3
        exec 3<&-
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= count )); then
            MENU_RESULT=$((choice - 1))
        else
            MENU_RESULT=-1
        fi
    fi
}

# ─────────────────────────────────────────
#  ROOTFS CHECK
# ─────────────────────────────────────────
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then
        rm -f /usr/bin/.rw_test; return 0
    fi
    banner
    echo -e "  ${YLW}⚠  Rootfs Verification is ENABLED${RST}\n"
    echo -e "  cshell needs a writable rootfs to install."
    echo -e "  ${WHT}Disable rootfs verification now?${RST}"
    echo -e "  ${DIM}(runs make_dev_ssd.sh --remove_rootfs_verification)${RST}\n"
    local fd; [[ ! -t 0 ]] && exec 3</dev/tty && fd=3 || fd=0
    echo -ne "  ${CYN}[y/N]:${RST} "
    read -r confirm <&$fd
    [[ $fd -eq 3 ]] && exec 3<&-
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "\n${YLW}[*] Disabling rootfs verification...${RST}"
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 | \
            while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${GRN}[+] Done. Reboot required — then re-run install.${RST}\n"
        echo -ne "  Reboot now? [y/N]: "
        read -r rb; [[ "$rb" =~ ^[Yy]$ ]] && reboot
        exit 0
    else
        echo -e "\n  ${RED}[!] Cannot install without writable rootfs. Exiting.${RST}\n"; exit 1
    fi
}

# ─────────────────────────────────────────
#  MINIOVERRIDE — fixes sudo NO_NEW_PRIVS
#  Compiles a tiny .so that stubs out the
#  minijail functions that set no_new_privs,
#  then preloads it into the UI process so
#  all child processes (including crosh)
#  inherit a clean privilege environment.
# ─────────────────────────────────────────
install_minioverride() {
    echo -e "${DIM}    Installing minioverride (sudo fix for R117+)...${RST}"

    # Write minioverride.c
    cat > /tmp/minioverride.c << 'EOF'
int minijail_no_new_privs(){ return 0; }
int minijail_add_fs_restriction_rx(){ return 0; }
int minijail_add_fs_restriction_advanced_rw(){ return 0; }
int minijail_set_enable_profile_fs_restrictions(){ return 0; }
int minijail_enable_default_fs_restrictions(){ return 0; }
EOF

    # Try to compile (needs gcc — available in crostini or dev tools)
    if command -v gcc &>/dev/null; then
        gcc /tmp/minioverride.c -o "$OVERRIDE_SO" -shared -fPIC 2>/dev/null
    elif command -v cc &>/dev/null; then
        cc /tmp/minioverride.c -o "$OVERRIDE_SO" -shared -fPIC 2>/dev/null
    else
        echo -e "${YLW}    gcc not found — trying to download prebuilt minioverride.so...${RST}"
        # Try to download a prebuilt binary (x86_64) — user should host their own
        curl -sSL "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
            -o "$OVERRIDE_SO" 2>/dev/null
    fi

    if [[ ! -f "$OVERRIDE_SO" ]]; then
        echo -e "${RED}    [!] Could not build or download minioverride.so${RST}"
        echo -e "${YLW}    Sudo will still show a warning in crosh but may still work.${RST}"
        echo -e "${YLW}    To fix: install gcc in crostini, compile minioverride.c, copy to ${OVERRIDE_SO}${RST}"
        return 1
    fi

    chmod +x "$OVERRIDE_SO"

    # Patch ui.conf to preload the override into the UI process
    # This makes sudo work from crosh without NO_NEW_PRIVS blocking it
    if [[ -f "$UI_CONF" ]]; then
        if ! grep -q "minioverride" "$UI_CONF"; then
            sed -i '1s/^/env LD_PRELOAD=\/usr\/local\/bin\/minioverride.so\n/' "$UI_CONF"
            echo -e "${GRN}    Patched ${UI_CONF} with LD_PRELOAD${RST}"
            echo -e "${YLW}    NOTE: Reboot required for sudo fix to take effect.${RST}"
            NEEDS_REBOOT=1
        else
            echo -e "${DIM}    ui.conf already patched.${RST}"
        fi
    else
        echo -e "${YLW}    ${UI_CONF} not found — skipping ui.conf patch.${RST}"
    fi

    rm -f /tmp/minioverride.c
    echo -e "${GRN}    minioverride.so installed.${RST}"
}

remove_minioverride() {
    if [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF"; then
        sed -i '/minioverride/d' "$UI_CONF"
        echo -e "${GRN}[+] Removed minioverride patch from ${UI_CONF}${RST}"
    fi
    rm -f "$OVERRIDE_SO"
    echo -e "${GRN}[+] Removed ${OVERRIDE_SO}${RST}"
}

# ─────────────────────────────────────────
#  INSTALL
# ─────────────────────────────────────────
do_install() {
    banner
    echo -e "${YLW}[*] Installing cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${RED}[!] Run as root.${RST}" && exit 1

    echo -e "${DIM}    Checking rootfs...${RST}"
    check_rootfs
    mkdir -p /usr/local/bin

    echo -e "${DIM}    Downloading cshell to ${SHELL_PATH}...${RST}"
    if curl -sSL "$SCRIPT_URL" -o "$SHELL_PATH" 2>/dev/null && [[ -s "$SHELL_PATH" ]]; then
        chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Downloaded to ${SHELL_PATH}${RST}"
    elif [[ -f "${BASH_SOURCE[0]}" && "${BASH_SOURCE[0]}" != "/dev/stdin" ]]; then
        cp "${BASH_SOURCE[0]}" "$SHELL_PATH" && chmod +x "$SHELL_PATH"
        echo -e "${GRN}    Copied from source to ${SHELL_PATH}${RST}"
    else
        echo -e "${RED}[!] Could not obtain script. Check network.${RST}"; exit 1
    fi
    [[ ! -x "$SHELL_PATH" ]] && echo -e "${RED}[!] Install failed.${RST}" && exit 1

    # Install minioverride sudo fix
    NEEDS_REBOOT=0
    install_minioverride

    # Backup crosh
    if [[ ! -f "$CROSH_BACKUP" ]]; then
        echo -e "${DIM}    Backing up original crosh...${RST}"
        cp "$CROSH_PATH" "$CROSH_BACKUP" && echo -e "${GRN}    Backed up to ${CROSH_BACKUP}${RST}"
    else
        echo -e "${DIM}    Crosh backup already exists.${RST}"
    fi

    # Write crosh stub — now sudo works after reboot with minioverride
    echo -e "${DIM}    Writing crosh stub...${RST}"
    printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${GRN}    Crosh stub installed.${RST}"

    echo ""
    echo -e "${GRN}[+] cshell installed!${RST}"
    if [[ $NEEDS_REBOOT -eq 1 ]]; then
        echo -e "${YLW}[!] REBOOT REQUIRED for sudo fix to take effect.${RST}"
        echo -e "    After reboot, open crosh (Ctrl+Alt+T) to launch cshell.\n"
        echo -ne "  Reboot now? [y/N]: "
        local fd; [[ ! -t 0 ]] && exec 3</dev/tty && fd=3 || fd=0
        read -r rb <&$fd; [[ $fd -eq 3 ]] && exec 3<&-
        [[ "$rb" =~ ^[Yy]$ ]] && reboot
    else
        echo -e "    Open crosh (Ctrl+Alt+T) to launch.\n"
    fi
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1
    exit 0
}

# ─────────────────────────────────────────
#  DELETE
# ─────────────────────────────────────────
do_delete() {
    banner
    echo -e "${YLW}[*] Deleting cshell...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --delete
    remount_rw
    remove_minioverride
    rm -f "$SHELL_PATH" && echo -e "${GRN}[+] Removed ${SHELL_PATH}${RST}" \
        || echo -e "${YLW}[!] ${SHELL_PATH} not found.${RST}"
    echo -e "${DIM}    Use 'Restore crosh to factory' if crosh needs fixing.${RST}\n"
    echo -ne "  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1; exit 0
}

# ─────────────────────────────────────────
#  RESTORE CROSH
# ─────────────────────────────────────────
do_restore_crosh() {
    banner
    echo -e "${YLW}[*] Restoring crosh to factory...${RST}\n"
    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --restore
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        cp "$CROSH_BACKUP" "$CROSH_PATH" && chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"
        echo -e "${GRN}[+] Original crosh restored.${RST}"
    else
        echo -e "${RED}[!] No backup found. Recovery: Esc+Refresh+Power${RST}"
    fi
    echo -ne "\n  ${DIM}Press any key to exit...${RST}"
    read -rsn1 </dev/tty 2>/dev/null || read -rsn1; exit 0
}

# ─────────────────────────────────────────
#  SHELL PAGES
# ─────────────────────────────────────────
page_sysinfo() {
    banner
    echo -e "  ${WHT}── System Info ──────────────────────────────────────${RST}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local version=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local channel=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mem_total=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mem_free=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local arch=$(uname -m)
    echo -e "  ${CYN}Board:${RST}    ${board:-unknown}"
    echo -e "  ${CYN}Version:${RST}  ${version:-unknown}  (${channel:-unknown})"
    echo -e "  ${CYN}Kernel:${RST}   $(uname -r) [${arch}]"
    echo -e "  ${CYN}CPU:${RST}      ${cpu:-unknown} (${cores} cores)"
    echo -e "  ${CYN}RAM:${RST}      ${mem_free} free / ${mem_total} total"
    echo -e "  ${CYN}Uptime:${RST}   $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${CYN}User:${RST}     $(whoami) (uid=$(id -u))"
    echo -e "  ${CYN}Hostname:${RST} $(hostname)"
    echo -e "  ${CYN}minioverride:${RST} $( [[ -f "$OVERRIDE_SO" ]] && echo "${GRN}installed${RST}" || echo "${YLW}not installed${RST}")"
    pause_key
}

page_battery() {
    banner
    echo -e "  ${WHT}── Battery Health ───────────────────────────────────${RST}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -z "$bat" ]]; then
        command -v ectool &>/dev/null && ectool batterystatus 2>/dev/null || echo "  No battery info found."
        pause_key; return
    fi
    local status=$(cat "$bat/status" 2>/dev/null || echo "unknown")
    local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
    local efull=$(cat "$bat/energy_full" 2>/dev/null)
    local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
    local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
    local current=$(cat "$bat/current_now" 2>/dev/null)
    echo -e "  ${CYN}Status:${RST}  $status"
    echo -e "  ${CYN}Charge:${RST}  ${cap}%"
    if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
        local health=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
        echo -e "  ${CYN}Health:${RST}  ${health}%  of design capacity"
        echo -e "  ${CYN}Full:${RST}    $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
        echo -e "  ${CYN}Design:${RST}  $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
    fi
    [[ -n "$voltage" ]] && echo -e "  ${CYN}Voltage:${RST} $(awk "BEGIN{printf \"%.3f V\",$voltage/1000000}")"
    [[ -n "$current" ]] && echo -e "  ${CYN}Current:${RST} $(awk "BEGIN{printf \"%.0f mA\",$current/1000}")"
    pause_key
}

page_devmode() {
    banner
    echo -e "  ${WHT}── Dev Mode / Boot Flags ────────────────────────────${RST}\n"
    if command -v crossystem &>/dev/null; then
        for key in devsw_boot dev_boot_usb dev_boot_signed_only wpsw_cur fwid ro_fwid; do
            printf "  ${CYN}%-28s${RST} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
        echo ""
        echo -e "  ${DIM}Full crossystem output:${RST}"
        crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  crossystem not available."
    fi
    pause_key
}

page_net() {
    banner
    echo -e "  ${WHT}── Network ──────────────────────────────────────────${RST}\n"
    ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${DIM}Routes:${RST}"
    ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${DIM}DNS:${RST}"
    cat /etc/resolv.conf 2>/dev/null | grep nameserver | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_storage() {
    banner
    echo -e "  ${WHT}── Storage ──────────────────────────────────────────${RST}\n"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs\|^udev" | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${DIM}Block devices:${RST}"
    lsblk 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_procs() {
    banner
    echo -e "  ${WHT}── Top Processes (by CPU) ───────────────────────────${RST}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -20 | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

page_extensions() {
    banner
    echo -e "  ${WHT}── Chrome Extensions ────────────────────────────────${RST}\n"
    local dir="/home/chronos/user/Extensions"
    if [[ ! -d "$dir" ]]; then echo "  Not found: $dir"; pause_key; return; fi
    local n=0
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | head -1)
        local name="unknown"
        [[ -n "$mf" ]] && name=$(grep '"name"' "$mf" 2>/dev/null | head -1 \
            | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | cut -c1-45)
        printf "  ${DIM}%-24s${RST}  %s\n" "${id:0:24}" "$name"
        ((n++))
    done
    echo -e "\n  ${DIM}${n} extension(s) found${RST}"
    pause_key
}

page_vpd() {
    banner
    echo -e "  ${WHT}── VPD (Vital Product Data) ─────────────────────────${RST}\n"
    if command -v vpd &>/dev/null; then
        echo -e "  ${DIM}RO VPD:${RST}"
        vpd -l 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        echo "  vpd tool not available."
    fi
    pause_key
}

page_sensors() {
    banner
    echo -e "  ${WHT}── Sensors / Temperature ────────────────────────────${RST}\n"
    # CPU temp
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f" | grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null || echo "unknown")
        local temp=$(awk "BEGIN{printf \"%.1f°C\", $(cat $f)/1000}")
        printf "  ${CYN}%-12s${RST} %-20s %s\n" "$zone" "($type)" "$temp"
    done
    echo ""
    # Fan speed via ectool
    if command -v ectool &>/dev/null; then
        echo -e "  ${DIM}Fan:${RST}"
        ectool pwmgetfanrpm 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    fi
    pause_key
}

page_usb() {
    banner
    echo -e "  ${WHT}── USB Devices ──────────────────────────────────────${RST}\n"
    if command -v lsusb &>/dev/null; then
        lsusb 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    else
        # Fallback: read from sysfs
        for dev in /sys/bus/usb/devices/*/; do
            local vendor=$(cat "$dev/idVendor" 2>/dev/null)
            local product=$(cat "$dev/idProduct" 2>/dev/null)
            local name=$(cat "$dev/product" 2>/dev/null || echo "Unknown")
            [[ -n "$vendor" && -n "$product" ]] && \
                echo -e "  ${DIM}${vendor}:${product}${RST}  $name"
        done
    fi
    pause_key
}

page_firewall() {
    banner
    echo -e "  ${WHT}── Firewall / iptables ──────────────────────────────${RST}\n"
    iptables -L -n 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

menu_rootfs() {
    draw_menu "Rootfs Mount" "Remount read-write" "Remount read-only" "← Back"
    case $MENU_RESULT in
        0) banner; remount_rw; echo -e "  ${GRN}[+] Remounted read-write.${RST}"; pause_key ;;
        1) banner; mount -o remount,ro / 2>/dev/null; echo -e "  ${GRN}[+] Remounted read-only.${RST}"; pause_key ;;
    esac
}

menu_updates() {
    draw_menu "Update Engine" \
        "Block auto-updates (stop update-engine)" \
        "Allow auto-updates (start update-engine)" \
        "Check update status" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           systemctl stop update-engine 2>/dev/null; stop update-engine 2>/dev/null
           pkill -f update_engine 2>/dev/null
           echo -e "  ${GRN}[+] Updates blocked until next reboot.${RST}"; pause_key ;;
        1) banner
           systemctl start update-engine 2>/dev/null; start update-engine 2>/dev/null
           echo -e "  ${GRN}[+] Update engine re-enabled.${RST}"; pause_key ;;
        2) banner
           echo -e "  ${WHT}── Update Status ────────────────────────────────────${RST}\n"
           update_engine_client --status 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
           pause_key ;;
    esac
}

page_wipe_logs() {
    banner
    echo -e "  ${WHT}── Wipe Logs ────────────────────────────────────────${RST}\n"
    echo -ne "  ${YLW}[!] Clear system logs? [y/N]:${RST} "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        for f in /var/log/*.log /var/log/messages /var/log/syslog; do
            [[ -f "$f" ]] && > "$f" && echo -e "  ${GRN}cleared:${RST} $f"
        done
        journalctl --rotate --vacuum-time=1s 2>/dev/null
        echo -e "\n  ${GRN}[+] Logs cleared.${RST}"
    else
        echo -e "  ${DIM}Cancelled.${RST}"
    fi
    pause_key
}

menu_scripts() {
    while true; do
        draw_menu "Run Scripts" \
            "K-Patch   (Kernel Patcher)" \
            "SAUB      (Server Auto Update Blocker)" \
            "R-Patch   (Rollback Patcher)" \
            "← Back"
        case $MENU_RESULT in
            0) banner; echo -e "${YLW}[*] Running K-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/K-Patch); pause_key ;;
            1) banner; echo -e "${YLW}[*] Running SAUB...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/SAUB); pause_key ;;
            2) banner; echo -e "${YLW}[*] Running R-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/R-Patch); pause_key ;;
            *) return ;;
        esac
    done
}

menu_power() {
    draw_menu "Power" \
        "Reboot" \
        "Shut down" \
        "← Back"
    case $MENU_RESULT in
        0) echo -e "${YLW}[*] Rebooting...${RST}"; sleep 1; reboot ;;
        1) echo -e "${YLW}[*] Shutting down...${RST}"; sleep 1; poweroff ;;
    esac
}

page_bash() {
    banner
    echo -e "  ${YLW}[*] Dropping to root bash. Type 'exit' to return.${RST}\n"
    bash --login
    echo -e "\n  ${CYN}[*] Back in cshell.${RST}"; sleep 1
}

page_repair_sudo() {
    banner
    echo -e "  ${WHT}── Repair sudo (minioverride) ────────────────────────${RST}\n"
    echo -e "  This re-installs the minioverride LD_PRELOAD fix that"
    echo -e "  allows sudo to work from crosh on ChromeOS R117+.\n"
    echo -e "  A reboot is required after this step.\n"
    echo -ne "  ${CYN}Continue? [y/N]:${RST} "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        remount_rw
        mkdir -p /usr/local/bin
        NEEDS_REBOOT=0
        install_minioverride
        echo ""
        if [[ $NEEDS_REBOOT -eq 1 ]]; then
            echo -ne "\n  Reboot now? [y/N]: "
            read -r rb; [[ "$rb" =~ ^[Yy]$ ]] && reboot
        fi
    else
        echo -e "  ${DIM}Cancelled.${RST}"
    fi
    pause_key
}

