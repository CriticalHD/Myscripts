#!/bin/bash
# cshell - Custom ChromeOS Shell
# curl -sSL <url> | sudo bash

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
VERSION="1.1"

RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
CYN='\033[0;36m'
WHT='\033[1;37m'
DIM='\033[2m'
RST='\033[0m'
REV='\033[7m'

# ─────────────────────────────────────────
remount_rw() {
    mount -o remount,rw / 2>/dev/null
    mount -o remount,rw /usr 2>/dev/null
}

banner() {
    clear
    echo -e "${CYN}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${RST}  ${WHT}Custom ChromeOS Shell${RST} ${DIM}v${VERSION}${RST}  |  ${GRN}root@$(hostname -s 2>/dev/null || echo chromebook)${RST}"
    echo -e "  ${DIM}────────────────────────────────────────────────────${RST}"
    echo ""
}

pause() {
    echo -e "\n  ${DIM}Press any key to go back...${RST}"
    read -rsn1
}

# ─────────────────────────────────────────
#  ARROW KEY MENU
#  Usage: draw_menu "Title" item1 item2 ...
#  Result in $MENU_RESULT (0-indexed), -1 = quit
# ─────────────────────────────────────────
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local selected=0
    local count=${#items[@]}

    while true; do
        banner
        echo -e "  ${WHT}${title}${RST}\n"
        for i in "${!items[@]}"; do
            if [[ $i -eq $selected ]]; then
                echo -e "  ${REV}${CYN}  ›  ${items[$i]}  ${RST}"
            else
                echo -e "  ${DIM}     ${items[$i]}${RST}"
            fi
        done
        echo -e "\n  ${DIM}↑ ↓  navigate    Enter  select    Q  quit${RST}"

        IFS= read -rsn1 key
        if [[ "$key" == $'\x1b' ]]; then
            read -rsn2 -t 0.1 seq
            case "$seq" in
                '[A') (( selected > 0 )) && (( selected-- )) ;;
                '[B') (( selected < count-1 )) && (( selected++ )) ;;
            esac
        elif [[ "$key" == "" ]]; then
            MENU_RESULT=$selected; return
        elif [[ "$key" == "q" || "$key" == "Q" ]]; then
            MENU_RESULT=-1; return
        fi
    done
}

# ─────────────────────────────────────────
#  INSTALLER
# ─────────────────────────────────────────
do_install() {
    banner
    echo -e "${YLW}[*] Installing cshell...${RST}\n"

    [[ "$(id -u)" -ne 0 ]] && echo -e "${RED}[!] Run as root: curl ... | sudo bash${RST}" && exit 1

    echo -e "${DIM}    Remounting rootfs read-write...${RST}"
    remount_rw

    if ! touch /usr/bin/.rw_test 2>/dev/null; then
        echo -e "${RED}[!] Rootfs still read-only. Run K-Patch first.${RST}"
        exit 1
    fi
    rm -f /usr/bin/.rw_test

    mkdir -p /usr/local/bin

    # Write this script to permanent path
    # When run as curl|bash, BASH_SOURCE[0] is the temp script
    echo -e "${DIM}    Writing shell to ${SHELL_PATH}...${RST}"
    if [[ -f "${BASH_SOURCE[0]}" ]]; then
        cp "${BASH_SOURCE[0]}" "$SHELL_PATH"
    else
        # Fallback: rewrite via heredoc won't work for large scripts
        # so we instruct the user to run differently
        echo -e "${RED}[!] Could not copy script. Please run as:${RST}"
        echo -e "    ${WHT}bash <(curl -sSL <your-url>)${RST}  instead of  ${WHT}curl ... | bash${RST}"
        exit 1
    fi

    chmod +x "$SHELL_PATH"

    if [[ ! -x "$SHELL_PATH" ]]; then
        echo -e "${RED}[!] Failed to make ${SHELL_PATH} executable.${RST}"
        exit 1
    fi
    echo -e "${GRN}    Installed to ${SHELL_PATH}${RST}"

    # Backup and replace crosh
    if [[ ! -f "$CROSH_BACKUP" ]]; then
        echo -e "${DIM}    Backing up original crosh...${RST}"
        cp "$CROSH_PATH" "$CROSH_BACKUP" \
            && echo -e "${GRN}    Backed up to ${CROSH_BACKUP}${RST}" \
            || echo -e "${YLW}    Could not back up crosh (may not exist yet)${RST}"
    else
        echo -e "${DIM}    Crosh backup already exists.${RST}"
    fi

    echo -e "${DIM}    Replacing crosh with cshell launcher...${RST}"
    printf '#!/bin/bash\nexec sudo /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${GRN}    Crosh stub installed.${RST}"

    echo ""
    echo -e "${GRN}[+] Done! Press Ctrl+Alt+T to open crosh and launch cshell.${RST}\n"
}

# ─────────────────────────────────────────
#  UNINSTALLER
# ─────────────────────────────────────────
do_uninstall() {
    banner
    echo -e "${YLW}[*] Uninstalling cshell...${RST}\n"

    [[ "$(id -u)" -ne 0 ]] && exec sudo "$0" --uninstall

    remount_rw

    if [[ -f "$CROSH_BACKUP" ]]; then
        cp "$CROSH_BACKUP" "$CROSH_PATH"
        chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"
        echo -e "${GRN}[+] Original crosh restored.${RST}"
    else
        echo -e "${YLW}[!] No crosh backup found.${RST}"
    fi

    rm -f "$SHELL_PATH"
    echo -e "${GRN}[+] Removed ${SHELL_PATH}${RST}"
    echo -e "${GRN}[+] cshell uninstalled successfully.${RST}\n"
    exit 0
}

# ─────────────────────────────────────────
#  FEATURES
# ─────────────────────────────────────────
page_sysinfo() {
    banner
    echo -e "  ${WHT}── System Info ──────────────────────────────────────${RST}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local version=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local channel=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local mem_total=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mem_free=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    echo -e "  ${CYN}Board:${RST}    ${board:-unknown}"
    echo -e "  ${CYN}Version:${RST}  ${version:-unknown}  (${channel:-unknown})"
    echo -e "  ${CYN}Kernel:${RST}   $(uname -r)"
    echo -e "  ${CYN}CPU:${RST}      ${cpu:-unknown}"
    echo -e "  ${CYN}RAM:${RST}      ${mem_free} free / ${mem_total} total"
    echo -e "  ${CYN}Uptime:${RST}   $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${CYN}Running as:${RST} $(whoami) (uid=$(id -u))"
    pause
}

page_battery() {
    banner
    echo -e "  ${WHT}── Battery Health ───────────────────────────────────${RST}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -z "$bat" ]]; then
        command -v ectool &>/dev/null && ectool batterystatus 2>/dev/null || echo "  No battery info found."
        pause; return
    fi
    local status=$(cat "$bat/status" 2>/dev/null || echo "unknown")
    local cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
    local efull=$(cat "$bat/energy_full" 2>/dev/null)
    local edesign=$(cat "$bat/energy_full_design" 2>/dev/null)
    local voltage=$(cat "$bat/voltage_now" 2>/dev/null)
    echo -e "  ${CYN}Status:${RST}  $status"
    echo -e "  ${CYN}Charge:${RST}  ${cap}%"
    if [[ -n "$efull" && -n "$edesign" && "$edesign" -gt 0 ]]; then
        local health=$(awk "BEGIN{printf \"%.1f\",($efull/$edesign)*100}")
        echo -e "  ${CYN}Health:${RST}  ${health}% of design capacity"
        echo -e "  ${CYN}Full:${RST}    $(awk "BEGIN{printf \"%.2f Wh\",$efull/1000000}")"
        echo -e "  ${CYN}Design:${RST}  $(awk "BEGIN{printf \"%.2f Wh\",$edesign/1000000}")"
    fi
    [[ -n "$voltage" ]] && echo -e "  ${CYN}Voltage:${RST} $(awk "BEGIN{printf \"%.2f V\",$voltage/1000000}")"
    pause
}

page_devmode() {
    banner
    echo -e "  ${WHT}── Dev Mode / Boot Flags ────────────────────────────${RST}\n"
    if command -v crossystem &>/dev/null; then
        for key in devsw_boot dev_boot_usb dev_boot_signed_only wpsw_cur fwid; do
            printf "  ${CYN}%-28s${RST} %s\n" "$key" "$(crossystem $key 2>/dev/null || echo n/a)"
        done
    else
        echo "  crossystem not available."
    fi
    pause
}

page_net() {
    banner
    echo -e "  ${WHT}── Network ──────────────────────────────────────────${RST}\n"
    ip -br addr show 2>/dev/null | while read l; do echo "  $l"; done
    echo -e "\n  ${DIM}Default route:${RST}"
    ip route show default 2>/dev/null | while read l; do echo "  $l"; done
    pause
}

page_storage() {
    banner
    echo -e "  ${WHT}── Storage ──────────────────────────────────────────${RST}\n"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs" | while read l; do echo "  $l"; done
    pause
}

page_procs() {
    banner
    echo -e "  ${WHT}── Top Processes ────────────────────────────────────${RST}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -16 | while read l; do echo "  $l"; done
    pause
}

page_extensions() {
    banner
    echo -e "  ${WHT}── Chrome Extensions ────────────────────────────────${RST}\n"
    local dir="/home/chronos/user/Extensions"
    if [[ ! -d "$dir" ]]; then echo "  Not found: $dir"; pause; return; fi
    local n=0
    for id_dir in "$dir"/*/; do
        local id=$(basename "$id_dir")
        local mf=$(find "$id_dir" -name "manifest.json" 2>/dev/null | head -1)
        local name="unknown"
        [[ -n "$mf" ]] && name=$(grep '"name"' "$mf" 2>/dev/null | head -1 \
            | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/' | cut -c1-45)
        printf "  ${DIM}%-24s${RST}  %s\n" "${id:0:24}" "$name"
        ((n++))
    done
    echo -e "\n  ${DIM}${n} extension(s) found${RST}"
    pause
}

menu_rootfs() {
    draw_menu "Rootfs Mount" \
        "Remount read-write" \
        "Remount read-only" \
        "← Back"
    case $MENU_RESULT in
        0) banner; remount_rw; echo -e "  ${GRN}[+] Remounted read-write.${RST}"; pause ;;
        1) banner; mount -o remount,ro / 2>/dev/null; echo -e "  ${GRN}[+] Remounted read-only.${RST}"; pause ;;
    esac
}

menu_updates() {
    draw_menu "Update Engine" \
        "Block auto-updates (stop update-engine)" \
        "Allow auto-updates (start update-engine)" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           systemctl stop update-engine 2>/dev/null
           stop update-engine 2>/dev/null
           pkill -f update_engine 2>/dev/null
           echo -e "  ${GRN}[+] Updates blocked until next reboot.${RST}"; pause ;;
        1) banner
           systemctl start update-engine 2>/dev/null
           start update-engine 2>/dev/null
           echo -e "  ${GRN}[+] Update engine re-enabled.${RST}"; pause ;;
    esac
}

page_wipe_logs() {
    banner
    echo -e "  ${WHT}── Wipe Logs ────────────────────────────────────────${RST}\n"
    echo -ne "  ${YLW}[!] This will clear system logs. Continue? [y/N]:${RST} "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        for f in /var/log/*.log /var/log/messages /var/log/syslog; do
            [[ -f "$f" ]] && > "$f" && echo -e "  ${GRN}cleared:${RST} $f"
        done
        journalctl --rotate --vacuum-time=1s 2>/dev/null
        echo -e "\n  ${GRN}[+] Logs cleared.${RST}"
    else
        echo -e "  ${DIM}Cancelled.${RST}"
    fi
    pause
}

menu_scripts() {
    while true; do
        draw_menu "Run Scripts" \
            "K-Patch   (Kernel Patcher)" \
            "SAUB      (Server Auto Update Blocker)" \
            "R-Patch   (Rollback Patcher)" \
            "← Back"
        case $MENU_RESULT in
            0) banner; echo -e "${YLW}[*] Running K-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/K-Patch); pause ;;
            1) banner; echo -e "${YLW}[*] Running SAUB...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/SAUB); pause ;;
            2) banner; echo -e "${YLW}[*] Running R-Patch...${RST}\n"
               bash <(curl -sSL https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/R-Patch); pause ;;
            *) return ;;
        esac
    done
}

page_bash() {
    banner
    echo -e "  ${YLW}[*] Dropping to root bash. Type 'exit' to return.${RST}\n"
    bash --login
    echo -e "\n  ${CYN}[*] Back in cshell.${RST}"; sleep 1
}

menu_delete() {
    draw_menu "Delete cshell?" \
        "Yes — uninstall and restore crosh" \
        "No  — go back"
    [[ $MENU_RESULT -eq 0 ]] && do_uninstall
}

# ─────────────────────────────────────────
#  MAIN MENU
# ─────────────────────────────────────────
main_menu() {
    while true; do
        draw_menu "Main Menu" \
            "System Info" \
            "Battery Health" \
            "Dev Mode / Boot Flags" \
            "Network" \
            "Storage" \
            "Processes" \
            "Chrome Extensions" \
            "Rootfs Mount" \
            "Update Engine" \
            "Wipe Logs" \
            "Scripts  ›  K-Patch / SAUB / R-Patch" \
            "Root Bash Shell" \
            "Delete cshell" \
            "Exit"
        case $MENU_RESULT in
            0)  page_sysinfo ;;
            1)  page_battery ;;
            2)  page_devmode ;;
            3)  page_net ;;
            4)  page_storage ;;
            5)  page_procs ;;
            6)  page_extensions ;;
            7)  menu_rootfs ;;
            8)  menu_updates ;;
            9)  page_wipe_logs ;;
            10) menu_scripts ;;
            11) page_bash ;;
            12) menu_delete ;;
            13|-1) echo -e "${DIM}Goodbye.${RST}"; exit 0 ;;
        esac
    done
}

# ─────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────
[[ "$1" == "--uninstall" ]] && do_uninstall

# Escalate to root if needed
[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

# If not yet at permanent path → run installer
if [[ "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null)" != "$SHELL_PATH" && \
      "$(realpath "$0" 2>/dev/null)" != "$SHELL_PATH" ]]; then
    do_install
    exit 0
fi

main_menu
