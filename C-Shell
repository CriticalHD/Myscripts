#!/bin/bash
_SELF_PAYLOAD=""
# cshell v4.0 — Custom ChromeOS Shell

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
ROOTKEY="/usr/local/cshell_rootkey"
ROOTKEY_PUB="/usr/local/cshell_rootkey.pub"
SSHD_CONF="/usr/local/cshell_sshd.conf"
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
UI_CONF="/etc/init/ui.conf"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
SUCROSED_FIFO="/tmp/.sucrosed_fifo"
VERSION="4.0"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
C='\033[0;36m'; W='\033[1;37m'; D='\033[2m'
N='\033[0m';    V='\033[7m'

trap '' INT

remount_rw() {
    mount -o remount,rw /    2>/dev/null || true
    mount -o remount,rw /usr 2>/dev/null || true
    mount -o remount,rw /etc 2>/dev/null || true
}

tread()  { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null || echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}

pause_key() { echo -e "\n  ${D}Press any key...${N}"; tread1 _k; }

confirm_yn() {
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a
    [[ "$_a" =~ ^[Yy]$ ]]
}

# ═══════════════════════════════════════════════════════════════
#  MENU — crosh-safe rendering
#  In crosh the tput/escape cursor tricks are unreliable.
#  Strategy: detect if we're in crosh (TERM=xterm but no proper
#  cursor support) and use simple full-redraw but only on change.
#  In VT2 use fast in-place line update.
# ═══════════════════════════════════════════════════════════════
_IN_CROSH=0
_detect_crosh() {
    # crosh sets TERM=xterm but is actually inside Chrome's renderer
    # Best heuristic: check if we can move cursor reliably
    # We test by writing a cursor-up and checking if terminal responds
    if [[ -n "$CHROME_CROSH" ]] || \
       grep -q "crosh" /proc/$PPID/cmdline 2>/dev/null || \
       [[ "$(cat /proc/$PPID/comm 2>/dev/null)" == "crosh" ]]; then
        _IN_CROSH=1; return
    fi
    # Check grandparent too
    local gpp=$(cat /proc/$PPID/status 2>/dev/null | awk '/PPid/{print $2}')
    [[ "$(cat /proc/${gpp}/comm 2>/dev/null)" == "crosh" ]] && _IN_CROSH=1
}

draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    if [[ ! -t 0 || ! -t 1 ]]; then
        # Non-tty fallback (piped install)
        banner
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do echo -e "  ${C}$((i+1)))${N}  ${items[$i]}"; done
        echo ""
        echo -ne "  ${W}Select [1-${count}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch >= 1 && ch <= count )); then
            MENU_RESULT=$((ch-1))
        else
            MENU_RESULT=-1
        fi
        return
    fi

    local sel=0 prev_sel=-1

    # Full initial draw
    _full_draw() {
        clear
        printf '\033[?25l'
        echo -e "${C}"
        echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
        echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
        echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
        echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
        echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
        echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
        echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null || echo chromebook)${N}"
        echo -e "  ${D}────────────────────────────────────────────────────${N}\n"
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do
            if [[ $i -eq $sel ]]; then
                echo -e "  ${V}${C}  ›  ${items[$i]}  ${N}"
            else
                echo -e "  ${D}     ${items[$i]}${N}"
            fi
        done
        echo -e "\n  ${D}↑↓ navigate   Enter select   Q quit${N}"
    }

    # Header = 12 lines (6 banner + blank + version + divider + blank + title + blank)
    local HEADER_LINES=12

    _update_line() {
        local idx=$1 hi=$2
        # Move to correct line: header + idx + 1 (1-based)
        printf '\033[%d;1H\033[2K' "$(( HEADER_LINES + idx + 1 ))"
        if [[ $hi -eq 1 ]]; then
            printf "  ${V}${C}  ›  ${items[$idx]}  ${N}\n"
        else
            printf "  ${D}     ${items[$idx]}${N}\n"
        fi
        # Move cursor back to bottom (nav hint line)
        printf '\033[%d;1H' "$(( HEADER_LINES + count + 2 ))"
    }

    _full_draw
    prev_sel=$sel

    while true; do
        local key seq
        IFS= read -rsn1 key </dev/tty 2>/dev/null
        if [[ "$key" == $'\x1b' ]]; then
            IFS= read -rsn5 -t 0.05 seq </dev/tty 2>/dev/null
            key="${key}${seq}"
        fi

        local new_sel=$sel
        case "$key" in
            $'\x1b[A'|$'\x1bOA') (( new_sel > 0 )) && (( new_sel-- )) ;;
            $'\x1b[B'|$'\x1bOB') (( new_sel < count-1 )) && (( new_sel++ )) ;;
            $'\x1b[5~') new_sel=$(( sel-5 < 0 ? 0 : sel-5 )) ;;
            $'\x1b[6~') new_sel=$(( sel+5 >= count ? count-1 : sel+5 )) ;;
            $'\x1b[H'|$'\x1b[1~') new_sel=0 ;;
            $'\x1b[F'|$'\x1b[4~') new_sel=$(( count-1 )) ;;
            ''|$'\n'|$'\r') printf '\033[?25h'; MENU_RESULT=$sel; return ;;
            'q'|'Q'|$'\x03'|$'\x1b\x1b') printf '\033[?25h'; MENU_RESULT=-1; return ;;
        esac

        if [[ $new_sel -ne $sel ]]; then
            if [[ $_IN_CROSH -eq 1 ]]; then
                # In crosh: full redraw (cursor positioning unreliable)
                sel=$new_sel; _full_draw
            else
                # VT2: fast in-place update
                _update_line $sel 0
                _update_line $new_sel 1
                sel=$new_sel
            fi
        fi
    done
}

# ═══════════════════════════════════════════════════════════════
#  ROOT ACCESS — dual strategy
#  1. doas (SSH port 1337) — always works once installed
#  2. sudo via minioverride — works after ui.conf patch + reboot
#  Both are set up; whichever works gets used
# ═══════════════════════════════════════════════════════════════
doas() {
    ssh -t -p 1337 -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR -oConnectTimeout=3 \
        root@127.0.0.1 "$@"
}

doas_check() {
    [[ ! -f "$ROOTKEY" ]] && return 1
    ssh -p 1337 -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR -oConnectTimeout=2 -oBatchMode=yes \
        root@127.0.0.1 "true" 2>/dev/null
}

sudo_check() { sudo -n true 2>/dev/null; }

# Run command with best available root method
root_run() {
    if [[ "$(id -u)" -eq 0 ]]; then
        bash -c "$*"
    elif doas_check 2>/dev/null; then
        doas "$*"
    elif sudo_check; then
        sudo bash -c "$*"
    else
        return 1
    fi
}

root_available() {
    [[ "$(id -u)" -eq 0 ]] || doas_check 2>/dev/null || sudo_check
}

setup_root_sshd() {
    # MUST be called as root
    [[ "$(id -u)" -ne 0 ]] && return 1
    mkdir -p /usr/local/bin

    if [[ ! -f "$ROOTKEY" || ! -f "$ROOTKEY_PUB" ]]; then
        rm -f "$ROOTKEY" "$ROOTKEY_PUB"
        ssh-keygen -t ed25519 -f "$ROOTKEY" -N "" -q 2>/dev/null
    fi
    chmod 600 "$ROOTKEY"; chmod 644 "$ROOTKEY_PUB"

    cat > "$SSHD_CONF" << EOF
Port 1337
ListenAddress 127.0.0.1
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile $ROOTKEY_PUB
PermitRootLogin yes
PasswordAuthentication no
PubkeyAuthentication yes
AllowUsers root
LogLevel ERROR
UsePAM no
PrintMotd no
PrintLastLog no
EOF
    chmod 600 "$SSHD_CONF"

    mkdir -p /root/.ssh; chmod 700 /root/.ssh
    local pub; pub=$(cat "$ROOTKEY_PUB")
    touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
    grep -qF "$pub" /root/.ssh/authorized_keys 2>/dev/null \
        || echo "$pub" >> /root/.ssh/authorized_keys

    [[ -f /etc/ssh/ssh_host_ed25519_key ]] \
        || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null

    pkill -f "sshd.*1337" 2>/dev/null; sleep 0.2
    /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null
    sleep 0.5
}

# Download architecture-correct minioverride from sudoCrosh
# This is the KEY fix — prebuilt binaries for x86_64 and aarch64
install_sudocrosh_minioverride() {
    local arch=$(uname -m)
    local url=""
    case "$arch" in
        x86_64)  url="https://github.com/shadowed1/sudoCrosh/raw/main/x86_64_minioverride.so" ;;
        aarch64) url="https://github.com/shadowed1/sudoCrosh/raw/main/aarch64_minioverride.so" ;;
        *) echo -e "${Y}    Unsupported arch: $arch${N}"; return 1 ;;
    esac
    echo -e "${D}    Downloading ${arch} minioverride from sudoCrosh...${N}"
    curl -sSfL "$url" -o "$OVERRIDE_SO" 2>/dev/null && [[ -s "$OVERRIDE_SO" ]] && {
        chmod 755 "$OVERRIDE_SO"
        echo -e "${G}    Downloaded minioverride.so (${arch})${N}"
        return 0
    }
    echo -e "${Y}    Download failed, trying gcc...${N}"
    # Fallback: compile
    printf 'int minijail_no_new_privs(void){return 0;}\nint minijail_add_fs_restriction_rx(void){return 0;}\nint minijail_add_fs_restriction_advanced_rw(void){return 0;}\nint minijail_set_enable_profile_fs_restrictions(void){return 0;}\nint minijail_enable_default_fs_restrictions(void){return 0;}' > /tmp/_mo.c
    for cc in gcc tcc cc; do
        command -v "$cc" &>/dev/null && \
            $cc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null && \
            chmod 755 "$OVERRIDE_SO" && rm -f /tmp/_mo.c && return 0
    done
    rm -f /tmp/_mo.c
    return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return 1
    grep -q "minioverride" "$UI_CONF" 2>/dev/null && return 0
    { echo "env LD_PRELOAD=/usr/local/bin/minioverride.so"; cat "$UI_CONF"; } > /tmp/_ui.tmp
    cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    NEEDS_REBOOT=1
    return 0
}

write_self_to() {
    local dest="$1"
    echo "$_SELF_PAYLOAD" | base64 -d > "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    local src="${BASH_SOURCE[0]:-$0}"
    [[ -f "$src" && "$src" != "bash" ]] && cp "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    for fd in 255 254 253; do
        [[ -r "/proc/$$/fd/$fd" ]] && cp "/proc/$$/fd/$fd" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    done
    return 1
}

install_persistence() {
    cp "$SHELL_PATH"  "$ROOTFS_SHELL"           2>/dev/null; chmod +x "$ROOTFS_SHELL" 2>/dev/null
    cp "$ROOTKEY"     /usr/bin/cshell_rootkey   2>/dev/null; chmod 600 /usr/bin/cshell_rootkey 2>/dev/null
    cp "$ROOTKEY_PUB" /usr/bin/cshell_rootkey.pub 2>/dev/null
    cp "$SSHD_CONF"   /usr/bin/cshell_sshd.conf  2>/dev/null
    [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null

    cat > "$INIT_SCRIPT" << 'UPSTART'
description "cshell post-boot restore"
start on started system-services
task
script
    [ -f /usr/local/bin/cshell ] || { mkdir -p /usr/local/bin; cp /usr/bin/cshell_rootfs /usr/local/bin/cshell 2>/dev/null; chmod +x /usr/local/bin/cshell; }
    grep -q "cshell" /usr/bin/crosh 2>/dev/null || { printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > /usr/bin/crosh; chmod +x /usr/bin/crosh; }
    [ -f /usr/local/cshell_rootkey ] || { cp /usr/bin/cshell_rootkey /usr/local/cshell_rootkey 2>/dev/null; cp /usr/bin/cshell_rootkey.pub /usr/local/cshell_rootkey.pub 2>/dev/null; cp /usr/bin/cshell_sshd.conf /usr/local/cshell_sshd.conf 2>/dev/null; chmod 600 /usr/local/cshell_rootkey 2>/dev/null; }
    [ -f /usr/local/bin/minioverride.so ] || { [ -f /usr/bin/minioverride.so ] && cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so && chmod 755 /usr/local/bin/minioverride.so; }
    mkdir -p /root/.ssh; chmod 700 /root/.ssh; touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
    pub=$(cat /usr/local/cshell_rootkey.pub 2>/dev/null); [ -n "$pub" ] && grep -qF "$pub" /root/.ssh/authorized_keys 2>/dev/null || echo "$pub" >> /root/.ssh/authorized_keys
    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null
    pkill -f "sshd.*1337" 2>/dev/null; sleep 0.2
    [ -f /usr/local/cshell_sshd.conf ] && /usr/sbin/sshd -f /usr/local/cshell_sshd.conf 2>/dev/null
end script
UPSTART
    echo -e "${G}    Persistence installed (survives powerwash).${N}"
}

check_rootfs() {
    remount_rw
    touch /usr/bin/.rw_test 2>/dev/null && { rm -f /usr/bin/.rw_test; return 0; }
    banner; echo -e "  ${Y}Rootfs is read-only. Disable verification?${N}\n"
    confirm_yn "Run make_dev_ssd.sh now?" && {
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}Done. Reboot then re-run.${N}"; confirm_yn "Reboot now?" && reboot; exit 0
    }
    echo -e "${R}Cannot continue.${N}"; exit 1
}

# ═══════════════════════════════════════════════════════════════
#  INSTALL / DELETE / RESTORE
# ═══════════════════════════════════════════════════════════════
do_install() {
    banner; echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}[!] Must be root.${N}" && exit 1
    echo -e "${D}    Checking rootfs...${N}"; check_rootfs
    mkdir -p /usr/local/bin

    echo -e "${D}    Writing cshell...${N}"
    write_self_to "$SHELL_PATH" && chmod +x "$SHELL_PATH" && echo -e "${G}    Written to ${SHELL_PATH}${N}" \
        || { echo -e "${R}[!] Could not write cshell.${N}"; exit 1; }

    echo -e "${D}    Setting up doas SSH (port 1337)...${N}"
    setup_root_sshd
    doas_check && echo -e "${G}    doas working!${N}" || echo -e "${Y}    doas will activate on reboot.${N}"

    NEEDS_REBOOT=0
    echo -e "${D}    Installing minioverride.so (sudo fix)...${N}"
    install_sudocrosh_minioverride && patch_ui_conf \
        && echo -e "${G}    minioverride.so installed + ui.conf patched.${N}" \
        || echo -e "${Y}    minioverride failed — doas handles root access.${N}"

    install_persistence

    [[ ! -f "$CROSH_BACKUP" ]] && cp "$CROSH_PATH" "$CROSH_BACKUP" 2>/dev/null
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > "$CROSH_PATH"; chmod +x "$CROSH_PATH"
    echo -e "${G}    Crosh stub installed (no sudo needed).${N}\n"
    echo -e "${G}[+] Done! Open crosh (Ctrl+Alt+T) to launch.${N}"
    [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "${Y}[!] Reboot recommended (minioverride needs it).${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_delete() {
    banner; echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { root_run "bash $SHELL_PATH --delete" 2>/dev/null && exit 0; \
        exec sudo "$0" --delete 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw; pkill -f "sshd.*1337" 2>/dev/null
    [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" && {
        grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp; cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp; }
    rm -f "$SHELL_PATH" "$ROOTFS_SHELL" "$INIT_SCRIPT" "$ROOTKEY" "$ROOTKEY_PUB" \
          "$SSHD_CONF" "$OVERRIDE_SO" /usr/bin/minioverride.so \
          /usr/bin/cshell_rootkey /usr/bin/cshell_rootkey.pub /usr/bin/cshell_sshd.conf
    echo -e "${G}[+] Deleted.${N}"; echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_restore_crosh() {
    banner; echo -e "${Y}[*] Restoring crosh...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { root_run "bash $SHELL_PATH --restore" 2>/dev/null && exit 0; \
        exec sudo "$0" --restore 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw
    [[ -f "$CROSH_BACKUP" ]] && { rm -f "$CROSH_PATH"; cp "$CROSH_BACKUP" "$CROSH_PATH"; chmod +x "$CROSH_PATH"; rm -f "$CROSH_BACKUP"; echo -e "${G}[+] Crosh restored.${N}"; } \
        || echo -e "${R}[!] No backup.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

# ═══════════════════════════════════════════════════════════════
#  ── DIAGNOSTICS ──────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_sysinfo() {
    banner; echo -e "  ${W}── System Info ──────────────────────────────────────${N}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local ver=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local chan=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mt=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mf=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mu=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    local st=$(awk '/SwapTotal/{printf "%.0f MB",$2/1024}' /proc/meminfo)
    echo -e "  ${C}Board:${N}         ${board:-?}"
    echo -e "  ${C}Version:${N}       ${ver:-?}  (${chan:-?})"
    echo -e "  ${C}Build:${N}         ${build:-?}"
    echo -e "  ${C}Kernel:${N}        $(uname -r) [$(uname -m)]"
    echo -e "  ${C}CPU:${N}           ${cpu:-?} x${cores}"
    echo -e "  ${C}RAM:${N}           ${mu} used / ${mf} free / ${mt} total"
    echo -e "  ${C}Swap:${N}          ${st}"
    echo -e "  ${C}Uptime:${N}        $(uptime -p 2>/dev/null || uptime)"
    echo -e "  ${C}User:${N}          $(whoami) uid=$(id -u)"
    echo -e "  ${C}Root via:${N}      $( [[ $(id -u) -eq 0 ]] && echo "${G}direct${N}" || \
        { doas_check 2>/dev/null && echo "${G}doas (SSH:1337)${N}"; } || \
        { sudo_check && echo "${Y}sudo (minioverride)${N}"; } || echo "${R}none${N}" )"
    echo -e "  ${C}Persistence:${N}   $([[ -f $INIT_SCRIPT ]] && echo "${G}yes${N}" || echo "${Y}no${N}")"
    pause_key
}

pg_battery() {
    banner; echo -e "  ${W}── Battery ──────────────────────────────────────────${N}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -n "$bat" ]]; then
        local st=$(cat "$bat/status" 2>/dev/null||echo "?")
        local cap=$(cat "$bat/capacity" 2>/dev/null||echo "?")
        local ef=$(cat "$bat/energy_full" 2>/dev/null)
        local ed=$(cat "$bat/energy_full_design" 2>/dev/null)
        local en=$(cat "$bat/energy_now" 2>/dev/null)
        local v=$(cat "$bat/voltage_now" 2>/dev/null)
        local i=$(cat "$bat/current_now" 2>/dev/null)
        local cyc=$(cat "$bat/cycle_count" 2>/dev/null)
        local mfr=$(cat "$bat/manufacturer" 2>/dev/null)
        local mdl=$(cat "$bat/model_name" 2>/dev/null)
        echo -e "  ${C}Status:${N}  $st  |  ${C}Charge:${N} ${cap}%"
        [[ -n "$mfr" ]] && echo -e "  ${C}Mfr:${N}     $mfr  $mdl"
        [[ -n "$cyc" && "$cyc" != "0" ]] && echo -e "  ${C}Cycles:${N}  $cyc"
        if [[ -n "$ef" && -n "$ed" && "$ed" -gt 0 ]]; then
            local h=$(awk "BEGIN{printf \"%.1f\",($ef/$ed)*100}")
            local hc=$G; awk "BEGIN{exit !($h+0<80)}" 2>/dev/null && hc=$Y
            awk "BEGIN{exit !($h+0<60)}" 2>/dev/null && hc=$R
            echo -e "  ${C}Health:${N}  ${hc}${h}%${N}  ($(awk "BEGIN{printf \"%.2f\",$ef/1000000}") / $(awk "BEGIN{printf \"%.2f Wh\",$ed/1000000}"))"
        fi
        [[ -n "$en" ]] && echo -e "  ${C}Now:${N}     $(awk "BEGIN{printf \"%.2f Wh\",$en/1000000}")"
        [[ -n "$v"  ]] && echo -e "  ${C}Voltage:${N} $(awk "BEGIN{printf \"%.3f V\",$v/1000000}")"
        [[ -n "$i"  ]] && echo -e "  ${C}Draw:${N}    $(awk "BEGIN{printf \"%.0f mA\",$i/1000}")"
    fi
    root_available && {
        echo -e "\n  ${D}ectool:${N}"
        root_run "ectool batterystatus 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_sensors() {
    banner; echo -e "  ${W}── Sensors ──────────────────────────────────────────${N}\n"
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f"|grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null||echo "?")
        local raw=$(cat "$f" 2>/dev/null||echo "0")
        local tc=$G; (( raw>70000 ))&&tc=$Y; (( raw>85000 ))&&tc=$R
        printf "  ${C}%-10s${N} %-22s ${tc}%.1f°C${N}\n" "$zone" "($type)" "$(awk "BEGIN{print $raw/1000}")"
    done
    root_available && {
        echo -e "\n  ${D}Fan:${N}"
        root_run "ectool pwmgetfanrpm 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}EC temps:${N}"
        root_run "ectool temps all 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_net() {
