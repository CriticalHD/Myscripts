# ════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ════════════════════════════════════════════════════════════════
case "${1:-}" in
    --delete)  do_delete; exit 0 ;;
    --restore) do_restore_crosh; exit 0 ;;
esac

# Launched as installed shell
if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" || \
      "$(realpath "$0" 2>/dev/null)" == "$ROOTFS_SHELL" ]]; then

    # If running as root (VT2), set up sshd directly
    if [[ "$(id -u)" -eq 0 ]]; then
        setup_root_sshd 2>/dev/null
        shell_main_menu
        exit 0
    fi

    # Running as chronos (from crosh) — try to get doas working
    if ! doas_check 2>/dev/null; then
        # Last ditch: try sudo (may work with minioverride)
        sudo bash -c "
            $(declare -f setup_root_sshd)
            ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'
            setup_root_sshd
        " 2>/dev/null
        sleep 0.8
    fi

    if doas_check 2>/dev/null; then
        shell_main_menu
    else
        # Never close — show warning and continue
        clear
        echo -e "${Y}"
        echo "  ╔══════════════════════════════════════════════════╗"
        echo "  ║  WARNING: Root access (doas) unavailable         ║"
        echo "  ║                                                  ║"
        echo "  ║  To fix:                                         ║"
        echo "  ║  • Go to VT2 (Ctrl+Alt+F2)                       ║"
        echo "  ║  • Log in as root                                ║"
        echo "  ║  • Run: /usr/local/bin/cshell                    ║"
        echo "  ║                                                  ║"
        echo "  ║  OR: Use 'Repair › Rebuild doas SSH keys'        ║"
        echo "  ╚══════════════════════════════════════════════════╝"
        echo -e "${N}"
        echo -e "  ${D}Continuing with limited access in 3s...${N}"
        sleep 3
        shell_main_menu
    fi
    exit 0
fi

# Setup context (VT2 / direct run) — must be root
[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" \
        "Delete cshell" \
        "Restore crosh to factory" \
        "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete — sure?" "Yes, delete" "No, go back"
           [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — sure?" "Yes, restore" "No, go back"
           [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) printf '\033[?25h'; echo -e "${D}Goodbye.${N}"; exit 0 ;;
    esac
done
