# ═══════════════════════════════════════════════════════════════
pg_logs() {
    banner; echo -e "  ${W}── System Logs ──────────────────────────────────────${N}\n"
    tail -40 /var/log/messages 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || journalctl -n 40 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key
}

pg_cros_logs() {
    banner; echo -e "  ${W}── ChromeOS Logs ────────────────────────────────────${N}\n"
    echo -e "  ${D}update_engine:${N}"; tail -20 /var/log/update_engine.log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}power_manager:${N}"; tail -10 /var/log/power_manager/power_log 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    local cf; cf=$(ls -t /var/log/chrome/*.log 2>/dev/null | head -1)
    [[ -n "$cf" ]] && { echo -e "\n  ${D}Chrome:${N}"; tail -15 "$cf" | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

menu_rootfs_mgr() {
    draw_menu "Rootfs" "Remount read-write" "Remount read-only" "Mount flags" "< Back"
    case $MENU_RESULT in
        0) banner; root_run "mount -o remount,rw /" || remount_rw; echo -e "  ${G}Remounted rw.${N}"; pause_key ;;
        1) banner; root_run "mount -o remount,ro /" 2>/dev/null; echo -e "  ${G}Remounted ro.${N}"; pause_key ;;
        2) banner; mount | grep -E "on / |on /usr" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

menu_updates() {
    draw_menu "Update Engine" "Block updates" "Allow updates" "Status" "Force check" "< Back"
    case $MENU_RESULT in
        0) banner; root_run "systemctl stop update-engine; pkill -f update_engine" 2>/dev/null
           echo -e "  ${G}Updates blocked.${N}"; pause_key ;;
        1) banner; root_run "systemctl start update-engine" 2>/dev/null
           echo -e "  ${G}Updates allowed.${N}"; pause_key ;;
        2) banner; update_engine_client --status 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        3) banner; update_engine_client --check_for_update 2>/dev/null; sleep 2
           update_engine_client --status 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

menu_wipe() {
    draw_menu "Wipe / Clean" "System logs" "Clear /tmp" "Chrome cache" "< Back"
    case $MENU_RESULT in
        0) banner; confirm_yn "Clear system logs?" && {
               root_run "for f in /var/log/*.log /var/log/messages; do [ -f \"\$f\" ] && > \"\$f\"; done"
               echo -e "  ${G}Done.${N}"; } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
        1) banner; confirm_yn "Clear /tmp?" && { root_run "rm -rf /tmp/*"; echo -e "  ${G}Done.${N}"; } \
               || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
        2) banner; confirm_yn "Clear Chrome cache?" && {
               find /home/chronos -name "Cache" -type d 2>/dev/null | while read d; do
                   rm -rf "${d:?}"/* 2>/dev/null && echo -e "  ${G}cleared: $d${N}"; done; } \
               || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
    esac
}

pg_crostini() {
    banner; echo -e "  ${W}── Crostini / Linux VM ──────────────────────────────${N}\n"
    echo -e "  ${D}VM list:${N}"
    timeout 5 vmc list 2>/dev/null | while IFS= read -r l; do echo "  $l"; done \
        || echo "  (vmc not available or timed out)"
    echo -e "\n  ${D}[S] Start termina  [T] Stop  [R] vsh into termina  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        s|S) banner; echo -e "${Y}Starting termina...${N}\n"
             timeout 30 vmc start termina 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) banner; timeout 10 vmc stop termina 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        r|R) banner; echo -e "${Y}Opening vsh... type 'exit' to return${N}\n"
             vsh termina 2>/dev/null || echo -e "  ${R}vsh not available.${N}"; pause_key ;;
    esac
}

menu_system_mgmt() {
    while true; do
        draw_menu "System Management" \
            "System Logs" "ChromeOS Logs" "Rootfs Mount" \
            "Update Engine" "Wipe / Clean" "Crostini / Linux VM" "< Back"
        case $MENU_RESULT in
            0) pg_logs ;; 1) pg_cros_logs ;; 2) menu_rootfs_mgr ;;
            3) menu_updates ;; 4) menu_wipe ;; 5) pg_crostini ;;
            *) return ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════
#  FILE BROWSER — paginated, search, execute .sh
# ═══════════════════════════════════════════════════════════════
pg_file_browser() {
    local cur="${1:-/}"
    local page_size=20
    local offset=0
    local search=""

    while true; do
        # Build full entry list with optional search filter
        local all=()
        while IFS= read -r name; do
            local fp="${cur%/}/${name}"
            if [[ -n "$search" ]]; then
                echo "$name" | grep -qi "$search" || continue
            fi
            if [[ -d "$fp" ]]; then
                all+=("[D] ${name}/")
            else
                local sz; sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                all+=("[F] ${name}  (${sz:-?})")
            fi
        done < <(ls -1p "$cur" 2>/dev/null)

        local total=${#all[@]}
        local show=()
        local i
        for (( i=offset; i<offset+page_size && i<total; i++ )); do
            show+=("${all[$i]}")
        done

        # Build navigation entries
        local nav=()
        [[ "$cur" != "/" ]] && nav+=("^ Up  ($(dirname $cur))")
        [[ -n "$search" ]] && nav+=("* Search: '$search'  [clear]") || nav+=("/ Search files...")
        (( offset+page_size < total )) && nav+=("v More ($(( total-offset-page_size )) more)...")
        (( offset > 0 )) && nav+=("^ Previous page")
        nav+=("< Exit browser")

        local pg="$(( offset+1 ))-$(( offset+page_size<total ? offset+page_size : total ))/${total}"
        [[ -n "$search" ]] && pg="filter: '$search'  ${pg}"

        draw_menu "Files: ${cur}  [${pg}]" "${show[@]}" "───────────────────────────────────" "${nav[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return

        # Figure out what was selected
        local total_show=${#show[@]}
        local total_entries=$(( ${#show[@]} + 1 + ${#nav[@]} ))  # +1 for separator

        if (( MENU_RESULT < total_show )); then
            # A file or directory was selected
            local chosen="${show[$MENU_RESULT]}"
            if [[ "$chosen" == "[D] "* ]]; then
                local dn="${chosen#\[D\] }"; dn="${dn%/}"
                cur="${cur%/}/${dn}"; offset=0; search=""
            elif [[ "$chosen" == "[F] "* ]]; then
                local fn="${chosen#\[F\] }"; fn="${fn%%  (*}"
                local fp="${cur%/}/${fn}"
                local ext="${fn##*.}"
                local is_exec=0
                [[ "$ext" == "sh" || "$ext" == "bash" || -x "$fp" ]] && is_exec=1
                local opts=()
                [[ $is_exec -eq 1 ]] && opts+=("Execute script")
                opts+=("View (tail 50)" "View (head 50)" "Edit (nano/vi)" "Delete" "File info" "Copy path" "< Back")
                draw_menu "$fn" "${opts[@]}"
                local fi=$MENU_RESULT
                if [[ $is_exec -eq 1 && $fi -eq 0 ]]; then
                    banner; echo -e "  ${Y}Executing $fp ...${N}\n"
                    bash "$fp"; echo -e "\n  ${G}Script finished.${N}"; pause_key
                else
                    [[ $is_exec -eq 1 ]] && (( fi-- ))
                    case $fi in
                        0) banner; tail -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                        1) banner; head -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                        2) root_available && root_run "command -v nano &>/dev/null && nano '$fp' || vi '$fp'" \
                               || { command -v nano &>/dev/null && nano "$fp" || vi "$fp"; } ;;
                        3) confirm_yn "Delete $fp?" && { root_run "rm -f '$fp'" && echo -e "  ${G}Deleted.${N}"; }; pause_key ;;
                        4) banner; ls -lah "$fp" 2>/dev/null; file "$fp" 2>/dev/null; pause_key ;;
                        5) echo -e "  ${W}$fp${N}"; pause_key ;;
                    esac
                fi
            fi
        else
            # Navigation item selected — adjust for separator
            local nav_i=$(( MENU_RESULT - total_show - 1 ))
            local nav_item="${nav[$nav_i]}"
            case "$nav_item" in
                "^ Up"*)     cur=$(dirname "$cur"); offset=0; search="" ;;
                "* Search"*) search=""; offset=0 ;;
                "/ Search"*) echo -ne "\n  ${Y}Search (regex ok):${N} "; tread search; offset=0 ;;
                "v More"*)   (( offset += page_size )) ;;
                "^ Previous"*) (( offset -= page_size )); (( offset < 0 )) && offset=0 ;;
                "< Exit"*)   return ;;
            esac
        fi
    done
}

