        echo -e "  ${D}Current:${N}"
        root_run "futility gbb --get --flags 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    } || echo -e "  ${Y}Need root to read GBB flags.${N}"
    echo -e "\n  ${W}Common values:${N}"
    echo -e "  ${C}0x0000${N}  Default (all off)"
    echo -e "  ${C}0x0001${N}  DEV_SCREEN_SHORT_DELAY"
    echo -e "  ${C}0x0008${N}  FORCE_DEV_SWITCH_ON   (no dev mode beep)"
    echo -e "  ${C}0x0010${N}  DISABLE_DEV_REQUEST   (can't leave dev)"
    echo -e "  ${C}0x0020${N}  DISABLE_FW_ROLLBACK_CHECK"
    echo -e "  ${C}0x8000${N}  CCD_UNLOCK"
    echo -e "  ${C}0x8090${N}  Murkmod / fakemurk value"
    if root_available; then
