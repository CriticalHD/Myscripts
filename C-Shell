pg_wp_diagnostic() {
    banner
    echo -e " ${W}── Write Protect Diagnostic ─────────────────────────${N}\n"

    if ! root_available; then
        echo -e " ${R}Root access required for full diagnostics.${N}"
        pause_key
        return
    fi

    echo -e " ${W}Crossystem Status:${N}"
    local wpsw=$(sudo crossystem wpsw_cur 2>/dev/null || echo "?")
    local devsw=$(sudo crossystem devsw_cur 2>/dev/null || echo "?")
    local dev_usb=$(sudo crossystem dev_boot_usb 2>/dev/null || echo "?")
    local dev_signed=$(sudo crossystem dev_boot_signed_only 2>/dev/null || echo "?")

    echo -e " ${C}wpsw_cur          :${N} $([[ "$wpsw" == "1" ]] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}") (${wpsw})"
    echo -e " ${C}devsw_cur         :${N} $([[ "$devsw" == "1" ]] && echo "${G}ON${N}" || echo "${Y}OFF${N}") (${devsw})"
    echo -e " ${C}dev_boot_signed_only:${N} $([[ "$dev_signed" == "1" ]] && echo "${R}ENFORCED${N}" || echo "${G}Unsigned allowed${N}")"

    # GBB Flags USB Check
    local gbb_flags="0x0"
    local gbb_dev_usb=0
    if command -v futility &>/dev/null && command -v flashrom &>/dev/null; then
        local tmpgbb=$(mktemp /tmp/gbb.XXXXXX)
        sudo flashrom -p internal -i GBB -r "$tmpgbb" >/dev/null 2>&1
        gbb_flags=$(sudo futility gbb --get --flags "$tmpgbb" 2>/dev/null | awk '{print $NF}')
        rm -f "$tmpgbb"

        if (( (gbb_flags & 0x10) != 0 )); then
            gbb_dev_usb=1
        fi
    fi

    if [[ "$dev_usb" == "1" ]] || [[ "$gbb_dev_usb" == "1" ]]; then
        echo -e " ${C}dev_boot_usb      :${N} ${G}ALLOWED${N} ${D}(via ${dev_usb:-0} / GBB)${N}"
    else
        echo -e " ${C}dev_boot_usb      :${N} ${R}DISABLED${N}"
    fi

    # GSC / Ti50
    echo -e "\n ${W}GSC (Cr50/Ti50) Status:${N}"
    local flash_wp=$(sudo gsctool -a -w 2>/dev/null | grep -i 'Flash WP' | awk '{print $3}' || echo "?")
    echo -e " ${C}Flash WP          :${N} $([[ "$flash_wp" == "enabled" ]] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}")"

    # CCD Info
    echo -e "\n ${W}CCD (Console) Information:${N}"
    local gsc_i=$(sudo gsctool -a -I 2>/dev/null)
    local ccd_state=$(echo "$gsc_i" | grep -i "^State:" | awk '{print $2}' || echo "Unknown")

    echo -e " ${C}CCD State         :${N} $([[ "$ccd_state" == "Locked" ]] && echo "${R}Locked${N}" || echo "${G}${ccd_state}${N}")"

    echo -e "\n ${W}GSC Capabilities:${N}"
    for cap in AllowUnverifiedRo OverrideWP FlashAP FlashRead GscFullConsole; do
        local state=$(echo "$gsc_i" | grep -i "$cap" | grep -oE 'Never|IfOpened|Always' | head -1)
        local sc=$Y
        [[ "$state" == "Always" ]] && sc=$G
        [[ "$state" == "Never" ]] && sc=$R
        printf " ${C}%-18s${N} ${sc}%s${N}\n" "$cap" "${state:-Unknown}"
    done

    # SPI Flash Status
    echo -e "\n ${W}SPI Flash WP Status:${N}"
    sudo flashrom --wp-status 2>/dev/null | while IFS= read -r l; do
        [[ -n "$l" ]] && echo "   $l"
    done

    # Kernel Messages
    echo -e "\n ${W}Kernel WP Messages:${N}"
    sudo dmesg | grep -iE 'write-protect|wp:|WP:|HWP|flash|spi' | tail -n 8 | while IFS= read -r l; do
        [[ -n "$l" ]] && echo "   $l"
    done

    echo -e "\n ${D}[F] Run full SPI read test   [Any other key] Back${N}"
    local k; tread1 k

    if [[ "$k" == "f" || "$k" == "F" ]]; then
        echo -e "\n ${Y}Testing SPI read access (this may take a moment)...${N}"
        local tmpfile=$(mktemp /tmp/spi_test.XXXXXX)
        
        sudo flashrom -p internal -r "$tmpfile" >/dev/null 2>&1 &
        local pid=$!

        local spinner="/-\|"
        local i=0
        while kill -0 $pid 2>/dev/null; do
            i=$(( (i+1) % 4 ))
            printf "\r ${Y}Reading SPI flash... %s${N}" "${spinner:$i:1}"
            sleep 0.25
        done
        wait $pid
        local status=$?

        echo -ne "\r\033[K"
        if [[ $status -eq 0 ]]; then
            echo -e " ${G}✓ SPI Flash Read Successful — WP is effectively disabled${N}"
        else
            echo -e " ${R}✗ SPI Flash Read Failed${N}"
        fi
        rm -f "$tmpfile"
        pause_key
    fi
}

