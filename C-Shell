# ═══════════════════════════════════════════════════════════════
#  ── SSH / DOAS SETUP ─────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_ssh_doas() {
    banner; echo -e "  ${W}── SSH / doas Setup ─────────────────────────────────${N}\n"
    local doas_st; doas_check 2>/dev/null && doas_st="${G}working${N}" || doas_st="${R}NOT working${N}"
    local sudo_st; sudo_check && sudo_st="${G}working${N}" || sudo_st="${R}NOT working${N}"
    local mo_st; [[ -f "$OVERRIDE_SO" ]] && mo_st="${G}installed${N}" || mo_st="${Y}missing${N}"
    echo -e "  ${C}doas (SSH:1337):${N}   $doas_st"
    echo -e "  ${C}sudo:${N}             $sudo_st"
    echo -e "  ${C}minioverride.so:${N}  $mo_st\n"

    draw_menu "SSH / doas" \
        "Restart cshell sshd (port 1337)" \
        "Install/reinstall minioverride.so (sudo fix)" \
        "Start public SSH (port 22)" \
        "Set chronos password" \
        "Set root password" \
        "Show authorized_keys" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           if [[ "$(id -u)" -eq 0 ]]; then
               setup_root_sshd
               doas_check && echo -e "  ${G}doas working!${N}" || echo -e "  ${Y}sshd started, test again.${N}"
           elif root_available; then
               root_run "$(declare -f setup_root_sshd); ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'; setup_root_sshd"
               sleep 0.8; doas_check && echo -e "  ${G}doas working!${N}" || echo -e "  ${Y}Try rebooting.${N}"
           else
               echo -e "  ${R}Need root. Go to VT2, log in as root, and run:${N}"
               echo -e "  ${W}  /usr/local/bin/cshell${N}"
           fi; pause_key ;;
        1) banner; remount_rw
           echo -e "  ${D}Downloading minioverride for $(uname -m)...${N}"
           install_sudocrosh_minioverride && {
               patch_ui_conf
               cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
               echo -e "  ${G}minioverride.so installed.${N}"
               [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "  ${Y}Reboot required for sudo to work in crosh.${N}"
           } || echo -e "  ${R}Failed.${N}"; pause_key ;;
        2) root_run "/usr/sbin/sshd 2>/dev/null"
           local ip=$(hostname -I 2>/dev/null | awk '{print $1}')
           echo -e "  ${G}sshd started.${N}\n  ${D}ssh chronos@${ip:-<ip>}${N}"; pause_key ;;
        3) passwd chronos; pause_key ;;
        4) root_available && root_run "passwd root" || echo -e "  ${R}Need root.${N}"; pause_key ;;
        5) banner
           root_available && root_run "cat /root/.ssh/authorized_keys 2>/dev/null" \
               || cat /root/.ssh/authorized_keys 2>/dev/null || echo "  Cannot read."; pause_key ;;
    esac
}

# ═══════════════════════════════════════════════════════════════
#  ── REPAIR / REBUILD ─────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_repair() {
    banner; echo -e "  ${W}── Repair / Rebuild ─────────────────────────────────${N}\n"
    draw_menu "Repair" \
        "Rebuild doas SSH keys (need root/VT2)" \
        "Reinstall minioverride.so (sudo fix)" \
        "Reinstall persistence hooks" \
        "Restart sshd port 1337" \
        "Fix ui.conf (patch/unpatch minioverride)" \
        "← Back"
    case $MENU_RESULT in
        0) banner; remount_rw
           if [[ "$(id -u)" -eq 0 ]]; then
               setup_root_sshd; sleep 0.5
               doas_check && echo -e "  ${G}doas working!${N}" || echo -e "  ${Y}Try: reboot${N}"
           else
               echo -e "  ${R}Must run from VT2 as root.${N}"
               echo -e "  ${Y}In VT2: /usr/local/bin/cshell → Repair → this option${N}"
           fi; pause_key ;;
        1) banner; remount_rw; rm -f "$OVERRIDE_SO"
           install_sudocrosh_minioverride && {
               patch_ui_conf; cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
               echo -e "  ${G}Done. Reboot for sudo to activate.${N}"
           } || echo -e "  ${R}Failed.${N}"; pause_key ;;
        2) banner; remount_rw
           [[ "$(id -u)" -eq 0 ]] && install_persistence || echo -e "  ${R}Need root.${N}"; pause_key ;;
        3) banner
           root_run "pkill -f 'sshd.*1337'; sleep 0.3; /usr/sbin/sshd -f $SSHD_CONF" 2>/dev/null \
               || { pkill -f "sshd.*1337" 2>/dev/null; sleep 0.3; /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null; }
           sleep 0.5; doas_check && echo -e "  ${G}doas working!${N}" || echo -e "  ${Y}Still down.${N}"; pause_key ;;
        4) banner; remount_rw
           if grep -q "minioverride" "$UI_CONF" 2>/dev/null; then
               echo -e "  ${D}ui.conf currently PATCHED.${N}"
               confirm_yn "Remove minioverride from ui.conf?" && {
                   grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp; cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
                   echo -e "  ${G}Removed. Reboot to apply.${N}"
               }
           else
               echo -e "  ${D}ui.conf currently UNPATCHED.${N}"
               confirm_yn "Add minioverride to ui.conf?" && { patch_ui_conf; echo -e "  ${G}Patched. Reboot to apply.${N}"; }
           fi; pause_key ;;
    esac
}

# ═══════════════════════════════════════════════════════════════
#  ── ROOT SHELL ───────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_root_shell() {
    printf '\033[?25h'
    banner; echo -e "  ${Y}Root shell. Type 'exit' to return.${N}\n"
    if [[ "$(id -u)" -eq 0 ]]; then
        bash --login
    elif doas_check 2>/dev/null; then
        doas bash
    elif sudo_check; then
        sudo bash
    else
        echo -e "  ${Y}No root method available. Shell as $(whoami).${N}\n"
        bash --login
    fi
    echo -e "\n  ${C}Back in cshell.${N}"; sleep 0.5
}

