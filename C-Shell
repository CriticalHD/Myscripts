pg_ssh_setup() {
    banner; echo -e "  ${W}── SSH / doas Setup ─────────────────────────────────${N}\n"
    local doas_ok; doas_check 2>/dev/null && doas_ok="${G}working${N}" || doas_ok="${R}NOT working${N}"
    echo -e "  ${C}doas status:${N} ${doas_ok}\n"
    draw_menu "SSH Options" \
        "Restart cshell sshd (port 1337)" \
        "Start public SSH (port 22)" \
        "Change chronos password" \
        "Change root password" \
        "Show authorized_keys" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           if doas_check 2>/dev/null; then
               doas "pkill -f 'sshd.*1337'; sleep 0.3; /usr/sbin/sshd -f $SSHD_CONF"
           else
               # We're chronos — can't write to /root. Show instructions.
               echo -e "  ${R}Cannot set up doas from chronos context.${N}"
               echo -e "  ${Y}To fix, go to VT2 (Ctrl+Alt+F2) and run:${N}"
               echo -e "  ${W}  /usr/local/bin/cshell${N}"
               echo -e "  ${D}  (This will run as root from VT2)${N}"
           fi
           pause_key ;;
        1) doas_check 2>/dev/null \
               && doas "/usr/sbin/sshd 2>/dev/null" \
               || /usr/sbin/sshd 2>/dev/null
           echo -e "  ${G}sshd started on port 22.${N}"
           echo -e "  ${D}Connect: ssh chronos@$(hostname -I 2>/dev/null | awk '{print $1}')${N}"
