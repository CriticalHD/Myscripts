# ═══════════════════════════════════════════════════════════════
#  FILE BROWSER — paginated, execute .sh support
# ═══════════════════════════════════════════════════════════════
pg_file_browser() {
    local cur="${1:-/}"
    local page_size=22
    local page_offset=0

    while true; do
        local all_entries=()
        [[ "$cur" != "/" ]] && all_entries+=("↑  ..")
        while IFS= read -r name; do
            local fp="${cur%/}/${name}"
            if [[ -d "$fp" ]]; then
                all_entries+=("📁 ${name}/")
            else
                local sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                all_entries+=("📄 ${name}  [${sz:-?}]")
            fi
        done < <(ls -1p "$cur" 2>/dev/null)

        local total=${#all_entries[@]}
        local show=()
        local i
        for (( i=page_offset; i<page_offset+page_size && i<total; i++ )); do
            show+=("${all_entries[$i]}")
        done
        (( page_offset + page_size < total )) && show+=("▼  More... ($(( total-page_offset-page_size )) more)")
        (( page_offset > 0 )) && show+=("▲  Previous page")
        show+=("← Exit")

        local pg_info="[$(( page_offset+1 ))-$(( page_offset+page_size < total ? page_offset+page_size : total ))/${total}]"
        draw_menu "Files: ${cur}  ${pg_info}" "${show[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return

        local chosen="${show[$MENU_RESULT]}"
        case "$chosen" in
            "▼  More"*)  (( page_offset += page_size )) ;;
            "▲  Previous"*) (( page_offset -= page_size )); (( page_offset < 0 )) && page_offset=0 ;;
            "← Exit") return ;;
            "↑  ..")   cur=$(dirname "$cur"); page_offset=0 ;;
            "📁 "*)
                local dn="${chosen#📁 }"; dn="${dn%/}"
                cur="${cur%/}/${dn}"; page_offset=0 ;;
            "📄 "*)
                local fn="${chosen#📄 }"; fn="${fn%%  *}"
                local fp="${cur%/}/${fn}"
                local ext="${fn##*.}"
                local is_sh=0; [[ "$ext" == "sh" || "$ext" == "bash" ]] && is_sh=1
                [[ -x "$fp" ]] && is_sh=1

                local file_opts=("View (tail 50)" "View (head 50)" "Edit (nano/vi)" "Delete" "File info" "Copy path")
                [[ $is_sh -eq 1 ]] && file_opts=("Execute script" "${file_opts[@]}")
                file_opts+=("← Back")

                draw_menu "$fn" "${file_opts[@]}"
                local fidx=$MENU_RESULT
                # Adjust for execute offset
                local base_offset=0; [[ $is_sh -eq 1 ]] && base_offset=1
                if [[ $is_sh -eq 1 && $fidx -eq 0 ]]; then
                    banner; echo -e "  ${Y}Executing $fp ...${N}\n"
                    bash "$fp"; echo -e "\n  ${G}Script finished.${N}"; pause_key
                else
                    local adj=$(( fidx - base_offset ))
                    case $adj in
                        0) banner; tail -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                        1) banner; head -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                        2) root_available && root_run "command -v nano &>/dev/null && nano '$fp' || vi '$fp'" \
                               || { command -v nano &>/dev/null && nano "$fp" || vi "$fp"; } ;;
                        3) confirm_yn "Delete $fp?" && { root_run "rm -f '$fp'" && echo -e "  ${G}Deleted.${N}"; }; pause_key ;;
                        4) banner; ls -lah "$fp" 2>/dev/null; file "$fp" 2>/dev/null; pause_key ;;
                        5) echo -e "  ${W}$fp${N}"; pause_key ;;
                    esac
                fi ;;
        esac
    done
}

