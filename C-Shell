#!/bin/bash
_SELF_PAYLOAD=""
# cshell v3.1 — Custom ChromeOS Shell

SHELL_PATH="/usr/local/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
ROOTKEY="/usr/local/cshell_rootkey"
ROOTKEY_PUB="/usr/local/cshell_rootkey.pub"
SSHD_CONF="/usr/local/cshell_sshd.conf"
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
UI_CONF="/etc/init/ui.conf"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
VERSION="3.1"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
C='\033[0;36m'; W='\033[1;37m'; D='\033[2m'
N='\033[0m';    V='\033[7m'

trap '' INT

remount_rw() {
    mount -o remount,rw /    2>/dev/null || true
    mount -o remount,rw /usr 2>/dev/null || true
    mount -o remount,rw /etc 2>/dev/null || true
}

tread()  { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null || echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}

pause_key() { echo -e "\n  ${D}Press any key...${N}"; tread1 _k; }

confirm_yn() {
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a
    [[ "$_a" =~ ^[Yy]$ ]]
}

# ════════════════════════════════════════════════════════════════
#  MENU — flicker-free in-place rendering
#  Key fix: read the FULL escape sequence in one shot,
#  only redraw the changed line (not the whole screen).
# ════════════════════════════════════════════════════════════════
draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}

    if [[ ! -t 0 || ! -t 1 ]]; then
        # Fallback numbered menu for piped/non-tty
        banner
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do echo -e "  ${C}$((i+1)))${N}  ${items[$i]}"; done
        echo ""
        echo -ne "  ${W}Select [1-${count}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch >= 1 && ch <= count )); then
            MENU_RESULT=$((ch-1))
        else
            MENU_RESULT=-1
        fi
        return
    fi

    local sel=0
    local prev_sel=-1

    # Draw full menu once
    _menu_draw_full() {
        clear
        printf '\033[?25l'  # hide cursor
        echo -e "${C}"
        echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
        echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
        echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
        echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
        echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
        echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
        echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null || echo chromebook)${N}"
        echo -e "  ${D}────────────────────────────────────────────────────${N}\n"
        echo -e "  ${W}${title}${N}\n"
        for i in "${!items[@]}"; do
            if [[ $i -eq $sel ]]; then
                echo -e "  ${V}${C}  ›  ${items[$i]}  ${N}"
            else
                echo -e "  ${D}     ${items[$i]}${N}"
            fi
        done
        echo -e "\n  ${D}↑↓ navigate   Enter select   Q quit${N}"
    }

    # Redraw only two lines: old selection and new selection
    # Header is 11 lines (banner=9 + blank + title + blank = 12 lines before items)
    _menu_draw_header_lines=12
    _menu_update_line() {
        local idx="$1" highlight="$2"
        local line=$(( _menu_draw_header_lines + idx + 1 ))
        printf '\033[%d;1H\033[2K' "$line"  # move to line, clear it
        if [[ $highlight -eq 1 ]]; then
            printf "  ${V}${C}  ›  ${items[$idx]}  ${N}\n"
        else
            printf "  ${D}     ${items[$idx]}${N}\n"
        fi
    }

    _menu_draw_full
    prev_sel=$sel

    while true; do
        # Read a keypress — get full escape sequence atomically
        local key seq
        IFS= read -rsn1 key </dev/tty 2>/dev/null
        if [[ "$key" == $'\x1b' ]]; then
            # Read rest of escape sequence with short timeout
            IFS= read -rsn5 -t 0.05 seq </dev/tty 2>/dev/null
            key="${key}${seq}"
        fi

        local new_sel=$sel
        case "$key" in
            $'\x1b[A'|$'\x1bOA') # Up
                (( new_sel > 0 )) && (( new_sel-- )) ;;
            $'\x1b[B'|$'\x1bOB') # Down
                (( new_sel < count-1 )) && (( new_sel++ )) ;;
            $'\x1b[5~') # Page Up — jump up 5
                new_sel=$(( sel - 5 < 0 ? 0 : sel - 5 )) ;;
            $'\x1b[6~') # Page Down — jump down 5
                new_sel=$(( sel + 5 >= count ? count-1 : sel + 5 )) ;;
            $'\x1b[H'|$'\x1b[1~') # Home
                new_sel=0 ;;
            $'\x1b[F'|$'\x1b[4~') # End
                new_sel=$(( count - 1 )) ;;
            ''|$'\n'|$'\r') # Enter
                printf '\033[?25h'  # show cursor
                MENU_RESULT=$sel; return ;;
            'q'|'Q'|$'\x03'|$'\x1b\x1b') # q/Q/Ctrl-C/double-ESC
                printf '\033[?25h'
                MENU_RESULT=-1; return ;;
        esac

        # Only redraw if selection changed
        if [[ $new_sel -ne $sel ]]; then
            _menu_update_line $sel 0      # deselect old
            _menu_update_line $new_sel 1  # select new
            sel=$new_sel
        fi
    done
}

# ════════════════════════════════════════════════════════════════
#  DOAS — mush-style root via SSH on port 1337
# ════════════════════════════════════════════════════════════════
doas() {
    ssh -t -p 1337 \
        -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR \
        -oConnectTimeout=3 \
        root@127.0.0.1 "$@"
}

doas_check() {
    [[ ! -f "$ROOTKEY" ]] && return 1
    ssh -p 1337 \
        -i "$ROOTKEY" \
        -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null \
        -oLogLevel=ERROR \
        -oConnectTimeout=2 \
        -oBatchMode=yes \
        root@127.0.0.1 "true" 2>/dev/null
}

# Must be called AS ROOT
setup_root_sshd() {
    mkdir -p /usr/local/bin

    # Generate keypair if needed
    if [[ ! -f "$ROOTKEY" || ! -f "$ROOTKEY_PUB" ]]; then
        rm -f "$ROOTKEY" "$ROOTKEY_PUB"
        ssh-keygen -t ed25519 -f "$ROOTKEY" -N "" -q 2>/dev/null
    fi
    chmod 600 "$ROOTKEY"
    chmod 644 "$ROOTKEY_PUB"

    # Write sshd config
    cat > "$SSHD_CONF" << EOF
Port 1337
ListenAddress 127.0.0.1
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile $ROOTKEY_PUB
PermitRootLogin yes
PasswordAuthentication no
PubkeyAuthentication yes
AllowUsers root
LogLevel ERROR
UsePAM no
PrintMotd no
PrintLastLog no
EOF
    chmod 600 "$SSHD_CONF"

    # Authorize key for root
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    local pubkey; pubkey=$(cat "$ROOTKEY_PUB")
    touch /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
    grep -qF "$pubkey" /root/.ssh/authorized_keys 2>/dev/null \
        || echo "$pubkey" >> /root/.ssh/authorized_keys

    # Host key
    [[ -f /etc/ssh/ssh_host_ed25519_key ]] \
        || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null

    # Kill old, start new
    pkill -f "sshd.*1337" 2>/dev/null || true
    sleep 0.2
    /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null
    sleep 0.5
}

ensure_doas() {
    doas_check && return 0

    # We need root to set this up — try all available paths
    if [[ "$(id -u)" -eq 0 ]]; then
        setup_root_sshd
        doas_check && return 0
    fi

    # Try minioverride sudo
    if sudo -n bash -c "$(declare -f setup_root_sshd); \
        ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; \
        SSHD_CONF='$SSHD_CONF'; setup_root_sshd" 2>/dev/null; then
        sleep 0.5; doas_check && return 0
    fi

    return 1
}

# ════════════════════════════════════════════════════════════════
#  INSTALL HELPERS
# ════════════════════════════════════════════════════════════════
check_rootfs() {
    remount_rw
    if touch /usr/bin/.rw_test 2>/dev/null; then rm -f /usr/bin/.rw_test; return 0; fi
    banner
    echo -e "  ${Y}Rootfs is read-only. Disable verification?${N}\n"
    confirm_yn "Run make_dev_ssd.sh now?" && {
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}Done. Reboot then re-run.${N}"
        confirm_yn "Reboot now?" && reboot
        exit 0
    }
    echo -e "${R}Cannot continue.${N}"; exit 1
}

C_SRC='int minijail_no_new_privs(void){return 0;}
int minijail_add_fs_restriction_rx(void){return 0;}
int minijail_add_fs_restriction_advanced_rw(void){return 0;}
int minijail_set_enable_profile_fs_restrictions(void){return 0;}
int minijail_enable_default_fs_restrictions(void){return 0;}'

build_minioverride() {
    printf '%s' "$C_SRC" > /tmp/_mo.c
    for cc in gcc tcc cc; do
        command -v "$cc" &>/dev/null || continue
        $cc -shared -fPIC /tmp/_mo.c -o "$OVERRIDE_SO" 2>/dev/null \
            && rm -f /tmp/_mo.c && chmod 755 "$OVERRIDE_SO" && return 0
    done
    rm -f /tmp/_mo.c
    curl -sSfL \
        "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/minioverride.so" \
        -o "$OVERRIDE_SO" 2>/dev/null && [[ -s "$OVERRIDE_SO" ]] && return 0
    return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return
    grep -q "minioverride" "$UI_CONF" 2>/dev/null \
        && { echo -e "${D}    ui.conf already patched.${N}"; return; }
    { echo "env LD_PRELOAD=/usr/local/bin/minioverride.so"; cat "$UI_CONF"; } > /tmp/_ui.tmp
    cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    echo -e "${G}    Patched ui.conf (sudo backup fix).${N}"
    NEEDS_REBOOT=1
}

write_self_to() {
    local dest="$1"
    echo "$_SELF_PAYLOAD" | base64 -d > "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    local src="${BASH_SOURCE[0]:-$0}"
    [[ -f "$src" && "$src" != "bash" ]] && cp "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    for fd in 255 254 253; do
        [[ -r "/proc/$$/fd/$fd" ]] && cp "/proc/$$/fd/$fd" "$dest" 2>/dev/null \
            && [[ -s "$dest" ]] && return 0
    done
    return 1
}

install_persistence() {
    # Copy everything important to rootfs (survives powerwash)
    cp "$SHELL_PATH"   "$ROOTFS_SHELL"              2>/dev/null && chmod +x "$ROOTFS_SHELL"
    cp "$ROOTKEY"      /usr/bin/cshell_rootkey      2>/dev/null && chmod 600 /usr/bin/cshell_rootkey
    cp "$ROOTKEY_PUB"  /usr/bin/cshell_rootkey.pub  2>/dev/null
    cp "$SSHD_CONF"    /usr/bin/cshell_sshd.conf    2>/dev/null
    [[ -f "$OVERRIDE_SO" ]] && cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null

    cat > "$INIT_SCRIPT" << 'UPSTART'
description "cshell post-boot restore"
start on started system-services
task
script
    # Restore cshell binary
    [ -f /usr/local/bin/cshell ] || {
        mkdir -p /usr/local/bin
        cp /usr/bin/cshell_rootfs /usr/local/bin/cshell 2>/dev/null
        chmod +x /usr/local/bin/cshell 2>/dev/null
    }
    # Restore crosh stub
    grep -q "cshell" /usr/bin/crosh 2>/dev/null || {
        printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > /usr/bin/crosh
        chmod +x /usr/bin/crosh
    }
    # Restore SSH keys
    [ -f /usr/local/cshell_rootkey ] || {
        cp /usr/bin/cshell_rootkey     /usr/local/cshell_rootkey     2>/dev/null
        cp /usr/bin/cshell_rootkey.pub /usr/local/cshell_rootkey.pub 2>/dev/null
        cp /usr/bin/cshell_sshd.conf   /usr/local/cshell_sshd.conf   2>/dev/null
        chmod 600 /usr/local/cshell_rootkey 2>/dev/null
    }
    # Restore minioverride
    [ -f /usr/local/bin/minioverride.so ] || {
        [ -f /usr/bin/minioverride.so ] && {
            cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so
            chmod 755 /usr/local/bin/minioverride.so
        }
    }
    # Re-authorize root SSH key
    ROOTKEY_PUB=/usr/local/cshell_rootkey.pub
    SSHD_CONF=/usr/local/cshell_sshd.conf
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
    pubkey=$(cat "$ROOTKEY_PUB" 2>/dev/null)
    [ -n "$pubkey" ] && {
        grep -qF "$pubkey" /root/.ssh/authorized_keys 2>/dev/null \
            || echo "$pubkey" >> /root/.ssh/authorized_keys
    }
    # Generate host key if missing
    [ -f /etc/ssh/ssh_host_ed25519_key ] || \
        ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null
    # Start sshd on port 1337
    pkill -f "sshd.*1337" 2>/dev/null || true
    sleep 0.2
    [ -f "$SSHD_CONF" ] && /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null
end script
UPSTART
    echo -e "${G}    Persistence + auto-sshd installed (survives powerwash).${N}"
}

# ════════════════════════════════════════════════════════════════
#  INSTALL / DELETE / RESTORE
# ════════════════════════════════════════════════════════════════
do_install() {
    banner
    echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}[!] Must be root.${N}" && exit 1
    echo -e "${D}    Checking rootfs...${N}"; check_rootfs
    mkdir -p /usr/local/bin

    echo -e "${D}    Writing cshell...${N}"
    if write_self_to "$SHELL_PATH"; then
        chmod +x "$SHELL_PATH"
        echo -e "${G}    Written to ${SHELL_PATH}${N}"
    else
        echo -e "${R}[!] Could not write cshell.${N}"; exit 1
    fi

    # Setup doas FIRST (we are root here, so it will work)
    echo -e "${D}    Setting up root SSH (port 1337)...${N}"
    setup_root_sshd
    if doas_check; then
        echo -e "${G}    doas working!${N}"
    else
        echo -e "${Y}    doas not confirmed yet — will activate on reboot.${N}"
    fi

    # minioverride as sudo backup
    NEEDS_REBOOT=0
    echo -e "${D}    Building minioverride.so...${N}"
    if build_minioverride; then
        patch_ui_conf
        echo -e "${G}    minioverride.so built.${N}"
    else
        echo -e "${Y}    minioverride build failed — doas handles root.${N}"
    fi

    install_persistence

    # Crosh stub — no sudo, runs cshell directly
    [[ ! -f "$CROSH_BACKUP" ]] && cp "$CROSH_PATH" "$CROSH_BACKUP" 2>/dev/null
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > "$CROSH_PATH"
    chmod +x "$CROSH_PATH"
    echo -e "${G}    Crosh stub installed.${N}\n"

    echo -e "${G}[+] Done! Open crosh (Ctrl+Alt+T) to launch.${N}"
    [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "${Y}[!] Reboot recommended.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_delete() {
    banner; echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { doas_check && doas "bash $SHELL_PATH --delete" && exit 0; \
        exec sudo "$0" --delete 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw
    pkill -f "sshd.*1337" 2>/dev/null || true
    [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" && {
        grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp
        cp /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
    }
    rm -f "$SHELL_PATH" "$ROOTFS_SHELL" "$INIT_SCRIPT" "$ROOTKEY" "$ROOTKEY_PUB" \
          "$SSHD_CONF" "$OVERRIDE_SO" /usr/bin/minioverride.so \
          /usr/bin/cshell_rootkey /usr/bin/cshell_rootkey.pub /usr/bin/cshell_sshd.conf
    echo -e "${G}[+] Deleted.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_restore_crosh() {
    banner; echo -e "${Y}[*] Restoring crosh...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { doas_check && doas "bash $SHELL_PATH --restore" && exit 0; \
        exec sudo "$0" --restore 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw
    if [[ -f "$CROSH_BACKUP" ]]; then
        rm -f "$CROSH_PATH"; cp "$CROSH_BACKUP" "$CROSH_PATH"; chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"; echo -e "${G}[+] Crosh restored.${N}"
    else
        echo -e "${R}[!] No backup found.${N}"
    fi
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

# ════════════════════════════════════════════════════════════════
#  SHELL PAGES
