#!/bin/bash
# cshell v4.4 — Custom ChromeOS Shell
# Landlock-safe install: writes via stateful partition + python3 fallback

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

SHELL_PATH="/usr/local/bin/cshell"
STATEFUL_SHELL="/mnt/stateful_partition/dev_image/bin/cshell"
CROSH_PATH="/usr/bin/crosh"
CROSH_BACKUP="/usr/bin/crosh.real"
ROOTKEY="/usr/local/cshell_rootkey"
ROOTKEY_PUB="/usr/local/cshell_rootkey.pub"
SSHD_CONF="/usr/local/cshell_sshd.conf"
ROOTFS_SHELL="/usr/bin/cshell_rootfs"
INIT_SCRIPT="/etc/init/cshell-restore.conf"
UI_CONF="/etc/init/ui.conf"
OVERRIDE_SO="/usr/local/bin/minioverride.so"
VERSION="4.4"

R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'
C='\033[0;36m'; W='\033[1;37m'; D='\033[2m'
N='\033[0m';    V='\033[7m'

trap '' INT

remount_rw() {
    mount -o remount,rw /    2>/dev/null || true
    mount -o remount,rw /usr 2>/dev/null || true
    mount -o remount,rw /etc 2>/dev/null || true
}
tread()  { read -r "$1" </dev/tty 2>/dev/null || read -r "$1"; }
tread1() { IFS= read -rsn1 "$1" </dev/tty 2>/dev/null || IFS= read -rsn1 "$1"; }

banner() {
    clear
    echo -e "${C}"
    echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
    echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
    echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
    echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
    echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
    echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
    echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null||echo chromebook)${N}"
    echo -e "  ${D}────────────────────────────────────────────────────${N}"
    echo ""
}
pause_key() { echo -e "\n  ${D}Press any key...${N}"; tread1 _k; }
confirm_yn() {
    echo -ne "  ${Y}$1 [y/N]:${N} "
    local _a; tread _a; [[ "$_a" =~ ^[Yy]$ ]]
}

# ════════════════════════════════════════════════════════════════
#  SAFE WRITE — bypasses Landlock LSM
#  Landlock restricts the /usr path in shell processes.
#  Fix: write via /mnt/stateful_partition/dev_image (same inode,
#  different path — Landlock path-based restriction doesn't apply)
#  Fallback: use python3 open() which isn't Landlock-restricted
# ════════════════════════════════════════════════════════════════
safe_write() {
    local src="$1" dest="$2"
    # Method 1: direct write (works if landlock not active or minioverride installed)
    cp "$src" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    # Method 2: write via stateful partition path (bypasses landlock path restriction)
    local sp_dest="${dest/\/usr\/local\/bin\//\/mnt\/stateful_partition\/dev_image\/bin\/}"
    sp_dest="${sp_dest/\/usr\/local\//\/mnt\/stateful_partition\/dev_image\/}"
    if [[ "$sp_dest" != "$dest" ]]; then
        mkdir -p "$(dirname "$sp_dest")" 2>/dev/null
        cp "$src" "$sp_dest" 2>/dev/null && [[ -s "$sp_dest" ]] && {
            # Verify the bind mount shows it
            [[ -s "$dest" ]] && return 0
        }
    fi
    # Method 3: python3 write (not subject to shell's landlock restrictions)
    python3 -c "
import shutil, sys
try:
    shutil.copy2('$src', '$dest')
    print('ok')
except Exception as e:
    sys.stderr.write(str(e)+'\n')
    sys.exit(1)
" 2>/dev/null && [[ -s "$dest" ]] && return 0
    # Method 4: dd via /proc/self/exe approach
    dd if="$src" of="$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    return 1
}

safe_write_content() {
    # Write content string/stdin to a dest file, bypassing Landlock
    local dest="$1" content="$2"
    local tmp; tmp=$(mktemp /tmp/cshell_XXXXXX)
    printf '%s' "$content" > "$tmp"
    safe_write "$tmp" "$dest"
    local r=$?; rm -f "$tmp"; return $r
}

safe_write_stdin() {
    # Write stdin to dest, bypassing Landlock
    local dest="$1"
    local tmp; tmp=$(mktemp /tmp/cshell_XXXXXX)
    cat > "$tmp"
    safe_write "$tmp" "$dest"
    local r=$?; rm -f "$tmp"; return $r
}

# ════════════════════════════════════════════════════════════════
#  SELF-WRITE — extract our own content and install to dest
# ════════════════════════════════════════════════════════════════
write_self_to() {
    local dest="$1"
    local me="${BASH_SOURCE[0]:-$0}"
    # Method 1: real file on disk (now works thanks to the pipe handler above)
    if [[ -f "$me" && "$me" != "bash" && "$me" != "/bin/bash" ]]; then
        cp "$me" "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
    fi
    # Method 2: payload extraction (keeps original self-extract working)
    local pline; pline=$(_get_payload_line "$me")
    if [[ -n "$pline" ]]; then
        tail -n +"$((pline+1))" "$me" | base64 -d > "$dest" 2>/dev/null \
            && [[ -s "$dest" ]] && return 0
    fi
    # Method 3: bash fd fallback
    for fd in 255 254 253; do
        [[ -r "/proc/ \]/fd/$fd" ]] && cp "/proc/$$/fd/$fd" "$dest" 2>/dev/null \
            && [[ -s "$dest" ]] && return 0
    done
    # Ultimate fallback: re-download self (makes installer 100% reliable)
    curl -sSL -o "$dest" "https://raw.githubusercontent.com/CriticalHD/Myscripts/refs/heads/main/C-Shell" 2>/dev/null \
        && [[ -s "$dest" ]] && return 0
    return 1
}
# ════════════════════════════════════════════════════════════════
#  MENU — crosh+VT2 compatible
# ════════════════════════════════════════════════════════════════
_IN_CROSH=0
_detect_crosh() {
    local p=$PPID
    for _ in 1 2 3 4; do
        local comm; comm=$(cat /proc/${p}/comm 2>/dev/null)
        [[ "$comm" == "crosh" ]] && { _IN_CROSH=1; return; }
        p=$(awk '/PPid/{print $2}' /proc/${p}/status 2>/dev/null)
        [[ -z "$p" || "$p" == "0" ]] && break
    done
}
_is_sep() { [[ "${1:0:3}" == "───" ]]; }

draw_menu() {
    local title="$1"; shift
    local items=("$@")
    local count=${#items[@]}
    local sel_idx=()
    for i in "${!items[@]}"; do _is_sep "${items[$i]}" || sel_idx+=("$i"); done
    local sc=${#sel_idx[@]}
    [[ $sc -eq 0 ]] && { MENU_RESULT=-1; return; }

    if [[ ! -t 0 || ! -t 1 ]]; then
        banner; echo -e "  ${W}${title}${N}\n"
        local n=0
        for i in "${!items[@]}"; do
            _is_sep "${items[$i]}" && continue
            echo -e "  ${C}$((++n)))${N}  ${items[$i]}"
        done
        echo ""; echo -ne "  ${W}Select [1-${n}]:${N} "
        local ch; tread ch
        if [[ "$ch" =~ ^[0-9]+$ ]] && (( ch>=1 && ch<=n )); then
            MENU_RESULT=${sel_idx[$((ch-1))]}
        else
            MENU_RESULT=-1
        fi
        return
    fi

    local pos=0
    local HL=12

    _full() {
        clear; printf '\033[?25l'
        echo -e "${C}"
        echo "   ██████╗███████╗██╗  ██╗███████╗██╗     ██╗     "
        echo "  ██╔════╝██╔════╝██║  ██║██╔════╝██║     ██║     "
        echo "  ██║     ███████╗███████║█████╗  ██║     ██║     "
        echo "  ██║     ╚════██║██╔══██║██╔══╝  ██║     ██║     "
        echo "  ╚██████╗███████║██║  ██║███████╗███████╗███████╗"
        echo "   ╚═════╝╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚══════╝"
        echo -e "${N}  ${W}Custom ChromeOS Shell${N} ${D}v${VERSION}${N}  |  ${G}$(whoami)@$(hostname -s 2>/dev/null||echo chromebook)${N}"
        echo -e "  ${D}────────────────────────────────────────────────────${N}\n"
        echo -e "  ${W}${title}${N}\n"
        local cur=${sel_idx[$pos]}
        for i in "${!items[@]}"; do
            if _is_sep "${items[$i]}"; then printf "  \033[2m%s\033[0m\n" "${items[$i]}"
            elif [[ $i -eq $cur ]];   then printf "  \033[7m\033[0;36m  >  %s  \033[0m\n" "${items[$i]}"
            else                           printf "  \033[2m     %s\033[0m\n" "${items[$i]}"
            fi
        done
        printf "\n  \033[2mup/down  Enter select  Q quit\033[0m\n"
    }
    _patch() {
        local ii=$1 hi=$2
        printf '\033[%d;1H\033[2K' "$(( HL+ii+1 ))"
        if   _is_sep "${items[$ii]}"; then printf "  \033[2m%s\033[0m\n" "${items[$ii]}"
        elif [[ $hi -eq 1 ]];         then printf "  \033[7m\033[0;36m  >  %s  \033[0m\n" "${items[$ii]}"
        else                               printf "  \033[2m     %s\033[0m\n" "${items[$ii]}"
        fi
    }
    _full
    while true; do
        local raw=""; IFS= read -rsn1 raw </dev/tty 2>/dev/null
        if [[ "$raw" == $'\x1b' ]]; then
            local r2; IFS= read -rsn4 -t 0.04 r2 </dev/tty 2>/dev/null
            raw="${raw}${r2}"
        fi
        local np=$pos
        case "$raw" in
            $'\x1b[A'|$'\x1bOA') (( np>0 )) && (( np-- )) ;;
            $'\x1b[B'|$'\x1bOB') (( np<sc-1 )) && (( np++ )) ;;
            $'\x1b[5~') np=$(( pos-5<0?0:pos-5 )) ;;
            $'\x1b[6~') np=$(( pos+5>=sc?sc-1:pos+5 )) ;;
            $'\x1b[H'|$'\x1bOH') np=0 ;;
            $'\x1b[F'|$'\x1bOF') np=$(( sc-1 )) ;;
            ''|$'\n'|$'\r') printf '\033[?25h'; MENU_RESULT=${sel_idx[$pos]}; return ;;
            'q'|'Q'|$'\x03'|$'\x1b\x1b') printf '\033[?25h'; MENU_RESULT=-1; return ;;
        esac
        if [[ $np -ne $pos ]]; then
            if [[ $_IN_CROSH -eq 1 ]]; then pos=$np; _full
            else _patch "${sel_idx[$pos]}" 0; _patch "${sel_idx[$np]}" 1; pos=$np; fi
        fi
    done
}

# ════════════════════════════════════════════════════════════════
#  ROOT ACCESS
# ════════════════════════════════════════════════════════════════
_rsh() {
    ssh -t -p 1337 -i "$ROOTKEY" -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null -oLogLevel=ERROR -oConnectTimeout=3 \
        root@127.0.0.1 "$@"
}
_rsh_ok() {
    [[ ! -f "$ROOTKEY" ]] && return 1
    ssh -p 1337 -i "$ROOTKEY" -oStrictHostKeyChecking=no \
        -oUserKnownHostsFile=/dev/null -oLogLevel=ERROR \
        -oConnectTimeout=2 -oBatchMode=yes root@127.0.0.1 "true" 2>/dev/null
}
_sudo_ok() {
    sudo -n true 2>/dev/null && return 0
    timeout 2 sudo true </dev/tty >/dev/null 2>&1 && return 0
    return 1
}
root_run() {
    if   [[ "$(id -u)" -eq 0 ]]; then bash -c "$*"
    elif _rsh_ok 2>/dev/null;    then _rsh "$*"
    elif _sudo_ok;               then sudo bash -c "$*"
    else return 1; fi
}
root_available() { [[ "$(id -u)" -eq 0 ]] || _rsh_ok 2>/dev/null || _sudo_ok; }
root_status_plain() {
    if   [[ "$(id -u)" -eq 0 ]]; then echo "[root]"
    elif _rsh_ok 2>/dev/null;    then echo "[root:tunnel]"
    elif _sudo_ok;               then echo "[root:sudo]"
    else echo "[limited]"; fi
}

setup_root_sshd() {
    [[ "$(id -u)" -ne 0 ]] && return 1
    mkdir -p /usr/local/bin
    [[ ! -f "$ROOTKEY" ]] && ssh-keygen -t ed25519 -f "$ROOTKEY" -N "" -q 2>/dev/null
    chmod 600 "$ROOTKEY"; chmod 644 "$ROOTKEY_PUB"
    cat > "$SSHD_CONF" << EOF
Port 1337
ListenAddress 127.0.0.1
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile $ROOTKEY_PUB
PermitRootLogin yes
PasswordAuthentication no
PubkeyAuthentication yes
AllowUsers root
LogLevel ERROR
UsePAM no
PrintMotd no
PrintLastLog no
EOF
    chmod 600 "$SSHD_CONF"
    mkdir -p /root/.ssh; chmod 700 /root/.ssh
    local pub; pub=$(cat "$ROOTKEY_PUB")
    touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
    grep -qF "$pub" /root/.ssh/authorized_keys 2>/dev/null || echo "$pub" >> /root/.ssh/authorized_keys
    [[ -f /etc/ssh/ssh_host_ed25519_key ]] \
        || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null
    pkill -f "sshd.*1337" 2>/dev/null; sleep 0.2
    /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null; sleep 0.5
}

install_minioverride() {
    local arch=$(uname -m); local url; local tmp; tmp=$(mktemp /tmp/mo.XXXXXX)
    case "$arch" in
        x86_64)  url="https://github.com/shadowed1/sudoCrosh/raw/main/x86_64_minioverride.so" ;;
        aarch64) url="https://github.com/shadowed1/sudoCrosh/raw/main/aarch64_minioverride.so" ;;
        *) return 1 ;;
    esac
    # Download to /tmp first (always works), then safe_write to dest
    curl -sSfL "$url" -o "$tmp" 2>/dev/null && [[ -s "$tmp" ]] && {
        safe_write "$tmp" "$OVERRIDE_SO" && chmod 755 "$OVERRIDE_SO" && rm -f "$tmp" && return 0
    }
    rm -f "$tmp"
    # Try compile
    local csrc='/tmp/_mo.c'
    printf 'int minijail_no_new_privs(void){return 0;}\nint minijail_add_fs_restriction_rx(void){return 0;}\nint minijail_add_fs_restriction_advanced_rw(void){return 0;}\nint minijail_set_enable_profile_fs_restrictions(void){return 0;}\nint minijail_enable_default_fs_restrictions(void){return 0;}' > "$csrc"
    local ctmp; ctmp=$(mktemp /tmp/mo.XXXXXX)
    for cc in gcc tcc cc; do
        command -v "$cc" &>/dev/null && $cc -shared -fPIC "$csrc" -o "$ctmp" 2>/dev/null \
            && [[ -s "$ctmp" ]] && { safe_write "$ctmp" "$OVERRIDE_SO" && chmod 755 "$OVERRIDE_SO"
                rm -f "$csrc" "$ctmp"; return 0; }
    done
    rm -f "$csrc" "$ctmp"; return 1
}

patch_ui_conf() {
    [[ ! -f "$UI_CONF" ]] && return 1
    grep -q "minioverride" "$UI_CONF" 2>/dev/null && return 0
    local tmp; tmp=$(mktemp /tmp/ui.XXXXXX)
    { echo "env LD_PRELOAD=/usr/local/bin/minioverride.so"; cat "$UI_CONF"; } > "$tmp"
    safe_write "$tmp" "$UI_CONF"; rm -f "$tmp"; NEEDS_REBOOT=1
}

check_rootfs() {
    remount_rw
    # Test write via safe path
    local t; t=$(mktemp /tmp/rwtest.XXXXXX)
    echo "test" > "$t"
    safe_write "$t" /usr/bin/.rw_test 2>/dev/null && rm -f /usr/bin/.rw_test "$t" && return 0
    rm -f "$t"
    banner; echo -e "  ${Y}Rootfs is read-only.${N}\n"
    confirm_yn "Run make_dev_ssd.sh?" && {
        /usr/share/vboot/bin/make_dev_ssd.sh --remove_rootfs_verification 2>&1 \
            | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n${G}Done. Reboot then re-run.${N}"; confirm_yn "Reboot now?" && reboot; exit 0
    }
    echo -e "${R}Cannot continue.${N}"; exit 1
}

install_persistence() {
    local tmp; tmp=$(mktemp /tmp/cshell_XXXXXX)
    # Rootfs copies (survive powerwash)
    cp "$SHELL_PATH" "$tmp" 2>/dev/null; safe_write "$tmp" "$ROOTFS_SHELL"; chmod +x "$ROOTFS_SHELL" 2>/dev/null
    cp "$ROOTKEY"    "$tmp" 2>/dev/null; safe_write "$tmp" /usr/bin/cshell_rootkey;    chmod 600 /usr/bin/cshell_rootkey 2>/dev/null
    cp "$ROOTKEY_PUB" "$tmp" 2>/dev/null; safe_write "$tmp" /usr/bin/cshell_rootkey.pub
    cp "$SSHD_CONF"  "$tmp" 2>/dev/null; safe_write "$tmp" /usr/bin/cshell_sshd.conf
    [[ -f "$OVERRIDE_SO" ]] && { cp "$OVERRIDE_SO" "$tmp" 2>/dev/null; safe_write "$tmp" /usr/bin/minioverride.so; }
    rm -f "$tmp"
    cat > /tmp/cshell_init.conf << 'UPSTART'
description "cshell post-boot restore"
start on started system-services
task
script
    [ -f /usr/local/bin/cshell ] || { mkdir -p /usr/local/bin; cp /usr/bin/cshell_rootfs /usr/local/bin/cshell 2>/dev/null; chmod +x /usr/local/bin/cshell; }
    grep -q "cshell" /usr/bin/crosh 2>/dev/null || { printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > /usr/bin/crosh; chmod +x /usr/bin/crosh; }
    [ -f /usr/local/cshell_rootkey ] || { cp /usr/bin/cshell_rootkey /usr/local/cshell_rootkey 2>/dev/null; cp /usr/bin/cshell_rootkey.pub /usr/local/cshell_rootkey.pub 2>/dev/null; cp /usr/bin/cshell_sshd.conf /usr/local/cshell_sshd.conf 2>/dev/null; chmod 600 /usr/local/cshell_rootkey 2>/dev/null; }
    [ -f /usr/local/bin/minioverride.so ] || { [ -f /usr/bin/minioverride.so ] && cp /usr/bin/minioverride.so /usr/local/bin/minioverride.so && chmod 755 /usr/local/bin/minioverride.so; }
    mkdir -p /root/.ssh; chmod 700 /root/.ssh; touch /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
    pub=$(cat /usr/local/cshell_rootkey.pub 2>/dev/null); [ -n "$pub" ] && grep -qF "$pub" /root/.ssh/authorized_keys 2>/dev/null || echo "$pub" >> /root/.ssh/authorized_keys
    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" -q 2>/dev/null
    pkill -f "sshd.*1337" 2>/dev/null; sleep 0.2
    [ -f /usr/local/cshell_sshd.conf ] && /usr/sbin/sshd -f /usr/local/cshell_sshd.conf 2>/dev/null
end script
UPSTART
    safe_write /tmp/cshell_init.conf "$INIT_SCRIPT"; rm -f /tmp/cshell_init.conf
    echo -e "${G}    Persistence installed (survives powerwash).${N}"
}

# ════════════════════════════════════════════════════════════════
#  INSTALL / DELETE / RESTORE
# ════════════════════════════════════════════════════════════════
do_install() {
    banner; echo -e "${Y}[*] Installing cshell v${VERSION}...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && echo -e "${R}Must be root.${N}" && exit 1
    echo -e "${D}    Checking rootfs...${N}"; check_rootfs

    # Ensure /usr/local/bin exists via stateful partition path
    local sp_bin="/mnt/stateful_partition/dev_image/bin"
    mkdir -p "$sp_bin" 2>/dev/null || mkdir -p /usr/local/bin 2>/dev/null

    echo -e "${D}    Writing cshell...${N}"
    if write_self_to /tmp/cshell_new && [[ -s /tmp/cshell_new ]]; then
        chmod +x /tmp/cshell_new
        safe_write /tmp/cshell_new "$SHELL_PATH" || {
            echo -e "${R}[!] Could not write to ${SHELL_PATH}${N}"
            echo -e "${Y}    Trying stateful partition path...${N}"
            cp /tmp/cshell_new "$sp_bin/cshell" 2>/dev/null && chmod +x "$sp_bin/cshell" \
                && echo -e "${G}    Written via stateful path${N}" \
                || { echo -e "${R}[!] Install failed. Run from VT2 after K-Patch.${N}"; rm -f /tmp/cshell_new; exit 1; }
        }
        rm -f /tmp/cshell_new
        echo -e "${G}    Written to ${SHELL_PATH}${N}"
    else
        echo -e "${R}[!] Could not extract script content.${N}"
        echo -e "${Y}    Try: bash <(curl -sSL <url>) instead of curl | bash${N}"
        exit 1
    fi

    echo -e "${D}    Setting up SSH root tunnel (port 1337)...${N}"
    setup_root_sshd
    _rsh_ok && echo -e "${G}    SSH root tunnel working!${N}" || echo -e "${Y}    Will activate on reboot.${N}"

    NEEDS_REBOOT=0
    echo -e "${D}    Installing minioverride.so...${N}"
    install_minioverride && { patch_ui_conf; echo -e "${G}    minioverride.so installed.${N}"; } \
        || echo -e "${Y}    minioverride failed -- SSH tunnel handles root.${N}"

    install_persistence

    [[ ! -f "$CROSH_BACKUP" ]] && cp "$CROSH_PATH" "$CROSH_BACKUP" 2>/dev/null
    rm -f "$CROSH_PATH"
    printf '#!/bin/bash\nexec /usr/local/bin/cshell\n' > /tmp/crosh_stub
    safe_write /tmp/crosh_stub "$CROSH_PATH"; chmod +x "$CROSH_PATH"; rm -f /tmp/crosh_stub
    echo -e "${G}    Crosh stub installed.\n\n[+] Done! Open crosh (Ctrl+Alt+T).${N}"
    [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "${Y}[!] Reboot for minioverride (sudo) to activate.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_delete() {
    banner; echo -e "${Y}[*] Deleting cshell...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { root_run "bash $SHELL_PATH --delete" 2>/dev/null && exit 0
        exec sudo "$0" --delete 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw; pkill -f "sshd.*1337" 2>/dev/null
    [[ -f "$UI_CONF" ]] && grep -q "minioverride" "$UI_CONF" && {
        grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp
        safe_write /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp; }
    rm -f "$SHELL_PATH" "$ROOTFS_SHELL" "$INIT_SCRIPT" "$ROOTKEY" "$ROOTKEY_PUB" \
          "$SSHD_CONF" "$OVERRIDE_SO" /usr/bin/minioverride.so \
          /usr/bin/cshell_rootkey /usr/bin/cshell_rootkey.pub /usr/bin/cshell_sshd.conf
    echo -e "${G}[+] Deleted.${N}"; echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

do_restore_crosh() {
    banner; echo -e "${Y}[*] Restoring crosh...${N}\n"
    [[ "$(id -u)" -ne 0 ]] && { root_run "bash $SHELL_PATH --restore" 2>/dev/null && exit 0
        exec sudo "$0" --restore 2>/dev/null || { echo -e "${R}Need root.${N}"; exit 1; }; }
    remount_rw
    [[ -f "$CROSH_BACKUP" ]] && { rm -f "$CROSH_PATH"
        safe_write "$CROSH_BACKUP" "$CROSH_PATH"; chmod +x "$CROSH_PATH"
        rm -f "$CROSH_BACKUP"; echo -e "${G}[+] Crosh restored.${N}"; } \
        || echo -e "${R}No backup.${N}"
    echo -ne "\n  ${D}Press any key...${N}"; tread1 _; echo ""; exit 0
}

# ════════════════════════════════════════════════════════════════
#  DIAGNOSTICS
# ════════════════════════════════════════════════════════════════
pg_sysinfo() {
    banner; echo -e "  ${W}── System Info ──────────────────────────────────────${N}\n"
    local board=$(grep CHROMEOS_RELEASE_BOARD /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local ver=$(grep CHROMEOS_RELEASE_VERSION /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local chan=$(grep CHROMEOS_RELEASE_TRACK /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local build=$(grep CHROMEOS_RELEASE_BUILD_NUMBER /etc/lsb-release 2>/dev/null | cut -d= -f2)
    local hwid=$(crossystem hwid 2>/dev/null | awk '{print $1}')
    local cpu=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs)
    local cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    local mt=$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mf=$(awk '/MemAvailable/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo)
    local mu=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f GB",(t-a)/1024/1024}' /proc/meminfo)
    local serial=$(vpd -l 2>/dev/null | grep '"serial_number"' | cut -d= -f2 | tr -d '"' 2>/dev/null||echo "n/a")
    echo -e "  ${C}Board:${N}        ${board:-?}"
    echo -e "  ${C}HWID:${N}         ${hwid:-?}"
    echo -e "  ${C}Serial:${N}       ${serial}"
    echo -e "  ${C}Version:${N}      ${ver:-?}  (${chan:-?})"
    echo -e "  ${C}Build:${N}        ${build:-?}"
    echo -e "  ${C}Kernel:${N}       $(uname -r) [$(uname -m)]"
    echo -e "  ${C}CPU:${N}          ${cpu:-?} x${cores}"
    echo -e "  ${C}RAM:${N}          ${mu} used / ${mf} free / ${mt} total"
    echo -e "  ${C}Uptime:${N}       $(uptime -p 2>/dev/null||uptime)"
    echo -e "  ${C}User:${N}         $(whoami) uid=$(id -u)"
    echo -e "  ${C}Root:${N}         $(root_status_plain)"
    echo -e "  ${C}Persistence:${N}  $([[ -f $INIT_SCRIPT ]] && echo "yes" || echo "no")"
    pause_key
}

pg_battery() {
    banner; echo -e "  ${W}── Battery ──────────────────────────────────────────${N}\n"
    local bat=""
    for p in /sys/class/power_supply/BAT* /sys/class/power_supply/BATC /sys/class/power_supply/bq*; do
        [[ -d "$p" ]] && bat="$p" && break
    done
    if [[ -n "$bat" ]]; then
        local st=$(cat "$bat/status" 2>/dev/null||echo "?")
        local cap=$(cat "$bat/capacity" 2>/dev/null||echo "?")
        local ef=$(cat "$bat/energy_full" 2>/dev/null)
        local ed=$(cat "$bat/energy_full_design" 2>/dev/null)
        local en=$(cat "$bat/energy_now" 2>/dev/null)
        local v=$(cat "$bat/voltage_now" 2>/dev/null)
        local i=$(cat "$bat/current_now" 2>/dev/null)
        local cyc=$(cat "$bat/cycle_count" 2>/dev/null)
        local mfr=$(cat "$bat/manufacturer" 2>/dev/null)
        local mdl=$(cat "$bat/model_name" 2>/dev/null)
        echo -e "  ${C}Status:${N}  $st  |  ${C}Charge:${N} ${cap}%"
        [[ -n "$mfr" ]] && echo -e "  ${C}Mfr:${N}     $mfr  ${mdl}"
        [[ -n "$cyc" && "$cyc" != "0" ]] && echo -e "  ${C}Cycles:${N}  $cyc"
        if [[ -n "$ef" && -n "$ed" && "$ed" -gt 0 ]]; then
            local h=$(awk "BEGIN{printf \"%.1f\",($ef/$ed)*100}")
            local hc=$G
            awk "BEGIN{exit !($h+0<80)}" 2>/dev/null && hc=$Y
            awk "BEGIN{exit !($h+0<60)}" 2>/dev/null && hc=$R
            echo -e "  ${C}Health:${N}  ${hc}${h}%${N}  ($(awk "BEGIN{printf \"%.2f\",$ef/1000000}") / $(awk "BEGIN{printf \"%.2f Wh\",$ed/1000000}"))"
        fi
        [[ -n "$en" ]] && echo -e "  ${C}Now:${N}     $(awk "BEGIN{printf \"%.2f Wh\",$en/1000000}")"
        [[ -n "$v"  ]] && echo -e "  ${C}Voltage:${N} $(awk "BEGIN{printf \"%.3f V\",$v/1000000}")"
        [[ -n "$i"  ]] && echo -e "  ${C}Draw:${N}    $(awk "BEGIN{printf \"%.0f mA\",$i/1000}")"
    fi
    root_available && { echo -e "\n  ${D}ectool:${N}"
        root_run "ectool batterystatus 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; }
    pause_key
}

pg_sensors() {
    banner; echo -e "  ${W}── Sensors ──────────────────────────────────────────${N}\n"
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [[ -f "$f" ]] || continue
        local zone=$(echo "$f"|grep -o 'zone[0-9]*')
        local type=$(cat "$(dirname $f)/type" 2>/dev/null||echo "?")
        local raw=$(cat "$f" 2>/dev/null||echo "0")
        local tc=$G; (( raw>70000 ))&&tc=$Y; (( raw>85000 ))&&tc=$R
        printf "  ${C}%-10s${N} %-22s ${tc}%.1f C${N}\n" "$zone" "($type)" "$(awk "BEGIN{print $raw/1000}")"
    done
    root_available && {
        echo -e "\n  ${D}Fan:${N}"
        root_run "ectool pwmgetfanrpm 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}EC temps:${N}"
        root_run "ectool temps all 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
    }
    pause_key
}

pg_net() {
    banner; echo -e "  ${W}── Network ──────────────────────────────────────────${N}\n"
    echo -e "  ${W}Interfaces:${N}"; ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Routes:${N}"; ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}DNS:${N}"; grep "^nameserver" /etc/resolv.conf 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[P] Ping  [T] Traceroute  [N] Connections  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        p|P) banner; ping -c 4 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) banner; traceroute -m 15 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        n|N) banner; ss -tunp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_wifi() {
    banner; echo -e "  ${W}── WiFi ─────────────────────────────────────────────${N}\n"
    local iface=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)
    [[ -z "$iface" ]] && { echo "  No wireless interface."; pause_key; return; }
    echo -e "  ${W}Interface: $iface${N}\n"
    iw dev "$iface" link 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}Signal:${N}"
    iw dev "$iface" station dump 2>/dev/null | grep -E "signal|tx bitrate|rx bitrate" | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_storage() {
    banner; echo -e "  ${W}── Storage ──────────────────────────────────────────${N}\n"
    df -h 2>/dev/null | grep -v "^tmpfs\|^devtmpfs\|^udev\|^overlay\|^shm\|^none" | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Block devices:${N}"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    pause_key
}

pg_memory() {
    banner; echo -e "  ${W}── Memory ───────────────────────────────────────────${N}\n"
    cat /proc/meminfo 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key
}

pg_procs() {
    banner; echo -e "  ${W}── Processes ────────────────────────────────────────${N}\n"
    ps aux --sort=-%cpu 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${D}[M] Mem  [K] Kill  [G] Grep  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        m|M) banner; ps aux --sort=-%mem 2>/dev/null | head -22 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        k|K) echo -ne "\n  ${Y}PID:${N} "; local pid; tread pid
             [[ "$pid" =~ ^[0-9]+$ ]] && { root_run "kill -9 $pid" && echo -e "  ${G}Killed $pid${N}" || kill -9 "$pid" 2>/dev/null; }; pause_key ;;
        g|G) echo -ne "\n  ${Y}Name:${N} "; local nm; tread nm
             ps aux 2>/dev/null | grep -i "$nm" | grep -v grep | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_cpu_stress() {
    banner; echo -e "  ${W}── CPU Stress Test ──────────────────────────────────${N}\n"
    confirm_yn "Stress all $(nproc) cores for 10s?" && {
        echo -e "\n  ${Y}Running...${N}"
        timeout 10 bash -c "for i in \$(seq 1 \$(nproc)); do while :; do :; done & done; wait" 2>/dev/null
        echo -e "  ${G}Done.${N}\n  ${D}Temps:${N}"
        for f in /sys/class/thermal/thermal_zone*/temp; do
            [[ -f "$f" ]] || continue
            printf "  %-22s %.1f C\n" "($(cat "$(dirname $f)/type" 2>/dev/null||echo ?))" \
                "$(awk "BEGIN{print $(cat $f)/1000}")"
        done
    } || echo -e "  ${D}Cancelled.${N}"; pause_key
}

pg_disk_bench() {
    banner; echo -e "  ${W}── Disk Benchmark ───────────────────────────────────${N}\n"
    confirm_yn "Write 128MB to /tmp?" && {
        echo -e "\n  ${D}Write:${N}"
        dd if=/dev/zero of=/tmp/_bench bs=1M count=128 conv=fdatasync 2>&1 | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}Read:${N}"
        dd if=/tmp/_bench of=/dev/null bs=1M 2>&1 | while IFS= read -r l; do echo "  $l"; done
        rm -f /tmp/_bench
    } || echo -e "  ${D}Cancelled.${N}"; pause_key
}

menu_diagnostics() {
    while true; do
        draw_menu "Diagnostics" \
            "System Info" "Battery Health" "Sensors / Temperature" \
            "Network" "WiFi" "Storage" "Memory Details" \
            "Processes" "CPU Stress Test" "Disk Benchmark" "< Back"
        case $MENU_RESULT in
            0) pg_sysinfo ;; 1) pg_battery ;; 2) pg_sensors ;;
            3) pg_net ;;     4) pg_wifi ;;   5) pg_storage ;; 6) pg_memory ;;
            7) pg_procs ;;   8) pg_cpu_stress ;; 9) pg_disk_bench ;;
            *) return ;;
        esac
    done
}

# ════════════════════════════════════════════════════════════════
