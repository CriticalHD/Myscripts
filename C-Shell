# Crossystem flags with inline edit
pg_crossystem_flags() {
    while true; do
        banner; echo -e "  ${W}── Crossystem Flags ─────────────────────────────────${N}\n"
        command -v crossystem &>/dev/null || { echo "  crossystem not available."; pause_key; return; }

        declare -A RW=([dev_boot_usb]=1 [dev_boot_signed_only]=1 [dev_boot_legacy]=1)
        local all=(devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur \
                   fwid ro_fwid mainfw_act mainfw_type tpm_kernver kernkey_vfy)
        local rw_list=()

        for key in "${all[@]}"; do
            local val=$(crossystem $key 2>/dev/null||echo "n/a")
            local vc=$D; [[ "$val" == "1" ]] && vc=$G
            local tag=""; [[ "${RW[$key]}" ]] && { tag=" ${C}[RW]${N}"; rw_list+=("$key"); }
            printf "  ${C}%-30s${N} ${vc}%-8s${N}%b\n" "$key" "$val" "$tag"
        done

        echo -e "\n  ${D}[E] Edit RW flag  [F] Full dump  [any] Back${N}"
        local k; tread1 k
        case "$k" in
            e|E)
                if ! root_available; then echo -e "  ${R}Need root to edit.${N}"; pause_key; continue; fi
                echo -e "\n  ${W}Editable flags:${N}"
                for i in "${!rw_list[@]}"; do echo -e "  ${C}$((i+1)))${N}  ${rw_list[$i]} = $(crossystem ${rw_list[$i]} 2>/dev/null)"; done
                echo -ne "\n  ${Y}Choose flag number:${N} "; local fn_idx; tread fn_idx
                local fname="${rw_list[$((fn_idx-1))]}"
                [[ -z "$fname" ]] && { echo -e "  ${R}Invalid.${N}"; pause_key; continue; }
                echo -ne "  ${Y}New value (0 or 1):${N} "; local fval; tread fval
                [[ "$fval" != "0" && "$fval" != "1" ]] && { echo -e "  ${R}Must be 0 or 1.${N}"; pause_key; continue; }
                root_run "crossystem ${fname}=${fval}" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                echo -e "  ${G}Set: $(crossystem $fname 2>/dev/null)${N}"; pause_key ;;
            f|F)
                banner; crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            *) return ;;
        esac
    done
}

pg_gbb() {
    banner; echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"

    # Show current flags using flashrom method (from CB-WP reference)
    local cur_flags="unknown"
    if command -v flashrom &>/dev/null && command -v futility &>/dev/null && root_available; then
        local tmpgbb=$(mktemp)
        root_run "flashrom -p internal -i GBB -r $tmpgbb" >/dev/null 2>&1
        cur_flags=$(futility gbb --get --flags "$tmpgbb" 2>/dev/null | awk '{print $NF}')
        [[ -z "$cur_flags" ]] && cur_flags=$(root_run "futility gbb --get --flags 2>/dev/null" | awk '{print $NF}')
        rm -f "$tmpgbb"
    elif root_available; then
        cur_flags=$(root_run "futility gbb --get --flags 2>/dev/null" | awk '{print $NF}')
    fi

    echo -e "  ${C}Current flags:${N} ${W}${cur_flags}${N}"
    echo -e "  ${C}Recommended:${N}  ${G}0x80b1${N}  (dev+USB+no-rollback+CCD+no-beep)\n"

    echo -e "  ${W}Flag Reference:${N}"
    printf "  ${C}%-8s${N} %s\n" "0x0001" "DEV_SCREEN_SHORT_DELAY — shorter developer beep"
    printf "  ${C}%-8s${N} %s\n" "0x0008" "FORCE_DEV_SWITCH_ON    — always stay in dev mode"
    printf "  ${C}%-8s${N} %s\n" "0x0010" "DISABLE_DEV_REQUEST    — can't leave dev mode"
    printf "  ${C}%-8s${N} %s\n" "0x0020" "DISABLE_FW_ROLLBACK    — skip firmware rollback check"
    printf "  ${C}%-8s${N} %s\n" "0x0080" "DEFAULT_DEV_BOOT_ALTFW — alt firmware default"
    printf "  ${C}%-8s${N} %s\n" "0x0100" "DISABLE_EC_SOFT_REBOOT — skip EC soft reboot"
    printf "  ${C}%-8s${N} %s\n" "0x8000" "CCD_UNLOCK             — allow CCD unlock without PP"
    printf "  ${C}%-8s${N} %s\n" "0x80b1" "Recommended: all of the above combined"

    if root_available; then
        echo -e "\n  ${D}[S] Set flags  [any] Back${N}"
        local k; tread1 k
        if [[ "$k" == "s" || "$k" == "S" ]]; then
            echo -ne "\n  ${Y}New flags (e.g. 0x80b1):${N} "; local fl; tread fl
            [[ -z "$fl" ]] && { echo -e "  ${D}Cancelled.${N}"; pause_key; return; }
            echo -e "  ${D}Running: futility gbb -s --flash --flags=${fl}${N}"
            root_run "futility gbb -s --flash --flags=${fl}" 2>&1 | while IFS= read -r l; do echo "  $l"; done
            echo -e "  ${G}Done. Reboot for changes to take effect.${N}"; pause_key; return
        fi
    else
        echo -e "\n  ${Y}Need root to set flags.${N}"; pause_key
    fi
}

pg_vpd() {
    # Fixed: returns to VPD menu, not main menu
    while true; do
        banner; echo -e "  ${W}── VPD Editor ───────────────────────────────────────${N}\n"
        if ! root_available; then echo -e "  ${Y}Need root for VPD.${N}"; pause_key; return; fi

        draw_menu "VPD" \
            "View RO VPD" \
            "View RW VPD" \
            "Add / Modify RW entry" \
            "Delete RW entry" \
            "Modify RO entry  ⚠" \
            "Delete RO entry  ⚠" \
            "← Back"
        case $MENU_RESULT in
            0) banner; echo -e "  ${W}RO VPD:${N}\n"
               root_run "vpd -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            1) banner; echo -e "  ${W}RW VPD:${N}\n"
               root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            2) banner
               # Show all RW entries for selection
               echo -e "  ${W}Current RW VPD:${N}\n"
               root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
               echo -ne "\n  ${Y}Key to add/modify:${N} "; local k2; tread k2
               echo -ne "  ${Y}Value:${N} "; local v2; tread v2
               [[ -n "$k2" && -n "$v2" ]] && {
                   root_run "vpd -i RW_VPD -s '${k2}=${v2}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                   echo -e "  ${G}Done.${N}"
               } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            3) banner
               echo -e "  ${W}Current RW VPD:${N}\n"
               root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
               echo -ne "\n  ${Y}Key to delete:${N} "; local dk; tread dk
               [[ -n "$dk" ]] && {
                   root_run "vpd -i RW_VPD -d '${dk}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                   echo -e "  ${G}Done.${N}"
               } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            4) banner; echo -e "  ${Y}⚠  Modifying RO VPD can brick device.${N}\n"
               confirm_yn "Continue?" && {
                   echo -ne "  ${Y}Key:${N} "; local k3; tread k3
                   echo -ne "  ${Y}Value:${N} "; local v3; tread v3
                   [[ -n "$k3" ]] && { root_run "vpd -s '${k3}=${v3}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done; echo -e "  ${G}Done.${N}"; } \
                       || echo -e "  ${D}Cancelled.${N}"
               } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            5) banner; echo -e "  ${Y}⚠  Deleting RO VPD can brick device.${N}\n"
               confirm_yn "Continue?" && {
                   echo -ne "  ${Y}Key:${N} "; local dk2; tread dk2
                   [[ -n "$dk2" ]] && { root_run "vpd -d '${dk2}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done; echo -e "  ${G}Done.${N}"; } \
                       || echo -e "  ${D}Cancelled.${N}"
               } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            *) return ;;
        esac
    done
}

pg_wp_diagnostic() {
    banner; echo -e "  ${W}── Write Protect Diagnostic ─────────────────────────${N}\n"
    if ! root_available; then echo -e "  ${Y}Need root.${N}"; pause_key; return; fi

    local wpsw=$(crossystem wpsw_cur 2>/dev/null||echo "?")
    local devsw=$(crossystem devsw_cur 2>/dev/null||echo "?")
    local flash_wp=$(root_run "gsctool -a -w 2>/dev/null | grep -i 'Flash WP' | awk '{print \$3}'"||echo "?")
    local ccd_state=$(root_run "gsctool -a -I 2>/dev/null | grep -i '^State' | awk '{print \$2}'"||echo "?")

    echo -e "  ${C}wpsw_cur:${N}   $([ "$wpsw"  == "1" ] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}") ($wpsw)"
    echo -e "  ${C}devsw_cur:${N}  $([ "$devsw" == "1" ] && echo "${G}DEV ON${N}"  || echo "${Y}DEV OFF${N}") ($devsw)"
    echo -e "  ${C}Flash WP:${N}   $([ "$flash_wp" == "enabled" ] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}")"
    echo -e "  ${C}CCD State:${N}  $([ "$ccd_state" == "Locked" ] && echo "${R}Locked${N}" || echo "${G}${ccd_state}${N}")\n"

    echo -e "  ${D}GSC capabilities:${N}"
    local gsc_i=$(root_run "gsctool -a -I 2>/dev/null")
    for cap in AllowUnverifiedRo OverrideWP FlashAP FlashRead GscFullConsole; do
        local line=$(echo "$gsc_i" | grep -i "$cap")
        local state=$(echo "$line" | grep -oE 'Never|IfOpened|Always' | head -1)
        local sc=$Y; [[ "$state" == "Always" ]] && sc=$G; [[ "$state" == "Never" ]] && sc=$R
        printf "  %-24s ${sc}%s${N}\n" "$cap" "${state:-unknown}"
    done

    echo -e "\n  ${D}[F] Full flashrom WP status  [any] Back${N}"
    local k; tread1 k
    [[ "$k" == "f" || "$k" == "F" ]] && {
        banner; root_run "flashrom --wp-status 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key
    }
}

