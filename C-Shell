pg_vt2_diag_log() {
    banner; echo -e "  ${W}── Generate VT2 Diagnostic Log ──────────────────────${N}\n"
    if ! root_available; then echo -e "  ${Y}Need root.${N}"; pause_key; return; fi
    local dl=$(ls -d /home/chronos/u-*/MyFiles/Downloads 2>/dev/null | head -1)
    [[ -z "$dl" ]] && dl="/home/chronos/user/MyFiles/Downloads"
    mkdir -p "$dl"
    local logfile="$dl/cshell_diag_$(date +%Y%m%d_%H%M%S).log"
    echo -e "  ${Y}Generating log to $logfile ...${N}\n"
    {
        echo "===== CSHELL DIAGNOSTIC LOG ====="
        date; echo
        echo "=== DEVICE ==="; crossystem hwid 2>/dev/null
        vpd -l 2>/dev/null | grep serial_number
        grep -E "RELEASE_(BOARD|VERSION|BUILD_NUMBER)" /etc/lsb-release 2>/dev/null; echo
        echo "=== CROSSYSTEM ==="; crossystem 2>/dev/null; echo
        echo "=== GBB FLAGS ==="; root_run "futility gbb --get --flags 2>/dev/null"; echo
