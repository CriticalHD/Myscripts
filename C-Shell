pg_ssh_root() {
    banner; echo -e "  ${W}── SSH / Root Setup ─────────────────────────────────${N}\n"
    local rm=$(root_method)
    local rc=$R; [[ "$rm" != "none" ]] && rc=$G
    local mo_st; [[ -f "$OVERRIDE_SO" ]] && mo_st="${G}installed${N}" || mo_st="${Y}missing${N}"
    echo -e "  ${C}Root method:${N}      ${rc}${rm}${N}"
    echo -e "  ${C}minioverride.so:${N}  $mo_st\n"

    draw_menu "Root / SSH" \
        "Restart SSH root tunnel (port 1337)" \
        "Install minioverride.so  (enables sudo)" \
        "Start public SSH  (port 22)" \
        "Set chronos password" \
        "Set root password" \
        "Show authorized_keys" \
        "← Back"
    case $MENU_RESULT in
        0) banner
           if [[ "$(id -u)" -eq 0 ]]; then
               setup_root_sshd; sleep 0.5
               _rsh_check && echo -e "  ${G}SSH root tunnel working!${N}" || echo -e "  ${Y}Try rebooting.${N}"
           elif root_available; then
               root_run "$(declare -f setup_root_sshd); ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'; setup_root_sshd"
               sleep 0.8; _rsh_check && echo -e "  ${G}Tunnel working!${N}" || echo -e "  ${Y}Try rebooting.${N}"
           else
               echo -e "  ${R}Need root. Go to VT2 (Ctrl+Alt+F2) → log in as root → run cshell.${N}"
           fi; pause_key ;;
        1) banner; remount_rw
           install_minioverride && { patch_ui_conf; cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
               echo -e "  ${G}Done.${N}"; [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "  ${Y}Reboot for sudo to activate.${N}"; } \
               || echo -e "  ${R}Failed.${N}"; pause_key ;;
        2) root_run "/usr/sbin/sshd 2>/dev/null"
           echo -e "  ${G}sshd started.${N}  ${D}ssh chronos@$(hostname -I 2>/dev/null | awk '{print $1}')${N}"; pause_key ;;
        3) passwd chronos; pause_key ;;
        4) root_available && root_run "passwd root" || echo -e "  ${R}Need root.${N}"; pause_key ;;
        5) banner; root_available && root_run "cat /root/.ssh/authorized_keys 2>/dev/null" \
               || echo "  Cannot read."; pause_key ;;
    esac
}

