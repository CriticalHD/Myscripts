    echo -e "  ${W}Interfaces:${N}"; ip -br addr show 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
    echo -e "\n  ${W}Routes:${N}"; ip route 2>/dev/null | while IFS= read -r l; do echo "  $l"; done
