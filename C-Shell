    case "$k" in
        p|P) banner; ping -c 4 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        t|T) banner; traceroute -m 15 8.8.8.8 2>&1 | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
        n|N) banner; ss -tunp 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_wifi() {
