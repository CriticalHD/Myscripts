pg_tpm() {
    banner
    echo -e " ${W}── TPM / Security Chip Info ─────────────────────────${N}\n"

    # Basic crossystem TPM values
    echo -e " ${W}Crossystem TPM Info:${N}"
    for key in tpm_kernver tpm_fwver; do
        printf " ${C}%-22s${N} %s\n" "$key" "$(crossystem "$key" 2>/dev/null || echo "n/a")"
    done

    # Security Chip Detection (Cr50 vs Ti50)
    echo -e "\n ${W}Security Chip:${N}"
    local tpm_chip="Unknown"
    local chip_info=""

    if command -v sudo gsctool &>/dev/null; then
        if sudo gsctool -a -I 2>/dev/null | grep -q "AllowUnverifiedRo"; then
            tpm_chip="Ti50"
            chip_info="TPM 2.0 - Newer Titan security chip"
        else
            tpm_chip="Cr50 / H1"
            chip_info="TPM 2.0 - Standard ChromeOS security chip"
        fi
    fi

    printf " ${C}%-22s${N} %s\n" "Chip" "$tpm_chip"
    [[ -n "$chip_info" ]] && printf " ${D}   └─ %s${N}\n" "$chip_info"

    # trunks_client --status
    if root_available && command -v sudo trunks_client &>/dev/null; then
        echo -e "\n ${W}trunks_client Status:${N}"

        # Ensure trunksd is running before querying
        sudo initctl start trunksd >/dev/null 2>&1 || true
        sleep 0.6

        local status
        status=$(sudo trunks_client --status 2>&1)

        # Pretty print with colors
        echo "$status" | while IFS= read -r line; do
            if [[ "$line" == *"true"* ]]; then
                printf " ${G}   %-40s${N}\n" "$line"
            elif [[ "$line" == *"false"* ]]; then
                printf " ${Y}   %-40s${N}\n" "$line"
            elif [[ "$line" == *":"* ]]; then
                printf " ${C}   %-40s${N}\n" "$line"
            else
                echo "   $line"
            fi
        done
    else
        echo -e "\n ${R}trunks_client not available${N}"
    fi

    echo -e "\n ${D}Note: trunks_client gives the most useful human-readable TPM status.${N}"

    pause_key
}

