# ═══════════════════════════════════════════════════════════════
#  ── FILE SYSTEM ──────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_file_browser() {
    local cur="${1:-/}"
    local page_size=24  # items per page
    local page_offset=0

    while true; do
        banner; echo -e "  ${W}── Files: ${cur} ──${N}\n"
        local all_entries=()
        [[ "$cur" != "/" ]] && all_entries+=("↑  ..")

        while IFS= read -r name; do
            local fp="${cur%/}/${name}"
            if [[ -d "$fp" ]]; then
                all_entries+=("📁 ${name}/")
            else
                local sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                all_entries+=("📄 ${name}  [${sz:-?}]")
            fi
        done < <(ls -1p "$cur" 2>/dev/null)

        # Pagination
        local total=${#all_entries[@]}
        local show_entries=()
        local i
        for (( i=page_offset; i<page_offset+page_size && i<total; i++ )); do
            show_entries+=("${all_entries[$i]}")
        done

        # Add navigation entries
        (( page_offset + page_size < total )) && show_entries+=("▼  More ($(( total - page_offset - page_size )) more)...")
        (( page_offset > 0 )) && show_entries+=("▲  Previous page")
        show_entries+=("← Exit browser")

        draw_menu "Files: $cur  [$(( page_offset+1 ))-$(( page_offset+page_size < total ? page_offset+page_size : total ))/${total}]" "${show_entries[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return

        local chosen="${show_entries[$MENU_RESULT]}"
        case "$chosen" in
            "▼  More"*)
                (( page_offset += page_size )) ;;
            "▲  Previous page")
                (( page_offset -= page_size )); (( page_offset < 0 )) && page_offset=0 ;;
            "← Exit browser") return ;;
            "↑  ..")
                cur=$(dirname "$cur"); page_offset=0 ;;
            "📁 "*)
                local dn="${chosen#📁 }"; dn="${dn%/}"
                cur="${cur%/}/${dn}"; page_offset=0 ;;
            "📄 "*)
                local fn="${chosen#📄 }"; fn="${fn%%  *}"
                local fp="${cur%/}/${fn}"
                draw_menu "$fn" "View (tail 50)" "View (head 50)" "Edit (nano/vi)" "Delete" "Copy path" "File info" "← Back"
                case $MENU_RESULT in
                    0) banner; tail -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                    1) banner; head -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                    2) root_available && root_run "command -v nano &>/dev/null && nano '$fp' || vi '$fp'" \
                           || { command -v nano &>/dev/null && nano "$fp" || vi "$fp"; } ;;
                    3) confirm_yn "Delete $fp?" && { root_run "rm -f '$fp'" && echo -e "  ${G}Deleted.${N}"; }; pause_key ;;
                    4) echo -e "  ${W}$fp${N}"; pause_key ;;
                    5) banner; ls -lah "$fp" 2>/dev/null; file "$fp" 2>/dev/null; pause_key ;;
                esac ;;
        esac
    done
}

