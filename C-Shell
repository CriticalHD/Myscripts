pg_crossystem_flags() {
    while true; do
        banner; echo -e "  ${W}── Crossystem Flags ─────────────────────────────────${N}\n"
        command -v crossystem &>/dev/null || { echo "  crossystem not available."; pause_key; return; }
        local ro_flags=(devsw_boot devsw_cur wpsw_cur wpsw_boot fwid ro_fwid
                        mainfw_act mainfw_type tpm_kernver tpm_fwver hwid
                        kernkey_vfy recoverysw_boot recoverysw_cur
                        inside_vm cros_debug vdat_flags)
        local rw_flags=(dev_boot_usb dev_boot_signed_only dev_boot_legacy
                        dev_boot_altfw dev_default_boot block_devmode
                        tried_fwb nvram_cleared recovery_reason
                        kern_nv_used clear_tpm_owner_done)
        echo -e "  ${W}Read-only:${N}"
        for key in "${ro_flags[@]}"; do
            local val=$(crossystem $key 2>/dev/null||echo "n/a")
            local vc=$D; [[ "$val" == "1" ]] && vc=$G
            printf "  ${C}%-28s${N} ${vc}%s${N}\n" "$key" "$val"
        done
        echo -e "\n  ${W}Read-write (editable):${N}"
        for key in "${rw_flags[@]}"; do
            local val=$(crossystem $key 2>/dev/null||echo "n/a")
            local vc=$D; [[ "$val" == "1" ]] && vc=$G
            printf "  ${C}%-28s${N} ${vc}%-6s${N} ${C}[RW]${N}\n" "$key" "$val"
        done
        echo -e "\n  ${D}[E] Edit RW flag  [F] Full dump  [any] Back${N}"
        local k; tread1 k
        case "$k" in
            e|E)
                if ! root_available; then echo -e "  ${R}Need root.${N}"; pause_key; continue; fi
                echo -e "\n  ${W}Select flag:${N}"
                for i in "${!rw_flags[@]}"; do
                    echo -e "  ${C}$((i+1)))${N}  ${rw_flags[$i]} = $(crossystem ${rw_flags[$i]} 2>/dev/null||echo ?)"
                done
                echo -ne "\n  ${Y}Number:${N} "; local fn_i; tread fn_i
                local fname="${rw_flags[$((fn_i-1))]}"
                [[ -z "$fname" ]] && { echo -e "  ${R}Invalid.${N}"; pause_key; continue; }
                echo -ne "  ${Y}New value (0 or 1):${N} "; local fval; tread fval
                [[ "$fval" != "0" && "$fval" != "1" ]] && { echo -e "  ${R}Must be 0 or 1.${N}"; pause_key; continue; }
                root_run "crossystem ${fname}=${fval}" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                echo -e "  ${G}Done: ${fname} = $(crossystem $fname 2>/dev/null)${N}"; pause_key ;;
            f|F) banner; crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            *) return ;;
        esac
    done
}

pg_gbb() {
    banner; echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"
    local cur_flags="unknown"
    if root_available; then
        local tmpgbb; tmpgbb=$(mktemp /tmp/gbb.XXXXXX)
        root_run "flashrom -p internal -i GBB -r $tmpgbb 2>/dev/null" >/dev/null 2>&1
        [[ -s "$tmpgbb" ]] && cur_flags=$(futility gbb --get --flags "$tmpgbb" 2>/dev/null | awk '{print $NF}')
        [[ -z "$cur_flags" || "$cur_flags" == "unknown" ]] && \
            cur_flags=$(root_run "futility gbb --get --flags 2>/dev/null" 2>/dev/null | awk '{print $NF}')
        rm -f "$tmpgbb"
    fi
    echo -e "  ${C}Current flags:${N}  ${W}${cur_flags:-unknown}${N}"
    echo -e "  ${C}Recommended:${N}   ${G}0x80b1${N}  (dev+USB+no-rollback+no-beep+CCD)\n"
    printf "  ${C}%-8s${N}  %s\n" "0x0001" "DEV_SCREEN_SHORT_DELAY"
    printf "  ${C}%-8s${N}  %s\n" "0x0008" "FORCE_DEV_SWITCH_ON (stay in dev mode)"
    printf "  ${C}%-8s${N}  %s\n" "0x0010" "DISABLE_DEV_REQUEST (can't leave dev)"
    printf "  ${C}%-8s${N}  %s\n" "0x0020" "DISABLE_FW_ROLLBACK"
    printf "  ${C}%-8s${N}  %s\n" "0x0080" "DEFAULT_DEV_BOOT_ALTFW"
    printf "  ${C}%-8s${N}  %s\n" "0x0100" "DISABLE_EC_SOFT_REBOOT"
    printf "  ${C}%-8s${N}  %s\n" "0x8000" "CCD_UNLOCK"
    printf "  ${C}%-8s${N}  %s\n" "0x80b1" "Recommended combo"
    if root_available; then
        echo -e "\n  ${D}[S] Set flags  [any] Back${N}"
        local k; tread1 k
        if [[ "$k" == "s" || "$k" == "S" ]]; then
            echo -ne "\n  ${Y}New flags (e.g. 0x80b1):${N} "; local fl; tread fl
            [[ -z "$fl" ]] && { echo -e "  ${D}Cancelled.${N}"; pause_key; return; }
            root_run "futility gbb -s --flash --flags=${fl}" 2>&1 | while IFS= read -r l; do echo "  $l"; done
            echo -e "  ${G}Done. Reboot to apply.${N}"; pause_key; return
        fi
    else
        echo -e "\n  ${Y}Need root to set.${N}"; pause_key
    fi
}

pg_vpd() {
    while true; do
        banner; echo -e "  ${W}── VPD Editor ───────────────────────────────────────${N}\n"
        if ! root_available; then echo -e "  ${Y}Need root.${N}"; pause_key; return; fi
        draw_menu "VPD" "View RO VPD" "View RW VPD" \
            "Add / Modify RW entry" "Delete RW entry" \
            "Modify RO entry (!)" "Delete RO entry (!)" "< Back"
        case $MENU_RESULT in
            0) banner; root_run "vpd -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            1) banner; root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
            2) banner; root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
               echo -ne "\n  ${Y}Key:${N} "; local k2; tread k2
               echo -ne "  ${Y}Value:${N} "; local v2; tread v2
               [[ -n "$k2" && -n "$v2" ]] && { root_run "vpd -i RW_VPD -s '${k2}=${v2}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done; echo -e "  ${G}Done.${N}"; } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            3) banner; root_run "vpd -i RW_VPD -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done
               echo -ne "\n  ${Y}Key to delete:${N} "; local dk; tread dk
               [[ -n "$dk" ]] && { root_run "vpd -i RW_VPD -d '${dk}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done; echo -e "  ${G}Done.${N}"; } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            4) banner; echo -e "  ${Y}WARNING: Modifying RO VPD can brick device.${N}\n"
               confirm_yn "Continue?" && {
                   echo -ne "  ${Y}Key:${N} "; local k3; tread k3
                   echo -ne "  ${Y}Value:${N} "; local v3; tread v3
                   [[ -n "$k3" ]] && root_run "vpd -s '${k3}=${v3}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                   echo -e "  ${G}Done.${N}"; } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            5) banner; echo -e "  ${Y}WARNING: Deleting RO VPD can brick device.${N}\n"
               confirm_yn "Continue?" && {
                   echo -ne "  ${Y}Key:${N} "; local dk2; tread dk2
                   [[ -n "$dk2" ]] && root_run "vpd -d '${dk2}'" 2>&1 | while IFS= read -r l; do echo "  $l"; done
                   echo -e "  ${G}Done.${N}"; } || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            *) return ;;
        esac
    done
}

pg_wp_diagnostic() {
    banner; echo -e "  ${W}── Write Protect Diagnostic ─────────────────────────${N}\n"
    if ! root_available; then echo -e "  ${Y}Need root.${N}"; pause_key; return; fi
    local wpsw=$(crossystem wpsw_cur 2>/dev/null||echo "?")
    local devsw=$(crossystem devsw_cur 2>/dev/null||echo "?")
    local flash_wp=$(root_run "gsctool -a -w 2>/dev/null | grep -i 'Flash WP' | awk '{print \$3}'" 2>/dev/null||echo "?")
    local ccd_state=$(root_run "gsctool -a -I 2>/dev/null | grep -i '^State' | awk '{print \$2}'" 2>/dev/null||echo "?")
    echo -e "  ${C}wpsw_cur:${N}   $([[ "$wpsw"  == "1" ]] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}") ($wpsw)"
    echo -e "  ${C}devsw_cur:${N}  $([[ "$devsw" == "1" ]] && echo "${G}DEV ON${N}"  || echo "${Y}DEV OFF${N}") ($devsw)"
    echo -e "  ${C}Flash WP:${N}   $([[ "$flash_wp" == "enabled" ]] && echo "${R}ENABLED${N}" || echo "${G}DISABLED${N}")"
    echo -e "  ${C}CCD State:${N}  $([[ "$ccd_state" == "Locked" ]] && echo "${R}Locked${N}" || echo "${G}${ccd_state}${N}")\n"
    echo -e "  ${D}GSC capabilities:${N}"
    local gsc_i; gsc_i=$(root_run "gsctool -a -I 2>/dev/null")
    for cap in AllowUnverifiedRo OverrideWP FlashAP FlashRead GscFullConsole; do
        local state; state=$(echo "$gsc_i" | grep -i "$cap" | grep -oE 'Never|IfOpened|Always' | head -1)
        local sc=$Y; [[ "$state" == "Always" ]] && sc=$G; [[ "$state" == "Never" ]] && sc=$R
        printf "  %-24s ${sc}%s${N}\n" "$cap" "${state:-unknown}"
    done
    echo -e "\n  ${D}[F] flashrom WP  [any] Back${N}"
    local k; tread1 k
    [[ "$k" == "f" || "$k" == "F" ]] && {
        banner; root_run "flashrom --wp-status 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key; }
}

