pg_crossystem_flags() {
    while true; do
        banner
        echo -e " ${W}── Crossystem Flags ─────────────────────────────────${N}\n"
        command -v crossystem &>/dev/null || {
            echo " ${R}crossystem not available.${N}";
            pause_key; return;
        }

        echo -e " ${W}Loading all crossystem parameters...${N}\n"

        # Get all parameters
        local params=()
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^[[:space:]]*([a-zA-Z0-9_]+) ]]; then
                params+=("${BASH_REMATCH[1]}")
            fi
        done < <(sudo crossystem 2>/dev/null)

        if [[ ${#params[@]} -eq 0 ]]; then
            echo -e " ${R}Failed to load parameters.${N}"
            pause_key
            return
        fi

        # Separate RO and RW
        local ro_params=()
        local rw_params=()

        for key in "${params[@]}"; do
            # Use crossystem --all to detect RO/RW (most reliable way)
            local info=$(sudo crossystem --all 2>/dev/null | grep "^[[:space:]]*$key[[:space:]]")
            if [[ "$info" == *"[RW/"* ]]; then
                rw_params+=("$key")
            else
                ro_params+=("$key")
            fi
        done

        # Display RO section first (info only)
        echo -e " ${W}Read-Only (RO) Flags:${N}"
        for key in "${ro_params[@]}"; do
            local val=$(sudo crossystem "$key" 2>/dev/null || echo "n/a")
            printf "    ${C}%-28s${N} ${D}%s${N}\n" "$key" "$val"
        done

        echo -e "\n ${W}Read-Write (RW) Flags:${N}"
        for i in "${!rw_params[@]}"; do
            local key="${rw_params[$i]}"
            local val=$(sudo crossystem "$key" 2>/dev/null || echo "n/a")
            local vc=$D
            [[ "$val" == "1" ]] && vc=$G
            printf " ${C}%3d)${N} ${C}%-28s${N} ${vc}%s${N}\n" "$((i+1))" "$key" "$val"
        done

        echo -e "\n ${D}[E] Edit a RW flag by number [any other key] Back${N}"
        local k; tread1 k
        if [[ "$k" != "e" && "$k" != "E" ]]; then
            return
        fi

        # Edit mode - only RW flags
        if ! root_available; then
            echo -e " ${R}Root is required to edit flags.${N}"
            pause_key
            continue
        fi

        echo -ne "\n ${Y}Enter number of RW flag to edit:${N} "
        local num; tread num
        [[ -z "$num" || ! "$num" =~ ^[0-9]+$ ]] && { echo -e " ${R}Invalid number.${N}"; pause_key; continue; }

        local idx=$((num - 1))
        if [[ $idx -lt 0 || $idx -ge ${#rw_params[@]} ]]; then
            echo -e " ${R}Number out of range.${N}"
            pause_key
            continue
        fi

        local fname="${rw_params[$idx]}"
        local current=$(sudo crossystem "$fname" 2>/dev/null || echo "n/a")
        echo -e " Selected: ${C}${fname}${N} = ${current}"
        echo -ne " ${Y}New value (usually 0 or 1, or leave empty to cancel):${N} "
        local fval; tread fval

        if [[ -z "$fval" ]]; then
            echo -e " ${Y}Cancelled.${N}"
            pause_key
            continue
        fi

        echo -e "\n ${W}Setting ${fname}=${fval} ...${N}"
        sudo crossystem "${fname}=${fval}" 2>&1 | while IFS= read -r l; do echo " $l"; done

        local newval=$(sudo crossystem "$fname" 2>/dev/null || echo "n/a")
        echo -e " ${G}Result: ${fname} = ${newval}${N}"
        pause_key
    done
}

pg_gbb() {
    # ── GBB flag definitions: "NAME|HEX_MASK|Description"
    local -a FLAGS=(
        "DEV_SCREEN_SHORT_DELAY|0x00000001|Reduce dev screen delay to 2s"
        "LOAD_OPTION_ROMS|0x00000002|Load option ROMs from PCI devices"
        "ENABLE_ALTERNATE_OS|0x00000004|Boot non-ChromeOS kernel"
        "FORCE_DEV_SWITCH_ON|0x00000008|Force dev mode on"
        "FORCE_DEV_BOOT_USB|0x00000010|Allow USB boot regardless of setting"
        "DISABLE_ROLLBACK_CHECK|0x00000020|Disable firmware rollback protection"
        "ENTER_TRIGGERS_TONORM|0x00000040|Enter triggers dev → normal"
        "FORCE_DEV_BOOT_ALTFW|0x00000080|Allow altfw/legacy boot"
        "RUNNING_FAFT|0x00000100|Deprecated FAFT flag (do not use)"
        "DISABLE_EC_SOFTWARE_SYNC|0x00000200|Disable EC software sync"
        "DEFAULT_DEV_BOOT_ALTFW|0x00000400|Default to altfw on timeout"
        "DISABLE_AUXFW_SOFTWARE_SYNC|0x00000800|Disable auxiliary FW sync"
        "DISABLE_LID_SHUTDOWN|0x00001000|Disable shutdown on lid close"
        "FORCE_UNLOCK_FASTBOOT|0x00002000|Full fastboot in verified mode"
        "FORCE_MANUAL_RECOVERY|0x00004000|Always assume manual recovery"
        "DISABLE_FWMP|0x00008000|Ignore Firmware Management Parameters"
        "ENABLE_UDC|0x00010000|Enable USB Device Controller"
        "FORCE_CSE_SYNC|0x00020000|Force CSE sync always"
    )

    local total=${#FLAGS[@]}
    local cursor=0
    local selected=0
    local current_hex="0x00000000"
    local flash_status=""

    # ── Read current flags from device
    if root_available; then
        local tmpgbb; tmpgbb=$(mktemp /tmp/gbb.XXXXXX)
        root_run "flashrom -p internal -i GBB -r '$tmpgbb'" >/dev/null 2>&1
        local raw=""
        if [[ -s "$tmpgbb" ]]; then
            raw=$(futility gbb --get --flags "$tmpgbb" 2>/dev/null | grep -oP '0x[0-9A-Fa-f]+')
        fi
        rm -f "$tmpgbb"
        # Fallback: read directly without file
        [[ -z "$raw" ]] && raw=$(root_run "futility gbb --get --flags" 2>/dev/null | grep -oP '0x[0-9A-Fa-f]+')
        if [[ -n "$raw" ]]; then
            current_hex="$raw"
            selected=$(( raw ))   # bash evaluates 0x... literals correctly
        fi
    fi

    # ── Helper: decode selected int → array of set bit names
    _gbb_active_names() {
        local val=$1 names=()
        for entry in "${FLAGS[@]}"; do
            IFS='|' read -r name mask _ <<< "$entry"
            local bit=$(( mask ))
            (( val & bit )) && names+=("$name")
        done
        echo "${names[*]}"
    }

    # ── Draw full screen
    _gbb_draw() {
        clear
        banner
        echo -e " ${W}── GBB Flags Editor ────────────────────────────────${N}"
        echo -e " ${C}Flags on device : ${W}${current_hex}${N}"
        echo -e " ${C}Selected value  : ${W}$(printf '0x%08X' $selected)${N}\n"

        for (( i=0; i<total; i++ )); do
            IFS='|' read -r name mask desc <<< "${FLAGS[$i]}"
            local bit=$(( mask ))
            local box="${D}[ ]${N}"
            local nc="${N}"
            if (( selected & bit )); then
                box="${G}[✓]${N}"
                nc="${G}"
            fi
            if (( i == cursor )); then
                echo -e "  ${Y}▶${N} ${box} ${nc}$(printf '%-32s' "$name")${N} ${D}${desc}${N}"
            else
                echo -e "    ${box} ${nc}$(printf '%-32s' "$name")${N} ${D}${desc}${N}"
            fi
        done

        echo
        echo -e " ${D}──────────────────────────────────────────────────────${N}"
        echo -e " ${D}↑↓${N} Move  ${D}Enter${N} Toggle  ${D}R${N} Recommended (0x80B1)  ${D}S${N} Flash  ${D}Q${N} Quit"
        [[ -n "$flash_status" ]] && echo -e "\n $flash_status"
    }

    # ── Read a single keypress (handles ANSI arrows)
    _gbb_readkey() {
        local key esc
        IFS= read -r -s -n1 key
        if [[ "$key" == $'\x1b' ]]; then
            IFS= read -r -s -n1 -t0.1 esc
            if [[ "$esc" == '[' ]]; then
                IFS= read -r -s -n1 -t0.1 key
                case "$key" in
                    A) echo "UP"   ;;
                    B) echo "DOWN" ;;
                    *) echo ""     ;;
                esac
                return
            fi
        fi
        echo "$key"
    }

    # ── Main loop
    while true; do
        _gbb_draw
        local key; key=$(_gbb_readkey)

        case "$key" in
            UP)
                (( cursor-- ))
                (( cursor < 0 )) && cursor=$(( total - 1 ))
                ;;
            DOWN)
                (( cursor++ ))
                (( cursor >= total )) && cursor=0
                ;;
            "")   # Enter
                IFS='|' read -r _ mask _ <<< "${FLAGS[$cursor]}"
                local bit=$(( mask ))
                selected=$(( selected ^ bit ))   # XOR toggle — safe and correct
                ;;
            r|R)
                selected=$(( 0x80B1 ))
                flash_status="${C}Preset applied: 0x000080B1${N}"
                ;;
            s|S)
                if ! root_available; then
                    flash_status="${R}✗ Root required to flash GBB flags.${N}"
                    continue
                fi
                local final_hex; final_hex=$(printf '0x%08X' "$selected")
                flash_status="${Y}Writing ${final_hex} …${N}"
                _gbb_draw
                local out
                out=$(root_run "futility gbb --flash --set --flags=${final_hex}" 2>&1)
                if [[ $? -eq 0 ]]; then
                    flash_status="${G}✓ GBB flags written: ${final_hex}. Reboot to apply.${N}"
                else
                    flash_status="${R}✗ Flash failed: ${out}${N}"
                fi
                ;;
            q|Q)
                clear
                return
                ;;
        esac
    done
}
pg_vpd() {
    while true; do
        banner; echo -e "  ${W}── VPD Editor ───────────────────────────────────────${N}\n"
        if ! root_available; then echo -e "  ${Y}Need root.${N}"; pause_key; return; fi
        draw_menu "VPD" "View RO VPD" "View RW VPD" \
            "Add / Modify RW entry" "Delete RW entry" \
            "Modify RO entry (!)" "Delete RO entry (!)" "< Back"
        case $MENU_RESULT in
            0) banner; root_run "vpd -l 2>/dev/null" | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
