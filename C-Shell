            3) banner; bash <(curl -s "https://raw.githubusercontent.com/shadowed1/sudoCrosh/main/sudocrosh_downloader.sh?$(date +%s)"); pause_key ;;
            4) banner; bash <(curl -s "https://raw.githubusercontent.com/shadowed1/Sucrose/main/bin/sucrose_downloader.sh?$(date +%s)"); pause_key ;;
            5) banner; curl -LOk https://mrchromebox.tech/firmware-util.sh 2>/dev/null && bash firmware-util.sh; rm -f firmware-util.sh; pause_key ;;
            6) banner; bash <(curl -Ls git.io/vddgY); pause_key ;;
            7) banner; root_run "dev_install"; pause_key ;;
            8) banner
               echo -e "  ${W}Custom Payload${N}"
               echo -e "  ${D}Example: https://raw.githubusercontent.com/user/repo/main/script.sh${N}\n"
               echo -ne "  ${Y}URL:${N} "; local url; tread url
               [[ -n "$url" ]] && { echo -e "\n  ${D}Running...${N}\n"; bash <(curl -sSL "$url"); } \
                   || echo -e "  ${D}Cancelled.${N}"; pause_key ;;
            *) return ;;
        esac
    done
}

# ════════════════════════════════════════════════════════════════
#  SSH / ROOT SETUP
# ════════════════════════════════════════════════════════════════
pg_ssh_root() {
    banner; echo -e "  ${W}── SSH / Root Setup ─────────────────────────────────${N}\n"
    local rs; rs=$(root_status_plain)
    local mo_st; [[ -f "$OVERRIDE_SO" ]] && mo_st="installed" || mo_st="missing"
    local sc_st; command -v sucrose-daemon &>/dev/null && sc_st="installed" || sc_st="not installed"
    echo -e "  ${C}Root method:${N}      ${W}${rs}${N}"
    echo -e "  ${C}minioverride.so:${N}  ${W}${mo_st}${N}"
    echo -e "  ${C}Sucrose daemon:${N}   ${W}${sc_st}${N}\n"
    draw_menu "Root / SSH" \
        "Restart SSH root tunnel (port 1337)" \
        "Install minioverride.so  (enables sudo)" \
        "Start public SSH (port 22)" \
        "Set chronos password" \
        "Set root password" \
        "Show authorized_keys" \
        "< Back"
    case $MENU_RESULT in
        0) banner
           if [[ "$(id -u)" -eq 0 ]]; then
               setup_root_sshd; sleep 0.5
               _rsh_ok && echo -e "  ${G}Tunnel working!${N}" || echo -e "  ${Y}Try rebooting.${N}"
           elif root_available; then
               root_run "$(declare -f setup_root_sshd); ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'; setup_root_sshd"
               sleep 0.8; _rsh_ok && echo -e "  ${G}Tunnel working!${N}" || echo -e "  ${Y}Try rebooting.${N}"
           else
               echo -e "  ${R}Need root. VT2 (Ctrl+Alt+F2) -> root -> run cshell.${N}"
           fi; pause_key ;;
        1) banner; remount_rw
           install_minioverride && { NEEDS_REBOOT=0; patch_ui_conf
               cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
               echo -e "  ${G}Done.${N}"; [[ $NEEDS_REBOOT -eq 1 ]] && echo -e "  ${Y}Reboot for sudo.${N}"; } \
               || echo -e "  ${R}Failed.${N}"; pause_key ;;
        2) root_run "/usr/sbin/sshd 2>/dev/null"
           echo -e "  ${G}sshd started.${N}  ${D}ssh chronos@$(hostname -I 2>/dev/null|awk '{print $1}')${N}"; pause_key ;;
        3) passwd chronos; pause_key ;;
        4) root_available && root_run "passwd root" || echo -e "  ${R}Need root.${N}"; pause_key ;;
        5) banner; root_available && root_run "cat /root/.ssh/authorized_keys 2>/dev/null" \
               || echo "  Cannot read."; pause_key ;;
    esac
}

# ════════════════════════════════════════════════════════════════
#  REPAIR
# ════════════════════════════════════════════════════════════════
pg_repair() {
    while true; do
        draw_menu "Repair / Rebuild" \
            "Rebuild SSH root keys  (VT2/root)" \
            "Reinstall minioverride.so" \
            "Reinstall persistence hooks" \
            "Restart SSH root tunnel" \
            "Toggle ui.conf minioverride patch" \
            "< Back"
        case $MENU_RESULT in
            0) banner; remount_rw
               [[ "$(id -u)" -eq 0 ]] && { setup_root_sshd; sleep 0.5
                   _rsh_ok && echo -e "  ${G}Working!${N}" || echo -e "  ${Y}Try reboot.${N}"; } \
               || echo -e "  ${R}Must run as root from VT2.${N}"; pause_key ;;
            1) banner; remount_rw; rm -f "$OVERRIDE_SO"
               install_minioverride && { NEEDS_REBOOT=0; patch_ui_conf
                   cp "$OVERRIDE_SO" /usr/bin/minioverride.so 2>/dev/null
                   echo -e "  ${G}Done. Reboot for sudo.${N}"; } || echo -e "  ${R}Failed.${N}"; pause_key ;;
            2) banner; remount_rw
               [[ "$(id -u)" -eq 0 ]] && install_persistence || echo -e "  ${R}Need root.${N}"; pause_key ;;
            3) banner
               root_run "pkill -f 'sshd.*1337'; sleep 0.3; /usr/sbin/sshd -f $SSHD_CONF" 2>/dev/null \
                   || { pkill -f "sshd.*1337" 2>/dev/null; sleep 0.3; /usr/sbin/sshd -f "$SSHD_CONF" 2>/dev/null; }
               sleep 0.5; _rsh_ok && echo -e "  ${G}Working!${N}" || echo -e "  ${Y}Still down.${N}"; pause_key ;;
            4) banner; remount_rw
               if grep -q "minioverride" "$UI_CONF" 2>/dev/null; then
                   confirm_yn "Remove minioverride from ui.conf?" && {
                       grep -v "minioverride" "$UI_CONF" > /tmp/_ui.tmp
                       safe_write /tmp/_ui.tmp "$UI_CONF"; rm -f /tmp/_ui.tmp
                       echo -e "  ${G}Removed. Reboot to apply.${N}"; }
               else
                   confirm_yn "Add minioverride to ui.conf?" && { NEEDS_REBOOT=0; patch_ui_conf
                       echo -e "  ${G}Patched. Reboot to apply.${N}"; }
               fi; pause_key ;;
            *) return ;;
        esac
    done
}

# ════════════════════════════════════════════════════════════════
#  ROOT SHELL
# ════════════════════════════════════════════════════════════════
pg_root_shell() {
    printf '\033[?25h'
    banner; echo -e "  ${Y}Root shell -- type 'exit' to return.${N}\n"
    if   [[ "$(id -u)" -eq 0 ]]; then bash --login
    elif _rsh_ok 2>/dev/null;    then _rsh bash
    elif _sudo_ok;               then sudo bash
    else echo -e "  ${Y}No root available. Limited shell.${N}\n"; bash --login
    fi
    echo -e "\n  ${C}Back in cshell.${N}"; sleep 0.5
}

