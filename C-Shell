# ════════════════════════════════════════════════════════════════
#  FILE BROWSER — paginated, search, execute .sh, no duplication
# ════════════════════════════════════════════════════════════════
pg_file_browser() {
    local cur="${1:-/}" PAGE=20 off=0 search=""
    while true; do
        local all=()
        while IFS= read -r name; do
            local fp="${cur%/}/${name}"
            [[ -n "$search" ]] && { echo "$name" | grep -qi "$search" || continue; }
            if [[ -d "$fp" ]]; then
                all+=("[D] ${name}/")
            else
                local sz; sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                all+=("[F] ${name}  (${sz:-?})")
            fi
        done < <(ls -1p "$cur" 2>/dev/null)

        local total=${#all[@]}
        local page_items=()
        local i; for (( i=off; i<off+PAGE && i<total; i++ )); do page_items+=("${all[$i]}"); done
        local showing=${#page_items[@]}

        # Build nav items separately
        local nav_items=()
        [[ "$cur" != "/" ]] && nav_items+=("^ Up  (go to parent)")
        [[ -n "$search" ]] && nav_items+=("* Clear search [${search}]") || nav_items+=("/ Search files")
        (( off+PAGE < total )) && nav_items+=("v More  ($(( total-off-PAGE )) items)")
        (( off > 0 ))          && nav_items+=("^ Prev page")
        nav_items+=("< Exit")

        local pg="$(( off+1 ))-$(( off+PAGE<total?off+PAGE:total ))/${total}"
        [[ -n "$search" ]] && pg="${pg} filter:'${search}'"

        # Single draw_menu call: page_items + separator + nav_items
        local all_items=("${page_items[@]}" "───────────────────────────────────" "${nav_items[@]}")
        draw_menu "Files: ${cur}  [${pg}]" "${all_items[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return

        local idx=$MENU_RESULT

        if (( idx < showing )); then
            # File or dir
            local chosen="${page_items[$idx]}"
            if [[ "$chosen" == "[D] "* ]]; then
                local dn="${chosen#\[D\] }"; dn="${dn%/}"; cur="${cur%/}/${dn}"; off=0; search=""
            else
                local fn="${chosen#\[F\] }"; fn="${fn%%  (*}"; local fp="${cur%/}/${fn}"
                local is_x=0
                [[ "${fn##*.}" == "sh" || "${fn##*.}" == "bash" || -x "$fp" ]] && is_x=1
                local opts=(); [[ $is_x -eq 1 ]] && opts+=("Execute script")
                opts+=("View tail-50" "View head-50" "Edit" "Delete" "File info" "Copy path" "< Back")
                draw_menu "$fn" "${opts[@]}"
                local fi=$MENU_RESULT; [[ $fi -eq -1 ]] && continue
                [[ $is_x -eq 1 && $fi -eq 0 ]] && {
                    banner; echo -e "  ${Y}Executing $fp ...${N}\n"
                    bash "$fp"; echo -e "\n  ${G}Done.${N}"; pause_key; continue; }
                [[ $is_x -eq 1 ]] && (( fi-- ))
                case $fi in
                    0) banner; tail -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                    1) banner; head -50 "$fp" 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
                    2) root_available && root_run "command -v nano &>/dev/null && nano '$fp' || vi '$fp'" \
                           || { command -v nano &>/dev/null && nano "$fp" || vi "$fp"; } ;;
                    3) confirm_yn "Delete $fp?" && { root_run "rm -f '$fp'" && echo -e "  ${G}Deleted.${N}"; }; pause_key ;;
                    4) banner; ls -lah "$fp" 2>/dev/null; file "$fp" 2>/dev/null; pause_key ;;
                    5) echo -e "  ${W}$fp${N}"; pause_key ;;
                esac
            fi
        else
            # Nav item: idx >= showing; separator at showing (skipped by draw_menu)
            # nav items at showing+1, showing+2, ...
            # MENU_RESULT skips the separator, so nav_k = idx - showing - 1
            local nav_k=$(( idx - showing - 1 ))
            [[ $nav_k -lt 0 || $nav_k -ge ${#nav_items[@]} ]] && continue
            case "${nav_items[$nav_k]}" in
                "^ Up"*)     cur=$(dirname "$cur"); off=0; search="" ;;
                "* Clear"*)  search=""; off=0 ;;
                "/ Search"*) echo -ne "\n  ${Y}Search (regex ok):${N} "; tread search; off=0 ;;
                "v More"*)   (( off += PAGE )) ;;
                "^ Prev"*)   (( off -= PAGE )); (( off < 0 )) && off=0 ;;
                "< Exit"*)   return ;;
            esac
        fi
    done
}

