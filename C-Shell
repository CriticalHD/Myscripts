pg_cpu_stress() {
    banner; echo -e "  ${W}── CPU Stress Test ──────────────────────────────────${N}\n"
    confirm_yn "Stress all $(nproc) cores for 10s?" && {
        echo -e "\n  ${Y}Running...${N}"
        timeout 10 bash -c "for i in \$(seq 1 \$(nproc)); do while :; do :; done & done; wait" 2>/dev/null
        echo -e "  ${G}Done.${N}\n  ${D}Temps:${N}"
        for f in /sys/class/thermal/thermal_zone*/temp; do
            [[ -f "$f" ]] || continue
            printf "  %-22s %.1f°C\n" "($(cat "$(dirname $f)/type" 2>/dev/null||echo ?))" "$(awk "BEGIN{print $(cat $f)/1000}")"
        done
    } || echo -e "  ${D}Cancelled.${N}"; pause_key
}

pg_disk_bench() {
    banner; echo -e "  ${W}── Disk Benchmark ───────────────────────────────────${N}\n"
    confirm_yn "Write 128MB to /tmp?" && {
        echo -e "\n  ${D}Write:${N}"
        dd if=/dev/zero of=/tmp/_bench bs=1M count=128 conv=fdatasync 2>&1 | while IFS= read -r l; do echo "  $l"; done
        echo -e "\n  ${D}Read:${N}"
        dd if=/tmp/_bench of=/dev/null bs=1M 2>&1 | while IFS= read -r l; do echo "  $l"; done
        rm -f /tmp/_bench
    } || echo -e "  ${D}Cancelled.${N}"; pause_key
}

# ═══════════════════════════════════════════════════════════════
#  ── DEVELOPER TOOLS ──────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
pg_devmode() {
    banner; echo -e "  ${W}── Dev Mode / Boot Flags ────────────────────────────${N}\n"
    command -v crossystem &>/dev/null || { echo "  crossystem not available."; pause_key; return; }

    # Categorize flags
    declare -A RW_FLAGS=( [dev_boot_usb]=1 [dev_boot_signed_only]=1 [dev_boot_legacy]=1 )
    local all_flags=(devsw_boot dev_boot_usb dev_boot_signed_only dev_boot_legacy wpsw_cur fwid ro_fwid mainfw_act mainfw_type)

    echo -e "  ${W}Flags (RW = editable):${N}\n"
    for key in "${all_flags[@]}"; do
        local val=$(crossystem $key 2>/dev/null||echo "n/a")
        local vc=$D; [[ "$val" == "1" ]] && vc=$G
        local rw_tag=""; [[ "${RW_FLAGS[$key]}" ]] && rw_tag=" ${C}[RW]${N}"
        printf "  ${C}%-32s${N} ${vc}%-6s${N}%b\n" "$key" "$val" "$rw_tag"
    done

    echo -e "\n  ${D}[E] Edit a flag  [F] Full dump  [any] Back${N}"
    local k; tread1 k
    case "$k" in
        e|E)
            if ! root_available; then echo -e "  ${R}Need root to edit flags.${N}"; pause_key; return; fi
            echo -ne "\n  ${Y}Flag name (e.g. dev_boot_usb):${N} "; local fname; tread fname
            if [[ -z "${RW_FLAGS[$fname]}" ]]; then
                echo -e "  ${R}Not an editable RW flag.${N}"; pause_key; return
            fi
            echo -ne "  ${Y}New value (0 or 1):${N} "; local fval; tread fval
            if [[ "$fval" != "0" && "$fval" != "1" ]]; then
                echo -e "  ${R}Must be 0 or 1.${N}"; pause_key; return
            fi
            root_run "crossystem ${fname}=${fval}" 2>&1 | while IFS= read -r l; do echo "  $l"; done
            local newval=$(crossystem "$fname" 2>/dev/null)
            echo -e "  ${G}Set ${fname} = ${newval}${N}"; pause_key ;;
        f|F)
            banner; crossystem 2>/dev/null | while IFS= read -r l; do echo "  $l"; done; pause_key ;;
    esac
}

pg_gbb() {
    banner; echo -e "  ${W}── GBB Flags ────────────────────────────────────────${N}\n"
