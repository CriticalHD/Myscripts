# ════════════════════════════════════════════════════════════════
#  FILE BROWSER — paginated, search, execute .sh, no duplication
# ════════════════════════════════════════════════════════════════
pg_file_browser() {
    local cur="${1:-/}" PAGE=15 off=0 search=""

    while true; do
        # Build file list
        local all=()
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            local fp="${cur%/}/${name}"

            [[ -n "$search" ]] && { echo "$name" | grep -qi "$search" || continue; }

            if [[ -d "$fp" ]]; then
                all+=("📁 ${name}/")
            elif [[ -f "$fp" ]]; then
                local sz; sz=$(du -sh "$fp" 2>/dev/null | cut -f1)
                all+=("📄 ${name} ${sz:+(${sz})}")
            else
                all+=("❓ ${name}")
            fi
        done < <(ls -1p "$cur" 2>/dev/null | sed 's/\/$//')

        local total=${#all[@]}
        local page_items=()
        local i
        for (( i=off; i < off+PAGE && i < total; i++ )); do
            page_items+=("${all[$i]}")
        done

        local showing=${#page_items[@]}

        # Navigation
        local nav_items=()
        [[ "$cur" != "/" ]] && nav_items+=("↑  Up to parent")
        [[ -n "$search" ]] && nav_items+=("✕  Clear search") || nav_items+=("🔍  Search here")
        (( off + PAGE < total )) && nav_items+=("↓  Next page ($((total - off - PAGE)) left)")
        (( off > 0 )) && nav_items+=("↑  Previous page")
        nav_items+=("←  Exit browser")

        local pg="$((off+1))-$((off+PAGE < total ? off+PAGE : total))/${total}"
        [[ -n "$search" ]] && pg="${pg} [${search}]"

        # Combine everything
        local all_items=("${page_items[@]}" "────────────────────────────────────" "${nav_items[@]}")

        draw_menu "File Browser → ${cur}  [${pg}]" "${all_items[@]}"
        [[ $MENU_RESULT -eq -1 ]] && return

        local idx=$MENU_RESULT

        # === FILE / FOLDER SELECTED ===
        if (( idx < showing )); then
            local chosen="${page_items[$idx]}"
            local item_name="${chosen:2}"      # remove emoji + space
            item_name="${item_name%/}"
            local fullpath="${cur%/}/${item_name}"

            if [[ -d "$fullpath" ]]; then
                cur="$fullpath"
                off=0
                search=""
                continue
            fi

            # File selected - show actions
            local ext="${item_name##*.}"
            local is_x=0
            [[ -x "$fullpath" || "$ext" =~ ^(sh|bash|py)$ ]] && is_x=1

            local opts=()
            [[ $is_x -eq 1 ]] && opts+=("▶ Execute")
            opts+=("📜 Tail -50" "📜 Head -50" "✏ Edit" "🗑 Delete" "ℹ Info" "📋 Copy path" "← Back")

            draw_menu "$item_name" "${opts[@]}"
            local fi=$MENU_RESULT
            [[ $fi -eq -1 ]] && continue

            [[ $is_x -eq 1 ]] && (( fi > 0 )) && (( fi-- ))

            case $fi in
                0) 
                    if [[ $is_x -eq 1 ]]; then
                        banner; echo -e " ${Y}Running ${fullpath}...${N}\n"
                        bash "$fullpath"; pause_key
                    else
                        banner; tail -n 50 "$fullpath" 2>/dev/null | while IFS= read -r l; do echo " $l"; done; pause_key
                    fi ;;
                1) banner; head -n 50 "$fullpath" 2>/dev/null | while IFS= read -r l; do echo " $l"; done; pause_key ;;
                2) root_available && root_run "nano '$fullpath' || vi '$fullpath'" || { nano "$fullpath" 2>/dev/null || vi "$fullpath"; } ;;
                3) confirm_yn "Delete ${fullpath}?" && root_run "rm -f '$fullpath'" && echo -e " ${G}Deleted.${N}"; pause_key ;;
                4) banner; ls -lah "$fullpath"; file "$fullpath"; pause_key ;;
                5) echo -e " ${W}${fullpath}${N}"; pause_key ;;
            esac

        else
            # === NAVIGATION ===
            local nav_idx=$(( idx - showing - 1 ))
            case "${nav_items[$nav_idx]}" in
                "↑  Up to parent") cur=$(dirname "$cur"); off=0; search="" ;;
                "✕  Clear search") search=""; off=0 ;;
                "🔍  Search here") echo -ne "\n ${Y}Search term:${N} "; tread search; off=0 ;;
                "↓  Next page") (( off += PAGE )) ;;
                "↑  Previous page") (( off -= PAGE )); [[ $off -lt 0 ]] && off=0 ;;
                "←  Exit browser") return ;;
            esac
        fi
    done
}

