# ═══════════════════════════════════════════════════════════════
#  ENTRY POINT
# ═══════════════════════════════════════════════════════════════
case "${1:-}" in
    --delete)  do_delete; exit 0 ;;
    --restore) do_restore_crosh; exit 0 ;;
esac

_detect_crosh

if [[ "$(realpath "$0" 2>/dev/null)" == "$SHELL_PATH" || \
      "$(realpath "$0" 2>/dev/null)" == "$ROOTFS_SHELL" ]]; then

    if [[ "$(id -u)" -eq 0 ]]; then
        setup_root_sshd 2>/dev/null; shell_main_menu; exit 0
    fi

    # Try to activate SSH tunnel via whatever root we have
    if ! _rsh_check 2>/dev/null; then
        # sudo may work (minioverride) — use it to start sshd
        if _sudo_check; then
            sudo bash -c "
                $(declare -f setup_root_sshd)
                ROOTKEY='$ROOTKEY'; ROOTKEY_PUB='$ROOTKEY_PUB'; SSHD_CONF='$SSHD_CONF'
                setup_root_sshd
            " 2>/dev/null &
            sleep 1
        fi
    fi

    # Launch shell regardless — sudo works so root_run will use it
    shell_main_menu; exit 0
fi

[[ "$(id -u)" -ne 0 ]] && exec sudo "$0" "$@"

while true; do
    draw_menu "What would you like to do?" \
        "Install cshell" "Delete cshell" "Restore crosh to factory" "Exit"
    case $MENU_RESULT in
        0) do_install ;;
        1) draw_menu "Delete — sure?" "Yes, delete" "No, go back"; [[ $MENU_RESULT -eq 0 ]] && do_delete ;;
        2) draw_menu "Restore crosh — sure?" "Yes, restore" "No, go back"; [[ $MENU_RESULT -eq 0 ]] && do_restore_crosh ;;
        3|-1) printf '\033[?25h'; echo -e "${D}Goodbye.${N}"; exit 0 ;;
    esac
done
