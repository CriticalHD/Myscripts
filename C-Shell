pg_tpm() {
    banner; echo -e "  ${W}── TPM Info ─────────────────────────────────────────${N}\n"
    for key in tpm_kernver tpm_fwver tpm_attack kernkey_vfy; do
        printf "  ${C}%-20s${N} %s\n" "$key" "$(crossystem $key 2>/dev/null||echo n/a)"
    done
